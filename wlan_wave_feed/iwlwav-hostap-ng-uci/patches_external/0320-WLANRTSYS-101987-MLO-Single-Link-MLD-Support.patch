+bool mxl_hostapd_check_non_inherit_ml_ie(struct hostapd_data *hapd)
+{
+	return (mxl_ml_is_mlo_on_tx_bss(hapd) && !mxl_is_mlo_enabled(hapd->conf));
+}
 #endif /* CONFIG_IEEE80211BE_MXL_MLO */
 
 int mxl_switch_channel(struct hostapd_data *hapd, struct csa_settings *settings)
@@ -3315,6 +3320,9 @@ u8 * mxl_hostapd_eid_non_inheritance(struct hostapd_data *hapd, u8 *eid, bool is
 {
 	bool non_inherit_ie_for_twt = false;
 	bool non_inherit_ie_for_owe = false;
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+	bool non_inherit_ie_for_ml = false;
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
 	u8 *pos = eid;
 	u8 eid_len = 0, eid_ext_len = 0;
 	u8 *eid_len_ptr, *eid_ext_len_ptr, *ie_len_ptr, *data_pos;
@@ -3324,11 +3332,17 @@ u8 * mxl_hostapd_eid_non_inheritance(struct hostapd_data *hapd, u8 *eid, bool is
 		hostapd_can_send_btwt_config(hapd->iface->bss[tx_bss_idx]));
 #endif /* CONFIG_IEEE80211AX */
 	non_inherit_ie_for_owe = mxl_hostapd_check_non_inherit_rsnxe(hapd);
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+	non_inherit_ie_for_ml = mxl_hostapd_check_non_inherit_ml_ie(hapd);
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
 
 	if (!(
 #ifdef CONFIG_IEEE80211AX
 	non_inherit_ie_for_twt ||
 #endif /* CONFIG_IEEE80211AX */
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+	non_inherit_ie_for_ml ||
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
 	non_inherit_ie_for_owe))
 		return pos;
 
@@ -3355,6 +3369,13 @@ u8 * mxl_hostapd_eid_non_inheritance(struct hostapd_data *hapd, u8 *eid, bool is
 	eid_ext_len_ptr = pos;
 	*pos++ = 0;
 
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+	if (non_inherit_ie_for_ml) {
+		*pos++ = WLAN_EID_EXT_MULTI_LINK;
+		eid_ext_len++;
+	}
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
+
 	*eid_ext_len_ptr = eid_ext_len;
 	*ie_len_ptr = pos - data_pos;
 
