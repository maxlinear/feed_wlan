From 1cec098e1e7d6668a8abed36564bbf1c1f860f9f Mon Sep 17 00:00:00 2001
From: Nikita Chernikov <nchernikov@maxlinear.com>
Date: Tue, 2 Jun 2026 11:21:59 +0300
Subject: [PATCH] WLANRTSYS-101987 MLO: Single Link MLD Support

- Single Link MLD configuration support
- Handle and add MLD enabled disabled events
- MBSSID ML IE non-inheritence

Fixup to: WLANRTSYS-96596 MLO: Triband MLD Support

Signed-off-by: Nikita Chernikov <nchernikov@maxlinear.com>
---
 src/ap/ieee802_11_shared.c         | 13 +++++
 src/ap/mxl_config.h                |  2 +-
 src/ap/mxl_events.c                | 79 ++++++++++++++++++++++++++++++
 src/ap/mxl_hostapd.c               | 21 ++++++++
 src/ap/mxl_hostapd.h               |  1 +
 src/ap/mxl_mld.c                   |  8 ++-
 src/common/mxl_vendor.h            |  2 +
 src/common/mxl_wpa_ctrl.h          |  5 ++
 src/common/vendor_cmds_copy.h      | 11 +++++
 src/drivers/driver_nl80211_event.c |  6 +++
 src/drivers/mxl_driver_nl80211.c   | 14 ++++++
 src/drivers/mxl_driver_nl80211.h   |  2 +
 12 files changed, 162 insertions(+), 2 deletions(-)

diff --git a/src/ap/ieee802_11_shared.c b/src/ap/ieee802_11_shared.c
index 46883d305..8bd66adff 100644
--- a/src/ap/ieee802_11_shared.c
+++ b/src/ap/ieee802_11_shared.c
@@ -1499,6 +1499,9 @@ static int get_non_tx_bss_len(struct hostapd_data *bss, bool is_beacon,
 	bool non_inherit_ie_for_twt = false;
 #endif
 	bool non_inherit_ie_for_owe = false;
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+	bool non_inherit_ie_for_ml = false;
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
 	/* ssid length check */
 	if (!bss->conf->ignore_broadcast_ssid) {
 		len = len + bss->conf->ssid.ssid_len;
@@ -1526,11 +1529,17 @@ static int get_non_tx_bss_len(struct hostapd_data *bss, bool is_beacon,
 		hostapd_can_send_btwt_config(bss->iface->bss[tx_bss_idx]));
 #endif /* CONFIG_IEEE80211AX */
 	non_inherit_ie_for_owe = mxl_hostapd_check_non_inherit_rsnxe(bss);
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+	non_inherit_ie_for_ml = mxl_hostapd_check_non_inherit_ml_ie(bss);
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
 
 	if (!(
 #ifdef CONFIG_IEEE80211AX
 		non_inherit_ie_for_twt ||
 #endif /* CONFIG_IEEE80211AX */
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+		non_inherit_ie_for_ml ||
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
 		non_inherit_ie_for_owe))
 		return len;
 
@@ -1541,6 +1550,10 @@ static int get_non_tx_bss_len(struct hostapd_data *bss, bool is_beacon,
 #endif /* CONFIG_IEEE80211AX */
 	if (non_inherit_ie_for_owe)
 		len = len + 1;
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+	if (non_inherit_ie_for_ml)
+		len = len + 1;
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
 #endif /* CONFIG_IEEE80211AX */
 	return len;
 }
