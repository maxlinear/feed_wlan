 };
 
 static const char * mxl_event_to_string(enum mxl_event_type event)
@@ -77,6 +90,8 @@ static const char * mxl_event_to_string(enum mxl_event_type event)
 	E2S(MXL_WDS_CONNECT);
 	E2S(MXL_WDS_DISCONNECT);
 	E2S(MXL_REGDB_UPDATE);
+	E2S(MXL_NEW_MLD_VAP);
+	E2S(MXL_DEL_MLD_VAP);
 	}
 
 	return "UNKNOWN";
@@ -212,6 +227,46 @@ static int mxl_hostapd_event_6ghz_regdb_update_info(struct hostapd_data *hapd, u
 	return 0;
 }
 
+static void mxl_event_new_mld_vap(struct hostapd_data *hapd, const u8 *data, size_t data_len)
+{
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+	struct hostapd_iface *iface = hapd->iface;
+	struct mxl_new_mld_vap *msg_new_mld_vap = (struct mxl_new_mld_vap*)data;
+
+	if (data_len != sizeof(struct mxl_new_mld_vap)) {
+		wpa_printf(MSG_ERROR, "wrong new mld vap data event, size %zu expected %zu",
+			   data_len, sizeof(struct mxl_new_mld_vap));
+		return;
+	}
+	wpa_msg(iface->bss[0]->msg_ctx, MSG_INFO, MLD_AP_ENABLED "mld_mac=" MACSTR " num_links=%d",
+		   MAC2STR(msg_new_mld_vap->mld_addr), msg_new_mld_vap->num_of_links);
+#else
+	(void)data;
+	(void)data_len;
+	wpa_printf(MSG_WARNING, "%s: Unexpected MLD AP enabled event", hapd->conf->iface);
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
+}
+
+static void mxl_event_del_mld_vap(struct hostapd_data *hapd, const u8 *data, size_t data_len)
+{
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+	struct hostapd_iface *iface = hapd->iface;
+	struct mxl_del_mld_vap *msg_del_mld_vap = (struct mxl_del_mld_vap*)data;
+
+	if (data_len != sizeof(struct mxl_del_mld_vap)) {
+		wpa_printf(MSG_ERROR, "wrong del mld vap data event, size %zu expected %zu",
+			   data_len, sizeof(struct mxl_del_mld_vap));
+		return;
+	}
+	wpa_msg(iface->bss[0]->msg_ctx, MSG_INFO, MLD_AP_DISABLED "mld_mac="MACSTR,
+		   MAC2STR(msg_del_mld_vap->mld_addr));
+#else
+	(void)data;
+	(void)data_len;
+	wpa_printf(MSG_WARNING, "%s: Unexpected MLD AP disabled event", hapd->conf->iface);
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
+}
+
 static void mxl_process_event(void *ctx, enum mxl_event_type event,
 			  union mxl_event_data *data)
 {
@@ -254,6 +309,12 @@ static void mxl_process_event(void *ctx, enum mxl_event_type event,
 						     data->regdb_status.flags,
 						     data->regdb_status.curr_power_mode);
 		break;
+	case EVENT_MXL_NEW_MLD_VAP:
+		mxl_event_new_mld_vap(hapd, data->new_mld_vap.data, data->new_mld_vap.data_len);
+		break;
+	case EVENT_MXL_DEL_MLD_VAP:
+		mxl_event_del_mld_vap(hapd, data->del_mld_vap.data, data->del_mld_vap.data_len);
+		break;
 	default:
 		wpa_printf(MSG_ERROR, "Unknown MXL event %d", event);
 		break;
@@ -279,6 +340,24 @@ void mxl_drv_event_chan_data(void *ctx, const u8 *data, size_t data_len)
 	mxl_process_event(ctx, EVENT_MXL_CHAN_DATA, &event);
 }
 
+void mxl_drv_event_new_mld_vap(void *ctx, const u8 *data, size_t data_len)
+{
+	union mxl_event_data event;
+	os_memset(&event, 0, sizeof(event));
+	event.new_mld_vap.data = data;
+	event.new_mld_vap.data_len = data_len;
+	mxl_process_event(ctx, EVENT_MXL_NEW_MLD_VAP, &event);
+}
+
+void mxl_drv_event_del_mld_vap(void *ctx, const u8 *data, size_t data_len)
+{
+	union mxl_event_data event;
+	os_memset(&event, 0, sizeof(event));
+	event.del_mld_vap.data = data;
+	event.del_mld_vap.data_len = data_len;
+	mxl_process_event(ctx, EVENT_MXL_DEL_MLD_VAP, &event);
+}
+
 void mxl_drv_event_radar(void *ctx, const u8 *data, size_t data_len)
 {
 	union mxl_event_data event;
