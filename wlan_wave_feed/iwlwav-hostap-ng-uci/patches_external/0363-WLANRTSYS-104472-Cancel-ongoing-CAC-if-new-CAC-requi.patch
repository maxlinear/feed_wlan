From fd9313eaa1ca87b0866f71b09a7d04ca44f33157 Mon Sep 17 00:00:00 2001
From: hmgokhale <hmgokhale@maxlinear.com>
Date: Fri, 16 Oct 2026 03:18:06 -0700
Subject: [PATCH] WLANRTSYS-104472 Cancel ongoing CAC if new CAC required on
 main radio

Signed-off-by: hmgokhale <hmgokhale@maxlinear.com>
---
 hostapd/ctrl_iface.c |  2 +-
 src/ap/hostapd.c     | 12 ++++++++++-
 src/ap/mxl_acs.c     |  2 +-
 src/ap/mxl_hostapd.c | 19 +++++++++++++++++
 src/ap/mxl_hostapd.h |  1 +
 src/ap/mxl_zwdfs.c   | 49 ++++++++++++++++++++++++++++++++++++--------
 src/ap/mxl_zwdfs.h   |  3 ++-
 7 files changed, 75 insertions(+), 13 deletions(-)

diff --git a/hostapd/ctrl_iface.c b/hostapd/ctrl_iface.c
index 09f824628..cfc9f13df 100644
--- a/hostapd/ctrl_iface.c
+++ b/hostapd/ctrl_iface.c
@@ -3299,7 +3299,7 @@ static int hostapd_ctrl_iface_chan_switch(struct hostapd_iface *iface,
 			*/
 			start_bg_cac = mxl_hostapd_prepare_new_background_cac(iface, &settings);
 			if (start_bg_cac > 0)
-				return mxl_hostapd_start_background_cac(iface, &settings);
+				return mxl_hostapd_start_background_cac(iface, &settings, false);
 			else
 				return -1;
 		}
diff --git a/src/ap/hostapd.c b/src/ap/hostapd.c
index 402509d42..9700ab9da 100644
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -3657,8 +3657,18 @@ static int hostapd_setup_interface_complete_sync(struct hostapd_iface *iface,
 			/* Check DFS */
 			res = hostapd_handle_dfs(iface);
 			if (res <= 0) {
-				if (res < 0)
+				if (res < 0) {
+#ifdef CONFIG_VENDOR_MXL
+					/* CAC never started - recover instead of staying disabled. */
+					wpa_printf(MSG_ERROR,
+						   "Restarting interface after failed DFS CAC start");
+					hostapd_disable_iface(iface);
+					hostapd_enable_iface(iface);
+					return 0;
+#else /* CONFIG_VENDOR_MXL */
 					goto fail;
+#endif /* CONFIG_VENDOR_MXL */
+				}
 				return res;
 			}
 		} else {
diff --git a/src/ap/mxl_acs.c b/src/ap/mxl_acs.c
index 6512dc962..85ca913e0 100644
--- a/src/ap/mxl_acs.c
+++ b/src/ap/mxl_acs.c
@@ -3025,7 +3025,7 @@ int mxl_do_bg_cac_with_second_best_channel(struct hostapd_iface *iface)
 	}
 
 	/* Start ZWDFS CAC in background */
-	if (mxl_hostapd_start_background_cac(iface, &settings)) {
+	if (mxl_hostapd_start_background_cac(iface, &settings, true)) {
 		wpa_printf(MSG_ERROR, "%s: Failed to start Background CAC in ZWDFS antenna\n", __func__);
 		return -1;
 	}
diff --git a/src/ap/mxl_hostapd.c b/src/ap/mxl_hostapd.c
index ccb4bff55..cbc46773f 100644
--- a/src/ap/mxl_hostapd.c
+++ b/src/ap/mxl_hostapd.c
@@ -4001,3 +4001,22 @@ void mxl_acs_clear_second_bg_cac_param(struct hostapd_iface *iface)
 	iface->mxl_iface.acs_reenable_iface = 0;
 	return;
 }
+
+void mxl_acs_clear_stale_second_bg_cac_candidate(struct hostapd_iface *iface)
+{
+#ifdef CONFIG_VENDOR_MXL
+	/* Only reset the stale second-best candidate's own fields - not first_rank_idx/flag,
+	 * which track the current ACS cycle's primary-channel ranking and may still be in use. */
+	iface->mxl_iface.sec_best_ch.bg_cac = false;
+	iface->mxl_iface.sec_best_ch.freq = 0;
+	iface->mxl_iface.sec_best_ch.channel = 0;
+	iface->mxl_iface.sec_best_ch.primary = 0;
+	iface->mxl_iface.sec_best_ch.secondary = 0;
+	iface->mxl_iface.sec_best_ch.width = 0;
+	iface->mxl_iface.sec_best_ch.sec_channel_cac = false;
+	iface->mxl_iface.sec_best_ch.ch_switch_done = false;
+	iface->mxl_iface.sec_best_ch.zwdfs_is_primary_cac = false;
+	iface->mxl_iface.sec_best_ch.second_rank_idx = 0;
+#endif /* CONFIG_VENDOR_MXL */
+	return;
+}
diff --git a/src/ap/mxl_hostapd.h b/src/ap/mxl_hostapd.h
index 41dd98cd8..036ae925f 100644
--- a/src/ap/mxl_hostapd.h
+++ b/src/ap/mxl_hostapd.h
@@ -435,6 +435,7 @@ size_t mxl_hostapd_get_mbssid_tx_bss_idx(struct hostapd_iface *iface);
 struct hostapd_data *mxl_hostapd_mbssid_get_tx_bss(struct hostapd_data *hapd);
 bool mxl_hostapd_is_mbssid_tx_bss(struct hostapd_data *hapd);
 void mxl_acs_clear_second_bg_cac_param(struct hostapd_iface *iface);
+void mxl_acs_clear_stale_second_bg_cac_candidate(struct hostapd_iface *iface);
 void mxl_hostapd_restore_user_configured_cw(struct hostapd_iface *iface, struct hostapd_config *oldconf);
 int mxl_hostapd_check_reload(struct hostapd_data *hapd);
 bool mxl_is_valid_link_id(u8 link_id);
diff --git a/src/ap/mxl_zwdfs.c b/src/ap/mxl_zwdfs.c
index 6aab368b1..1142f5145 100644
--- a/src/ap/mxl_zwdfs.c
+++ b/src/ap/mxl_zwdfs.c
@@ -116,11 +116,13 @@ int mxl_hostapd_background_cac_possible(struct hostapd_iface *iface, struct csa_
 	return 0;
 }
 
-int mxl_hostapd_start_background_cac(struct hostapd_iface *iface, const struct csa_settings *settings)
+int mxl_hostapd_start_background_cac(struct hostapd_iface *iface, const struct csa_settings *settings,
+				     bool is_second_best_candidate)
 {
 	size_t i;
 	struct hostapd_iface *zwdfs_iface = NULL;
 	struct hapd_interfaces *ifaces = iface->interfaces;
+	uint8_t new_centr_freq_seg0_idx = 0;
 
 	for (i = 0; i < ifaces->count; i++) {
 		if (mxl_hostapd_is_zwdfs_iface(ifaces->iface[i])) {
@@ -134,6 +136,32 @@ int mxl_hostapd_start_background_cac(struct hostapd_iface *iface, const struct c
 		return -1;
 	}
 
+	if (settings->freq_params.bandwidth == 20) {
+		new_centr_freq_seg0_idx = settings->freq_params.channel;
+	} else {
+		int chan_offset = 0;
+		mxl_hostapd_get_chan_data_from_candidates_5g(settings->freq_params.channel,
+				mxl_get_oper_width(settings->freq_params.bandwidth),
+				&chan_offset, &new_centr_freq_seg0_idx);
+	}
+
+	/* Antenna may still be busy CAC-ing a stale candidate (different channel/freq,
+	 * or same channel/freq but different BW) - stop it first. */
+	if (iface->radar_background.cac_started &&
+			(iface->radar_background.channel != settings->freq_params.channel ||
+			 iface->radar_background.freq != settings->freq_params.freq ||
+			 iface->radar_background.centr_freq_seg0_idx != new_centr_freq_seg0_idx)) {
+		if (mxl_hostapd_set_zwdfs_antenna(zwdfs_iface->bss[0], 0)) {
+			wpa_printf(MSG_ERROR, "ZWDFS: Failed to stop stale background CAC on chan=%d",
+					iface->radar_background.channel);
+			return -1;
+		}
+		/* Don't clear sec_best_ch if this call is itself populating it for the
+		 * candidate being CAC'd - only clear when it's unrelated, stale data. */
+		if (!is_second_best_candidate)
+			mxl_acs_clear_stale_second_bg_cac_candidate(iface);
+	}
+
 	if (mxl_hostapd_set_zwdfs_antenna(zwdfs_iface->bss[0], 1)) {
 		wpa_printf(MSG_ERROR, "ZWDFS: Failed to enable antenna");
 		return -1;
@@ -474,14 +502,12 @@ int mxl_hostapd_zwdfs_cac_on_autoCoC(struct hostapd_iface *iface)
 	}
 
 	/* Start ZWDFS CAC in background */
-	if (mxl_hostapd_start_background_cac(iface, &settings)) {
+	if (mxl_hostapd_start_background_cac(iface, &settings, false)) {
 		wpa_printf(MSG_ERROR, "%s: Failed to start Background CAC in ZWDFS antenna\n", __func__);
 		return -1;
 	}
 	iface->mxl_iface.autococ_background_cac_running = 1;
-#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
 	iface->mxl_iface.sec_best_ch.zwdfs_is_primary_cac = true;
-#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
 	return 0;
 }
 
@@ -651,7 +677,7 @@ int mxl_hostapd_zwdfs_restart_cac(struct hostapd_iface *iface, u8 chan, enum cha
 	}
 
 	/* Set channel to zwdfs background chain */
-	res = mxl_hostapd_start_background_cac(iface, &settings);
+	res = mxl_hostapd_start_background_cac(iface, &settings, false);
 	if(!res)
 		iface->mxl_iface.zwdfs_cac_retriggered_count = zwdfs_cac_retriggered_count + 1;
 
@@ -785,13 +811,11 @@ void mxl_hostapd_zwdfs_cac_on_radar(struct hostapd_iface *iface, struct csa_sett
 	}
 
 	/* Start ZWDFS CAC in background */
-	if (mxl_hostapd_start_background_cac(iface, &new_chan_settings)) {
+	if (mxl_hostapd_start_background_cac(iface, &new_chan_settings, false)) {
 		wpa_printf(MSG_ERROR, "%s: Failed to start Background CAC in ZWDFS antenna\n", __func__);
 		goto fail;
 	}
-#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
 	iface->mxl_iface.sec_best_ch.zwdfs_is_primary_cac = true;
-#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
 	return;
 
 fail:
@@ -836,6 +860,13 @@ int mxl_acs_request_background_cac(struct hostapd_iface *iface)
 	struct csa_settings settings = {0};
 	struct hostapd_hw_modes *cmode = iface->current_mode;
 
+	/* Background CAC already running for this exact channel/BW - nothing to (re)do. */
+	if (iface->radar_background.cac_started &&
+	    iface->radar_background.channel == iface->conf->channel &&
+	    iface->radar_background.freq == iface->freq &&
+	    iface->radar_background.centr_freq_seg0_idx == hostapd_get_oper_centr_freq_seg0_idx(iface->conf))
+		return 1;
+
 	/* check if background dfs cac enabled */
 	if (!iface->mxl_iface.acs_bgscan_enable) {
 		/* if zwdfs antenna is disabled then set background radar to false. */
@@ -863,7 +894,7 @@ int mxl_acs_request_background_cac(struct hostapd_iface *iface)
 	}
 
 	/* Start ZWDFS CAC in background */
-	if (mxl_hostapd_start_background_cac(iface, &settings)) {
+	if (mxl_hostapd_start_background_cac(iface, &settings, false)) {
 		wpa_printf(MSG_ERROR, "%s: Failed to start Background CAC in ZWDFS antenna\n", __func__);
 		return -1;
 	}
diff --git a/src/ap/mxl_zwdfs.h b/src/ap/mxl_zwdfs.h
index bbfdd1d5b..6779489e3 100644
--- a/src/ap/mxl_zwdfs.h
+++ b/src/ap/mxl_zwdfs.h
@@ -24,7 +24,8 @@ int mxl_hostapd_set_zwdfs_antenna(struct hostapd_data *hapd, int enable);
 bool mxl_hostapd_check_only_dfs_chans(struct hostapd_iface *iface);
 int mxl_hostapd_background_cac_possible(struct hostapd_iface *iface, struct csa_settings *settings, bool switch_type_zwdfs);
 int mxl_hostapd_prepare_new_background_cac(struct hostapd_iface *iface, struct csa_settings *settings);
-int mxl_hostapd_start_background_cac(struct hostapd_iface *iface, const struct csa_settings *settings);
+int mxl_hostapd_start_background_cac(struct hostapd_iface *iface, const struct csa_settings *settings,
+				     bool is_second_best_candidate);
 int mxl_hostapd_zwdfs_switch(struct hostapd_iface *iface, int cac_status, int freq, int chan_width, int cf1, int cf2);
 
 int mxl_zwdfs_check_chans_unavailable(struct hostapd_iface *iface, struct hostapd_freq_params *freq);
-- 
2.43.0

