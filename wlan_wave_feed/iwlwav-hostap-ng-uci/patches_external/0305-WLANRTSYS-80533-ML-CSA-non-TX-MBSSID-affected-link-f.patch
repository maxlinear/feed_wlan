 }
 
-void mxl_cleanup_ml_csa_params(struct hostapd_iface *iface)
+void mxl_cleanup_ml_csa_params(struct hostapd_iface *iface, bool cu_cleanup)
 {
-	struct hostapd_data *bss, *lhapd;
