+static void mxl_ml_clear_csa_params_mbss_affected_links(struct hostapd_iface *iface)
+{
+	struct hostapd_data *bss;
+	int i;
+
+	for (i = 1; i < iface->num_bss; i++) {
+		bss = iface->bss[i];
+		if (bss) {
+			bss->mxl_data.max_chan_sw_time_ie_add = false;
+			bss->mxl_data.bw_indication_ie_len_add = false;
+			bss->mxl_data.ml_non_tx_critical_update = false;
+		}
+	}
+}
+
+static int mxl_ml_handle_csa_affected_mbssid_links(struct hostapd_iface *csa_iface)
+{
+	struct p_ap_mld *mld = NULL;
+	struct hostapd_data *bss, *tx_bss = NULL;
+	int i;
+	u8 flags = 0;
+	bool ml_mbssid_csa = false;
+
+	if (!csa_iface->conf->multibss_enable)
+		return 0;
+	
+	tx_bss = mxl_hostapd_mbssid_get_tx_bss(csa_iface->bss[0]);
+	if (!tx_bss) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: Failed to get TX BSS for MBSSID critical update");
+		return -1;
+	}
+
+	for (i = 1; i < csa_iface->num_bss; i++) {
+		bss = csa_iface->bss[i];
+
+		mld = mxl_ml_get_ap_mld(bss);
+		if (!mld)
+			continue;
+
+		if (!bss->started || !bss->beacon_set_done)
+			continue;
+		
+		mxl_ml_increment_bss_param_change_count(bss);
+
+		if (bss == tx_bss) {
+			/* TX BSS */
+			flags |= (BSS_CRITICAL_UPDATE_COMMON | BSS_CRITICAL_UPDATE_CSA);
+		} else {
+			/* non-TX BSS */
+			flags |= (NON_TX_BSS_CRITICAL_UPDATE_COMMON | NON_TX_BSS_CRITICAL_UPDATE_CSA);
+			bss->mxl_data.ml_non_tx_critical_update = true;
+		}
+		ml_mbssid_csa = true;
+	}
+
+	if (!ml_mbssid_csa) {
+		wpa_printf(MSG_DEBUG, "MXL_MLO: No affected link found for MBSSID CSA critical update");
+		return 0;
+	}
+
+	if (mxl_ml_send_bss_critical_update_info(tx_bss, flags, 0, 0, NULL) < 0) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: CSA critical update on mbssid affected link failed");
+		mxl_ml_clear_csa_params_mbss_affected_links(csa_iface);
+		return -1;
+	}
+
+	tx_bss->mxl_data.max_chan_sw_time_ie_add = true;
+
+	ieee802_11_set_beacon_per_bss_only(tx_bss);
+
+	mxl_ml_clear_csa_params_mbss_affected_links(csa_iface);
+
+	return 0;
+}
+
