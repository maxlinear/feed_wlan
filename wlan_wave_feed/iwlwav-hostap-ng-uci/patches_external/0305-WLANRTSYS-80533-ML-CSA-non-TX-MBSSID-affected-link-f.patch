+	}
+
 	if (!mxl_mlo_is_ml_csa_in_progress(csa_iface)) {
 		wpa_printf(MSG_DEBUG, "MXL_MLO: No ML CSA in progress on iface %s",
 			   csa_iface->conf->bss[0]->iface);
@@ -3094,15 +3255,22 @@ static void mxl_ml_csa_timeout_handler(void *eloop_data,
 		mld = mxl_ml_get_ap_mld(bss);
 		if (!mld)
 			continue;
+		mxl_ml_clear_csa_params_affected_link(bss);
+		/* Cleanup critical update - to avoid bad beacon */
+		tx_bss = mxl_hostapd_mbssid_get_tx_bss(bss);
+		if (tx_bss && (tx_bss == bss) && tx_bss->started && tx_bss->beacon_set_done)
+			mxl_ml_send_bss_critical_update_info(bss, 0, 0, 0, NULL);
 		mxl_mld_for_each_sibling_link(lhapd, bss) {
-			mxl_ml_clear_csa_params_for_reporting_link(lhapd);
+			mxl_ml_clear_csa_params_reporting_link(lhapd);
 			if (lhapd->mxl_data.csa_on_reporting_link) {
 				wpa_printf(MSG_ERROR, "MXL_MLO: CSA critical update on affected link %s did not complete within expected time",
 					   lhapd->conf->iface);
 				lhapd->mxl_data.csa_on_reporting_link = false;
 				/* Use TX BSS if interface is MBSSID otherwise it is the same BSS */
 				tx_bss = mxl_hostapd_mbssid_get_tx_bss(lhapd);
-				if (tx_bss->started && tx_bss->beacon_set_done) {
+				if (tx_bss && tx_bss->started && tx_bss->beacon_set_done) {
+					if (tx_bss == lhapd)
+						mxl_ml_send_bss_critical_update_info(tx_bss, 0, 0, 0, NULL);
 					ieee802_11_set_beacon_per_bss_only(tx_bss);
 				}
 			}
@@ -3151,7 +3319,7 @@ int mxl_ml_handle_csa_critical_update(struct hostapd_iface *csa_iface,
 
 	csa_iface->mxl_iface.ml_csa_in_progress = true;
 
-	/* Handle non-MBSSID reporing links first */
+	/* Handle non-MBSSID affected and reporting links first */
 	for (i = 1; i < csa_iface->num_bss; i++) {
 		bss = csa_iface->bss[i];
 
@@ -3159,8 +3327,6 @@ int mxl_ml_handle_csa_critical_update(struct hostapd_iface *csa_iface,
 		if (!mld)
 			continue;
 
-		mxl_ml_increment_bss_param_change_count(bss);
-
 		if (!bss->started || !bss->beacon_set_done)
 			continue;
 
@@ -3176,12 +3342,24 @@ int mxl_ml_handle_csa_critical_update(struct hostapd_iface *csa_iface,
 		}
 	}
 
+	/* Handle MBSSID affected links */
+	if (mxl_ml_handle_csa_affected_mbssid_links(csa_iface)) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: Failed to handle CSA critical update on MBSSID affected links");
+		return -1;
+	}
+
 	/* Handle MBSSID reporting links */
-	if (mxl_ml_handle_csa_mbssid_interfaces(csa_iface, settings, op_class)) {
+	if (mxl_ml_handle_csa_reporting_mbssid_interfaces(csa_iface, settings, op_class)) {
 		wpa_printf(MSG_ERROR, "MXL_MLO: Failed to handle CSA critical update on MBSSID reporting links");
 		return -1;
 	}
 
+	/* Prepare critical update after CSA is done - to indicate eht operation change */
+	if (mxl_ml_eht_op_change_critical_update(csa_iface)) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: Failed to handle EHT operation critical update");
+		return -1;
+	}
+
 	timeout_usec = mxl_ml_get_csa_timeout(csa_iface);
 	wpa_printf(MSG_DEBUG, "MXL_MLO: CSA starting timer %u us for iface %s",
 		   timeout_usec, csa_iface->conf->bss[0]->iface);
@@ -3195,8 +3373,8 @@ int mxl_ml_handle_csa_critical_update(struct hostapd_iface *csa_iface,
 void mxl_hostapd_eid_ml_critical_update(struct hostapd_data *hapd, u16 *capab_info)
 {
 	if (hapd->iconf->ieee80211be && mxl_is_mlo_enabled(hapd->conf)
-	    && hapd->conf->mxl_bss_conf.ml_ie_add
-	    && hapd->mxl_data.ml_non_tx_critical_update) {
+		&& hapd->conf->mxl_bss_conf.ml_ie_add
+		&& hapd->mxl_data.ml_non_tx_critical_update) {
 		*capab_info |= WLAN_CAPABILITY_ML_CRITICAL_UPDATE;
 	}
 }
