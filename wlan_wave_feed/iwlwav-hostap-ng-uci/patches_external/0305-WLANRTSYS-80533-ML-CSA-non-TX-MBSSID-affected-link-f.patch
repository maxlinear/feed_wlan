+			tx_bss = mxl_hostapd_mbssid_get_tx_bss(bss);
+			if (tx_bss && (tx_bss == bss) && tx_bss->started && tx_bss->beacon_set_done)
+				mxl_ml_send_bss_critical_update_info(tx_bss, 0, 0, 0, NULL);
+		}
 		mxl_mld_for_each_sibling_link(lhapd, bss) {
-			mxl_ml_clear_csa_params_for_reporting_link(lhapd);
+			mxl_ml_clear_csa_params_reporting_link(lhapd);
+			if (cu_cleanup) {
+				tx_bss = mxl_hostapd_mbssid_get_tx_bss(lhapd);
+				if (tx_bss && (tx_bss == lhapd) && tx_bss->started && tx_bss->beacon_set_done)
+					mxl_ml_send_bss_critical_update_info(tx_bss, 0, 0, 0, NULL);
+			}
 		}
 	}
 }
 
+static int mxl_ml_eht_op_change_critical_update(struct hostapd_iface *csa_iface)
+{
+	struct hostapd_data *bss, *tx_bss = NULL;
+	struct p_ap_mld *mld = NULL;
+	int i;
+	u8 flags = 0;
+	bool is_mbss = csa_iface->conf->multibss_enable;
+
+	tx_bss = mxl_hostapd_mbssid_get_tx_bss(csa_iface->bss[0]);
+	if (!tx_bss) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: Failed to get TX BSS for HE/EHT Operation update");
+		return -1;
+	}
+
+	for (i = 0; i < csa_iface->num_bss; i++) {
+		bss = csa_iface->bss[i];
+		mld = mxl_ml_get_ap_mld(bss);
+		if (!mld)
+			continue;
+		if (!bss->started || !bss->beacon_set_done)
+			continue;
+		mxl_ml_increment_bss_param_change_count(bss);
+		if (!is_mbss) {
+			flags = BSS_CRITICAL_UPDATE_COMMON;
+			if (mxl_ml_send_bss_critical_update_info(bss, flags, 0, 0, NULL) < 0) {
+				wpa_printf(MSG_ERROR, "MXL_MLO: HE/EHT Operation Critical update on affected link failed");
+				return -1;
+			}
+		} else {
+			if (bss == tx_bss) {
+				/* TX BSS */
+				flags |= BSS_CRITICAL_UPDATE_COMMON;
+			} else {
+				/* non-TX BSS */
+				flags |= NON_TX_BSS_CRITICAL_UPDATE_COMMON;
+				bss->mxl_data.ml_non_tx_critical_update = true;
+			}
+		}
+	}
+
+	if (is_mbss) {
+		if (mxl_ml_send_bss_critical_update_info(tx_bss, flags, 0, 0, NULL) < 0) {
+			wpa_printf(MSG_ERROR, "MXL_MLO: HE/EHT Operation Critical update on mbssid affected link failed");
+			return -1;
+		}
+	}
+	return 0;
+}
+
