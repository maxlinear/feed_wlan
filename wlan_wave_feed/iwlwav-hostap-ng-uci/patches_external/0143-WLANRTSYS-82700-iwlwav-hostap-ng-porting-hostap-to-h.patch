 		} else {
 			external_scan_event = 1;
@@ -4299,6 +4305,12 @@ static void do_process_drv_event(struct i802_bss *bss, int cmd,
 			 */
 			eloop_cancel_timeout(wpa_driver_nl80211_scan_timeout,
