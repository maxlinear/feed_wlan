From c3e462a75b73abd4260dabcadebbe15d70570876 Mon Sep 17 00:00:00 2001
From: Karthik D A <karthikda@maxlinear.com>
Date: Sun, 7 Sep 2025 20:37:13 +0800
Subject: [PATCH] WLANRTSYS-93718 iwlwav-hostapd-ng: Fix for TC 4.5.3

Description: The SCS TC4.5.3_2G/5G, along with SCS validations,
the MSCS support in extended capabilities IE is also validated by the TC. The TC failed.

Root cause: Classifier mask based ip tuple comparison and unsolicited SCS resp was not handled.

Fix: Added the changes to handle comparsion of tuple based on classifier mask and unsolicited SCS resp.

Test: Tested and verify that the TC 4.5.3_24G/5G passed successfully.

Fixup Commit:WLANRTSYS-88975 iwlwav-hostap-ng DL SCS support

Signed-off-by: Karthik D A <karthikda@maxlinear.com>
---
 hostapd/mxl_ctrl_iface.c      | 57 +++++++++++++++++++++++++++++++++++
 hostapd/mxl_hostapd_cli.c     | 18 +++++++++++
 hostapd/mxl_hostapd_cli.h     |  3 ++
 src/ap/mxl_wmm.c              | 22 ++++++++------
 src/ap/mxl_wmm.h              |  3 +-
 src/common/vendor_cmds_copy.h |  1 +
 6 files changed, 93 insertions(+), 11 deletions(-)

diff --git a/hostapd/mxl_ctrl_iface.c b/hostapd/mxl_ctrl_iface.c
index 7a9def3f0..e2d7e0a5b 100644
--- a/hostapd/mxl_ctrl_iface.c
+++ b/hostapd/mxl_ctrl_iface.c
@@ -3134,6 +3134,60 @@ static int mxl_hostapd_ctrl_iface_get_scs_enable(struct hostapd_data *hapd, char
 
 	return res;
 }
+
+static int mxl_hostapd_ctrl_iface_scs_unsolicited_rem(struct hostapd_data *hapd, const char *cmd, char *reply, size_t reply_size)
+{
+	u8 addr[ETH_ALEN];
+	u8 scs_id, req_type;
+	u8 scs_count = 0;
+	int status;
+	int res = 0;
+	int used;
+	long int val;
+	const char *pos;
+	char *pos2;
+	struct mxl_scs_status_list status_list;
+
+	pos = cmd;
+	used = hwaddr_aton2(pos, addr);
+	if (used < 0)
+		return -1;
+	pos += used;
+
+	while (*pos == ' ')
+		pos++;
+	
+	val = strtol(pos, &pos2, 0);
+	if (val < 0 || val > 0xff)
+		return -1;
+	scs_id = (u8) val;
+	pos = pos2;
+
+	while (*pos == ' ')
+		pos++;
+
+	val = strtol(pos, &pos2, 0);
+	if (val < 0 || val > 0xff)
+		return -1;
+	req_type = (u8) val;
+
+	if (req_type != SCS_REQ_REMOVE)
+		return -1;
+
+	status = mxl_scs_remove_req(hapd, addr, 0, scs_id);
+	status_list.scsId = scs_id;
+	status_list.status = status;
+	scs_count ++;
+	mxl_send_scs_resp(hapd, addr, &status_list, scs_count, 0);
+
+	res = sprintf_s(reply, reply_size, "%d\n", status);
+	if (res <= 0) {
+		wpa_printf(MSG_ERROR, "%s: sprintf_s error %d", __func__, res);
+		return -1;
+	}
+
+	return res;
+}
 #endif
 
 #ifdef CONFIG_MSCS_MXL
@@ -3419,6 +3473,9 @@ int mxl_hostapd_ctrl_iface_receive_process(struct hostapd_data *hapd,
 	} else if (os_strncmp(buf, "GET_SCS_ENABLE", 14) == 0) {
 		if (mxl_hostapd_ctrl_iface_get_scs_enable(hapd, reply, reply_size) < 0)
 			*reply_len = -1;
+	} else if (os_strncmp(buf, "SCS_REM_REQ ", sizeof("SCS_REM_REQ ") - 1) == 0) {
+		if (mxl_hostapd_ctrl_iface_scs_unsolicited_rem(hapd, buf + sizeof("SCS_REM_REQ ") -1, reply, reply_size) < 0)
+			*reply_len = -1;
 #endif /* CONFIG_SCS */
 #ifdef CONFIG_MSCS_MXL
 	} else if (os_strncmp(buf, "GET_MSCS_ENABLE", 15) == 0) {
diff --git a/hostapd/mxl_hostapd_cli.c b/hostapd/mxl_hostapd_cli.c
index c30003995..42312c8df 100644
--- a/hostapd/mxl_hostapd_cli.c
+++ b/hostapd/mxl_hostapd_cli.c
@@ -570,6 +570,24 @@ int mxl_hostapd_cli_cmd_get_mscs_enable(struct wpa_ctrl *ctrl, int argc, char *a
 	return mxl_wpa_ctrl_command(ctrl, "GET_MSCS_ENABLE");
 }
 
+int mxl_hostapd_cli_cmd_scs_rem(struct wpa_ctrl *ctrl, int argc, char *argv[])
+{
+	char cmd[256];
+	int res;
+
+	if (argc != 3) {
+		printf("Usage: scs_remove <STA-MAC> <SCSID> <REQ TYPE>\n");
+		return -1;
+	}
+
+	res = sprintf_s(cmd, sizeof(cmd), "SCS_REM_REQ %s %s %s", argv[0] ,argv[1], argv[2]);
+	if (res <= 0) {
+		printf("%s: sprintf_s error %d", __func__, res);
+		return -1;
+	}
+	return mxl_wpa_ctrl_command(ctrl, cmd);
+}
+
 int mxl_hostapd_cli_cmd_mscs_rem(struct wpa_ctrl *ctrl, int argc, char *argv[])
 {
    char cmd[256];
