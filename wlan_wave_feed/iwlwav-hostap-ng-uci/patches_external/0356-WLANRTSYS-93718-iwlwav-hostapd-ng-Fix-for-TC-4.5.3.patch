--- a/hostapd/mxl_hostapd_cli.h
+++ b/hostapd/mxl_hostapd_cli.h
@@ -109,6 +109,8 @@ int mxl_wpa_ctrl_command(struct wpa_ctrl *ctrl, const char *cmd);
 	  " = do reconf on all changed bss in radio"}, \
 	{ "get_scs_enable", mxl_hostapd_cli_cmd_get_scs_enable, NULL, \
 	  " = Get scs enable/disable status"}, \
+	{"scs_remove", mxl_hostapd_cli_cmd_scs_rem, NULL, \
+	  " = Unsolicited scs rem req"}, \
 	{ "get_mscs_enable", mxl_hostapd_cli_cmd_get_mscs_enable, NULL, \
 	  " = Get mscs enable/disable status"}, \
 	{ "mscs_remove", mxl_hostapd_cli_cmd_mscs_rem, NULL, \
@@ -194,6 +196,7 @@ int mxl_hostapd_cli_cmd_set_assocresp_elements(struct wpa_ctrl *ctrl, int argc,
 int mxl_hostapd_cli_cmd_get_assocresp_elements(struct wpa_ctrl *ctrl, int argc, char *argv[]);
 int mxl_hostapd_cli_cmd_bss_reconf(struct wpa_ctrl *ctrl, int argc, char *argv[]);
 int mxl_hostapd_cli_cmd_get_scs_enable(struct wpa_ctrl *ctrl, int argc, char *argv[]);
+int mxl_hostapd_cli_cmd_scs_rem(struct wpa_ctrl *ctrl, int argc, char *argv[]);
 int mxl_hostapd_cli_cmd_get_mscs_enable(struct wpa_ctrl *ctrl, int argc, char *argv[]);
