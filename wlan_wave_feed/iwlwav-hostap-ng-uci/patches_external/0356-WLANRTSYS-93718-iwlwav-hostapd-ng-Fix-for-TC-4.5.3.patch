+++ b/src/ap/mxl_wmm.c
@@ -173,14 +173,14 @@ void mxl_hostapd_eht_protected(struct hostapd_data *hapd,
 #endif /* CONFIG_EPCS_MXL */
 
 #ifdef CONFIG_SCS_MXL
-static void mxl_send_scs_resp(struct hostapd_data *hapd,
-			const struct ieee80211_mgmt *mgmt, struct mxl_scs_status_list *status_list, u8 scs_count)
+void mxl_send_scs_resp(struct hostapd_data *hapd,
+		const u8 *addr, struct mxl_scs_status_list *status_list, u8 scs_count, u8 dialog_token)
 {
 	u8 buf[256];
 	struct ieee80211_mgmt *mgmt_resp = (struct ieee80211_mgmt *) buf;
 	struct sta_info *sta;
 	wpa_printf(MSG_DEBUG, "Send SCS Response");
-	sta = ap_get_sta(hapd, mgmt->sa);
+	sta = ap_get_sta(hapd, addr);
 
 	if (sta == NULL) {
 		wpa_printf(MSG_ERROR, "SCS: mxl_send_scs_resp - station not connected");
@@ -190,13 +190,13 @@ static void mxl_send_scs_resp(struct hostapd_data *hapd,
 	wpa_printf(MSG_DEBUG, "handle_scs_resp");
 	os_memset(buf, 0, sizeof(buf));
 	mgmt_resp->frame_control = IEEE80211_FC(WLAN_FC_TYPE_MGMT, WLAN_FC_STYPE_ACTION);
-	os_memcpy(mgmt_resp->da, mgmt->sa, ETH_ALEN);
+	os_memcpy(mgmt_resp->da, addr, ETH_ALEN);
 	os_memcpy(mgmt_resp->sa, hapd->own_addr, ETH_ALEN);
 	os_memcpy(mgmt_resp->bssid, hapd->own_addr, ETH_ALEN);
 
 	mgmt_resp->u.action.category = WLAN_ACTION_ROBUST_AV_STREAMING;
 	mgmt_resp->u.action.u.scs_action_resp.action = ROBUST_AV_SCS_RESP;
-	mgmt_resp->u.action.u.scs_action_resp.dialog_token = mgmt->u.action.u.scs_action_req.dialog_token;
+	mgmt_resp->u.action.u.scs_action_resp.dialog_token = dialog_token;
 	mgmt_resp->u.action.u.scs_action_resp.count = scs_count;
 	os_memcpy(mgmt_resp->u.action.u.scs_action_resp.scs_status, status_list, (scs_count * sizeof(struct mxl_scs_status_list)));
 
@@ -304,6 +304,7 @@ int mxl_scs_parse_tclas_elems(const u8 *pos, struct mxl_scs_add_req *scs_add_req
 		switch (class_type) { /* Classifier type 4 and 10 are allowed */
 			case CLASSIFIER_TYPE4:
 				mask = *pos++;
+				scs_add_req->tclasInfo.tclasMask = mask;
 
 				/* Process classifiers frames */
 				if (mask & BIT(CLASS_TYPE4_VERSION))
@@ -509,7 +510,7 @@ int mxl_scs_add_req(struct hostapd_data *hapd, const struct ieee80211_mgmt *mgmt
 }
 
 int mxl_scs_remove_req(struct hostapd_data *hapd,
-			const struct ieee80211_mgmt *mgmt, size_t len, u8 scsId)
+			const u8 *addr, size_t len, u8 scsId)
 {
 	struct sta_info *sta;
 	struct mxl_scs_rem_req scs_rem_req;
@@ -519,7 +520,7 @@ int mxl_scs_remove_req(struct hostapd_data *hapd,
 		return WLAN_STATUS_UNSPECIFIED_FAILURE;
 	}
 
-	sta = ap_get_sta(hapd, mgmt->sa);
+	sta = ap_get_sta(hapd, addr);
 	if (sta == NULL) {
 		wpa_printf(MSG_ERROR, "SCS: scs_rem_req - station not connected");
 		return WLAN_STATUS_UNSPECIFIED_FAILURE;
@@ -546,6 +547,7 @@ void mxl_handle_scs_req(struct hostapd_data *hapd,
 	u8 reqType, scsId, eid;
 	size_t elen;
 	const u8 *pos = mgmt->u.action.u.scs_action_req.variable;
+	u8 dialog_token = mgmt->u.action.u.scs_action_req.dialog_token;
 	struct mxl_scs_status_list status_list[8]; /* Assuming max 8 status duples for SCS response */
 	u8 scs_count = 0;
 
@@ -582,13 +584,13 @@ void mxl_handle_scs_req(struct hostapd_data *hapd,
 				scs_count ++;
 				break;
 			case SCS_REQ_REMOVE:
-				status = mxl_scs_remove_req(hapd, mgmt, elen, scsId);
+				status = mxl_scs_remove_req(hapd, mgmt->sa, elen, scsId);
 				status_list[scs_count].scsId = scsId;
 				status_list[scs_count].status = status;
 				scs_count ++;
 				break;
 			case SCS_REQ_CHANGE:
-				status = mxl_scs_remove_req(hapd, mgmt, elen, scsId);
+				status = mxl_scs_remove_req(hapd, mgmt->sa, elen, scsId);
