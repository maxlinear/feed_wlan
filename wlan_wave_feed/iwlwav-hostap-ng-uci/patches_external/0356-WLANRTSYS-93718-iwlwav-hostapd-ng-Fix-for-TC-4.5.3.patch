 					status = mxl_scs_add_req(hapd, mgmt, pos, elen, scsId);
 				status_list[scs_count].scsId = scsId;
@@ -605,7 +607,7 @@ void mxl_handle_scs_req(struct hostapd_data *hapd,
 
 		pos += elen;
 	}
-	mxl_send_scs_resp(hapd, mgmt, status_list, scs_count);
+	mxl_send_scs_resp(hapd, mgmt->sa, status_list, scs_count, dialog_token);
