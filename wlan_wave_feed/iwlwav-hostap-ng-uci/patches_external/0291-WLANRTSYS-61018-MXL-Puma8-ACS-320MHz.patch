 				break;
 			len += ret;
diff --git a/src/ap/mxl_acs.c b/src/ap/mxl_acs.c
index 82d10f073..e8ce0fc3c 100644
--- a/src/ap/mxl_acs.c
+++ b/src/ap/mxl_acs.c
@@ -693,6 +693,20 @@ static u32 acs_get_center_chan_index(struct hostapd_iface *iface)
 				mxl_chan_num = ARRAY_SIZE(g_channels160_6G);
 			}
 			break;
+		case CONF_OPER_CHWIDTH_320MHZ:
+			if (iface->conf->mxl_conf.acs_eht_mode == ACS_EHT_MODE_320_2) {
+				mxl_chan = g_channels320_2_6G;
+				mxl_chan_num = ARRAY_SIZE(g_channels320_2_6G);
+			} else if (iface->conf->mxl_conf.acs_eht_mode == ACS_EHT_MODE_320_1) {
+				mxl_chan = g_channels320_1_6G;
+				mxl_chan_num = ARRAY_SIZE(g_channels320_1_6G);
+			} else {
+				mxl_chan = g_channels320_1_6G;
+				mxl_chan_num = ARRAY_SIZE(g_channels320_1_6G);
+				mxl_chan1 = g_channels320_2_6G;
+				mxl_chan_num1 = ARRAY_SIZE(g_channels320_2_6G);
+			}
+			break;
 		default:
 			break;
 	}
@@ -1927,6 +1941,95 @@ static int acs_unii4_chan_disabled(struct hostapd_iface *iface, struct hostapd_c
 	return false;
 }
 
+static bool is_in_exclude_list(const struct mxl_hostapd_config *conf,
+                                     int op_band, int chan)
+{
+    for (int i = 0; i < conf->acs_exclude_opclass_ch_count; i++) {
+        const struct acs_exclude *entry = &conf->acs_exclude_opclass_ch_list[i];
+        if (op_class_to_bandwidth(entry->op_class) == op_band &&
+            entry->channel == chan)
+            return true;
+    }
+    return false;
+}
+
+static int map_5g_80_center(int chan)
+{
+    if (chan >= 36  && chan <= 48)  return 42;
+    if (chan >= 52  && chan <= 64)  return 58;
+    if (chan >= 100 && chan <= 112) return 106;
+    if (chan >= 116 && chan <= 128) return 122;
+    if (chan >= 132 && chan <= 144) return 138;
+    if (chan >= 149 && chan <= 161) return 155;
+    return chan;
+}
+
+static int map_5g_160_center(int chan)
+{
+    if (chan >= 36  && chan <= 64)   return 50;
+    if (chan >= 100 && chan <= 128)  return 114;
+    return chan;
+}
+
+static bool is_excluded_opclass_chan(struct hostapd_iface *iface, int channel, int bandwidth)
+{
+   struct mxl_hostapd_config *mxl_conf = &iface->conf->mxl_conf;
+
+   if (mxl_conf->acs_exclude_opclass_ch_count <= 0)
+      return false;
+
+   const struct acs_exclude *list = mxl_conf->acs_exclude_opclass_ch_list;
+
+   /* Band is inferred from the FIRST entry. */
+   const int list_is_5g = is_5ghz_op_class(list[0].op_class);
+	const int list_is_6g = is_6ghz_op_class(list[0].op_class);
+
+   int eff_bw = bandwidth;
+   int eff_chan = channel;
+   int bw = 0;
+
+   /* For wide channels, first verify whether the primary 20 MHz channel is excluded.
+    * If the primary channel is excluded, the corresponding wide channel
+    * must also be treated as excluded.
+    */
+   if ((eff_bw > 40 && list_is_5g) || (eff_bw > 20 && list_is_6g)) {
+      if (is_in_exclude_list(mxl_conf, 20, channel))
+         return true;
+
+      /* Not excluded at 20 MHz; derive center channel and keep effective bw. */
+      if (list_is_5g) {
+         if (eff_bw == 80)
+            eff_chan = map_5g_80_center(channel);
+         else if (eff_bw == 160)
+            eff_chan = map_5g_160_center(channel);
+      } else if (list_is_6g) {
+         u8 seg0 = 0, seg1 = 0;
+         switch (eff_bw) {
+            case 20:
+               bw = HE_OPER_CHANWIDTH_20;
+               break;
+            case 40:
+               bw = HE_OPER_CHANWIDTH_40;
+               break;
+            case 80:
+               bw = HE_OPER_CHANWIDTH_80;
+               break;
+            case 160:
+               bw = HE_OPER_CHANWIDTH_160;
+               break;
+            case 320:
+               bw = EHT_OPER_CHANWIDTH_320;
+               break;
+            default:
+               break;
+         }
+         ch_width_and_ch_num_to_seg_idx(bw, channel, &seg0, &seg1);
+         eff_chan = (eff_bw < 160) ? seg0 : seg1;
+      }
+   }
+   return is_in_exclude_list(mxl_conf, eff_bw, eff_chan);
+}
+
 static int acs_is_subchannel_allowed(struct hostapd_iface *iface, int channel)
 {
 	int j;
@@ -2056,6 +2159,10 @@ void add_channel_pair_candidates(struct hostapd_iface *iface, channel_pair *chan
 			if ((base_freq < 5000) && (!iface->conf->mxl_conf.acs_use24overlapped) &&
 			    (acs_is_40_mhz_overlap_chan(&channel_pairs[i])))
 				continue;
+			if (is_excluded_opclass_chan(iface, channel_pairs[i].primary, 40) ||
+				is_excluded_opclass_chan(iface, channel_pairs[i].secondary, 40)) {
+					continue;
+				}
 
 			if (channel_pairs[i].primary < channel_pairs[i].secondary)
 				candidates[iface->mxl_iface.num_candidates].freq = chan->freq;
@@ -2223,7 +2330,8 @@ void mxl_acs_init_candidate_table(struct hostapd_iface *iface)
 
 		if (!acs_unii4_chan_disabled(iface, chan) &&
 		    (iface->conf->mxl_conf.acs_use24overlapped || (chan->chan == 1) ||
-		    (chan->chan == 6) || (chan->chan == 11) || (chan->freq >= 5000))) {
+		    (chan->chan == 6) || (chan->chan == 11) || (chan->freq >= 5000)) &&
+		    !is_excluded_opclass_chan(iface, chan->chan, 20)) {
 			if (chan->flag & HOSTAPD_CHAN_RADAR)
 				candidates[iface->mxl_iface.num_candidates].radar_affected = true;
 
@@ -2286,6 +2394,16 @@ void mxl_acs_init_candidate_table(struct hostapd_iface *iface)
 			if (bw_80_160_320 & BIT(CONF_OPER_CHWIDTH_160MHZ)) { /* 160 MHz supported */
 				add_160_channels(iface, g_channels160_6G, ARRAY_SIZE(g_channels160_6G), chan);
 			}
+			if (bw_80_160_320 & BIT(CONF_OPER_CHWIDTH_320MHZ)) { /* 320 MHz supported */
+				if (iface->conf->mxl_conf.acs_eht_mode == ACS_EHT_MODE_320_2)
+					add_320_channels(iface, g_channels320_2_6G, ARRAY_SIZE(g_channels320_2_6G), chan);
+				else if (iface->conf->mxl_conf.acs_eht_mode == ACS_EHT_MODE_320_1)
+					add_320_channels(iface, g_channels320_1_6G, ARRAY_SIZE(g_channels320_1_6G), chan);
+				else {
+					add_320_channels(iface, g_channels320_1_6G, ARRAY_SIZE(g_channels320_1_6G), chan);
+					add_320_channels(iface, g_channels320_2_6G, ARRAY_SIZE(g_channels320_2_6G), chan);
+				}
+			}
 		}
 	}
 	/* 80p80 is not supported */
