+bool mxl_hostapd_ieee80211n_check_40mhz(struct hostapd_iface *iface)
+{
+       if (iface->conf->mxl_conf.dfs_debug_chan)
+               return true;
+
+       if (iface->conf->mxl_conf.ignore_40_mhz_intolerant)
+               return true;
+
