+
+int mxl_hostapd_restart_iface(struct hostapd_iface *iface)
+{
+        int res;
+        int acs = iface->conf->acs;
+
+        iface->whm_if_fail = false;
+        iface->conf->acs = 0;
+        hostapd_disable_iface(iface);
+        res = hostapd_enable_iface(iface);
+        iface->conf->acs = acs;
+
+        return res;
+}
