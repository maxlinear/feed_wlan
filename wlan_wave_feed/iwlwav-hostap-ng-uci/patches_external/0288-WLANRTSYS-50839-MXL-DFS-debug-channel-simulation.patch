+++ b/hostapd/mxl_config.c
@@ -1847,6 +1847,8 @@ int mxl_hostapd_config_fill (struct hostapd_config *conf,
 			return 0;
 		}
 		mxl_conf->allow_scan_during_cac = val;
+	} else if(mxl_config_check_dfs_debug_chan(conf, buf, pos)) {
+		return 1;
 #if defined(CONFIG_SCS_MXL) || defined(CONFIG_MSCS_MXL)
 	} else if(mxl_config_check_qos_deny_list(conf, buf, pos)) {
 		return 1;
@@ -2035,7 +2037,7 @@ int mxl_hostapd_config_fill (struct hostapd_config *conf,
