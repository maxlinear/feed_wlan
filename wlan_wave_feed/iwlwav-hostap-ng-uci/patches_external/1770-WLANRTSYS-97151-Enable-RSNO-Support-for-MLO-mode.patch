+static int wpa_auth_ml_rsn_override_kde_len(struct wpa_state_machine *sm, struct wpa_authenticator *wpa_auth, u8 *wpa_ie,int wpa_ie_len)
+{
+	int kde_len = 0;
+	const u8 *rsne_override = get_vendor_ie((const u8 *) wpa_ie, wpa_ie_len, RSNE_OVERRIDE_IE_VENDOR_TYPE);
+	const u8 *rsne_override_2 = get_vendor_ie((const u8 *) wpa_ie, wpa_ie_len, RSNE_OVERRIDE_2_IE_VENDOR_TYPE);
+	const u8 *rsnxe_override = get_vendor_ie((const u8 *) wpa_ie, wpa_ie_len, RSNXE_OVERRIDE_IE_VENDOR_TYPE);
+
+	if(!rsne_override && !rsne_override_2 && !rsnxe_override){
+		return 0; /*No override KDE neeeded*/
+	}
+
+	/* KDE Header: IE_HDR_LEN(2) + RSN_SELECTOR_LEN(4) + LINK_ID(1) */
+	kde_len = 2 + RSN_SELECTOR_LEN + 1;
+
+	/*RSNE Override*/
+	if(rsne_override)
+		kde_len += (rsne_override[1] + 2);
+
+	/*RSNE Override 2*/
+	if(rsne_override_2)
+		kde_len += (rsne_override_2[1] + 2);
+
+	/*RSNXE Override*/
+	if(rsnxe_override)
+		kde_len += (rsnxe_override[1] + 2);
+
+	return kde_len;
+}
+
+static u8 * wpa_auth_ml_rsn_override_kdes(u8 *pos, struct wpa_authenticator *wpa_auth, u8 *wpa_ie, int wpa_ie_len)
+{
+	u8 *kde;
+	u8 kde_len = 1;
+	u8 *kde_pos;
+	size_t len;
+	const u8 *rsne_override = get_vendor_ie((const u8 *) wpa_ie, wpa_ie_len, RSNE_OVERRIDE_IE_VENDOR_TYPE);
+	const u8 *rsne_override_2 = get_vendor_ie((const u8 *) wpa_ie, wpa_ie_len, RSNE_OVERRIDE_2_IE_VENDOR_TYPE);
+	const u8 *rsnxe_override = get_vendor_ie((const u8 *) wpa_ie, wpa_ie_len, RSNXE_OVERRIDE_IE_VENDOR_TYPE);
+
+	if (!rsne_override && !rsne_override_2 && !rsnxe_override) {
+		wpa_printf(MSG_DEBUG, "MLO: No RSN Override elements found");
+		return pos; /* Nothing to add */
+	}
+
+	if(rsne_override)
+		kde_len += rsne_override[1] + 2;
+	if(rsne_override_2)
+		kde_len += rsne_override_2[1] + 2;
+	if(rsnxe_override)
+		kde_len += rsnxe_override[1] + 2;
+
+	kde = os_malloc(kde_len);
+	if (!kde)
+		return NULL;
+
+	/* RSNK link info */
+	kde[0] = wpa_auth->mlo_conf.link1_linkid & MXL_RSN_OVERRIDE_LINK_KDE_LI_LINK_ID_MASK;
+
+	kde_pos = &kde[1];
+
+	/* Add RSNE Override */
+	if(rsne_override) {
+		len = rsne_override[1] + 2;
+		memcpy_s(kde_pos, len, rsne_override, len);
+		kde_pos += len;
+	}
+
+	/* Add RSNE Override 2 */
+	if(rsne_override_2) {
+		len = rsne_override_2[1] + 2;
+		memcpy_s(kde_pos, len, rsne_override_2, len);
+		kde_pos += len;
+	}
+
+	/* Add RSNXE Override */
+	if(rsnxe_override) {
+		len = rsnxe_override[1] + 2;
+		memcpy_s(kde_pos, len, rsnxe_override, len);
+		kde_pos += len;
+	}
+
+	pos = wpa_add_kde(pos, MXL_WFA_KEY_DATA_RSN_OVERRIDE_LINK, kde, kde_len, NULL, 0);
+
+	os_free(kde);
+
+	wpa_printf(MSG_DEBUG, "MLO: Added RSN Override Link KDE (link_id=%d)",wpa_auth->mlo_conf.link1_linkid);
+
+	return pos;
+}
