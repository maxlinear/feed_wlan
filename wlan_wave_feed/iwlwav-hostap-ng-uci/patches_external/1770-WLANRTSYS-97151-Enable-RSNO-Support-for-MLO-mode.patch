+/**
+ * mxl_wpa_auth_mirror_rsn_selection - Mirror RSN selection from one SM to another
+ * @src_sm: Source WPA state machine (primary station)
+ * @dst_sm: Destination WPA state machine (linked station)
+ */
+void mxl_wpa_auth_mirror_rsn_selection(struct wpa_state_machine *src_sm, struct wpa_state_machine *dst_sm)
+{
+	if (!src_sm || !dst_sm) {
+		wpa_printf(MSG_DEBUG, "RSN Selection: Invalid state machines for mirroring");
+		return;
+	}
+
+	os_free(dst_sm->rsn_selection);
+	dst_sm->rsn_selection = NULL;
+	dst_sm->rsn_selection_len = 0;
+	dst_sm->rsn_override = false;
+	dst_sm->rsn_override_2 = false;
+
+	if (src_sm->rsn_selection && src_sm->rsn_selection_len > 0) {
+		dst_sm->rsn_selection = os_memdup(src_sm->rsn_selection, src_sm->rsn_selection_len);
+		if (!dst_sm->rsn_selection) {
+			wpa_printf(MSG_ERROR, "RSN Selection: Failed to allocate memory for mirroring");
+			dst_sm->rsn_selection_len = 0;
+			return;
+		}
+		dst_sm->rsn_selection_len = src_sm->rsn_selection_len;
+
+		dst_sm->rsn_override = src_sm->rsn_override;
+		dst_sm->rsn_override_2 = src_sm->rsn_override_2;
+
+		wpa_printf(MSG_DEBUG,
+					"RSN Selection: Mirrored (len=%zu, override=%d, override_2=%d)",
+					dst_sm->rsn_selection_len,
+					dst_sm->rsn_override,
+					dst_sm->rsn_override_2);
+	} else {
