+/**
+ * mxl_check_assoc_ies_owe - Validate authentication method for MLO stations
+ * @hapd: Pointer to hostapd data structure
+ * @sta: Pointer to station information
+ * @elems: Parsed IEEE 802.11 elements from association request
+ *
+ * This function validates that Multi-Link Operation (MLO) stations are using
+ * secure authentication methods (SAE/WPA3 or OWE) during association.
+ *
+ * Returns: true if validation fails (invalid auth method), false if valid or not MLO
+ */
+
 bool mxl_check_assoc_ies_owe(struct hostapd_data *hapd, struct sta_info *sta, struct ieee802_11_elems *elems)
 {
-	if (mxl_is_mlo_enabled(hapd->conf) && mxl_mlo_is_ml_sta(sta)) {
-		if (!(((sta->auth_alg == WLAN_AUTH_SAE) &&
-		       (hapd->conf->wpa_key_mgmt & (WPA_KEY_MGMT_SAE | WPA_KEY_MGMT_SAE_EXT_KEY))) ||
-				 ((sta->auth_alg == WLAN_AUTH_OPEN) && ((wpa_auth_uses_sae(sta->wpa_sm)) || ((hapd->conf->wpa_key_mgmt & WPA_KEY_MGMT_OWE) &&
-				 elems->owe_dh))))) {
-			return true;
-		}
-	}
-	return false;
+	bool is_sae_auth;
+	bool is_owe_auth;
+
+	if (!mxl_is_mlo_enabled(hapd->conf) || !mxl_mlo_is_ml_sta(sta))
+		return false;
+
+	is_sae_auth = (sta->auth_alg == WLAN_AUTH_SAE) &&
+					((hapd->conf->wpa_key_mgmt & (WPA_KEY_MGMT_SAE | WPA_KEY_MGMT_SAE_EXT_KEY)) ||
+						(hapd->conf->rsn_override_key_mgmt_2 & WPA_KEY_MGMT_SAE_EXT_KEY));
+	
+	is_owe_auth = (sta->auth_alg == WLAN_AUTH_OPEN) &&
+					(wpa_auth_uses_sae(sta->wpa_sm) ||
+						((hapd->conf->wpa_key_mgmt & WPA_KEY_MGMT_OWE) && elems->owe_dh));
+
+	return !(is_sae_auth || is_owe_auth);
 }
 
