+diff --git a/src/ap/ctrl_iface_ap.c b/src/ap/ctrl_iface_ap.c
+index 4f920d9d0..922c6dd5a 100644
+--- a/src/ap/ctrl_iface_ap.c
++++ b/src/ap/ctrl_iface_ap.c
+@@ -1147,11 +1147,11 @@ int hostapd_ctrl_iface_status(struct hostapd_data *hapd, char *buf,
+ 
+ #ifdef CONFIG_IEEE80211BE_MXL_MLO
+ 	if (mxl_is_mlo_enabled(hapd->conf)) {
+-		struct hostapd_data *sib_bss;
+ 		struct p_ap_mld *mld = mxl_ml_get_ap_mld(hapd);
+ 		int idx = 0;
+ 
+ 		if (mld) {
++			struct hostapd_data *sib_bss;
+ 			ret = os_snprintf(buf + len, buflen - len,
+ 					  "mld_id=%d\n"
+ 					  "mld_addr=" MACSTR "\n"
+diff --git a/src/ap/drv_callbacks.c b/src/ap/drv_callbacks.c
+index 7763c9cc9..0b1ef15f9 100644
+--- a/src/ap/drv_callbacks.c
++++ b/src/ap/drv_callbacks.c
+@@ -592,16 +592,16 @@ int hostapd_notif_assoc(struct hostapd_data *hapd, const u8 *addr,
+ 			sta->wpa_sm = wpa_auth_sta_init(hapd->wpa_auth,
+ 							sta->addr,
+ 							p2p_dev_addr);
+-#ifdef CONFIG_IEEE80211BE_MXL_MLO
+-		if (sta->wpa_sm && mxl_is_mlo_enabled(hapd->conf) && mxl_mlo_is_ml_sta(sta))
+-			mxl_wpa_mld_auth_sta_init(sta);
+-#endif /* CONFIG_IEEE80211BE_MXL_MLO */
+ 
+ 		if (sta->wpa_sm == NULL) {
+ 			wpa_printf(MSG_ERROR,
+ 				   "Failed to initialize WPA state machine");
+ 			return -1;
+ 		}
++#ifdef CONFIG_IEEE80211BE_MXL_MLO
++		if (mxl_is_mlo_enabled(hapd->conf) && mxl_mlo_is_ml_sta(sta))
++			mxl_wpa_mld_auth_sta_init(sta);
++#endif /* CONFIG_IEEE80211BE_MXL_MLO */
+ 		wpa_auth_set_rsn_selection(sta->wpa_sm, elems.rsn_selection,
+ 					   elems.rsn_selection_len);
+ #ifdef CONFIG_IEEE80211BE
+diff --git a/src/ap/hostapd.c b/src/ap/hostapd.c
+index 5ce1c9bcf..59d96f852 100644
+--- a/src/ap/hostapd.c
++++ b/src/ap/hostapd.c
+@@ -5162,6 +5162,7 @@ static int hostapd_reconf_add_bss(struct hostapd_iface *iface, struct hostapd_co
+ 		return -1;
+ 	}
+ 
++#ifdef CONFIG_IEEE80211BE_MXL_MLO
+ 	/* Reload all non-TX BSS in MBSSID since wpa auth of TX BSS has changed */
+ 	if (mxl_hostapd_is_mbssid_tx_bss(iface->bss[idx])) {
+ 		for (size_t j = MULTIBSS_REFERENCE_BSS_IDX; j < iface->num_bss; j++) {
+@@ -5171,6 +5172,7 @@ static int hostapd_reconf_add_bss(struct hostapd_iface *iface, struct hostapd_co
+ 			hostapd_reload_bss_only(iface->bss[j]);
+ 		}
+ 	}
++#endif /* CONFIG_IEEE80211BE_MXL_MLO */
+ 
+ 	return 0;
+ }
