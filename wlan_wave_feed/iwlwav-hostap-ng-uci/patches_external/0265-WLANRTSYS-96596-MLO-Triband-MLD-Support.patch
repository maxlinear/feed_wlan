+static void mxl_mlo_set_assoc_link_id(struct sta_info *sta, u8 assoc_link_id)
+{
+	struct sta_info *lsta = NULL;
+
+	sta->mxl_sta_info.assoc_link_id = assoc_link_id;
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		lsta->mxl_sta_info.assoc_link_id = assoc_link_id;
+	}
+}
+
+static int mxl_mld_set_linked_stas(struct sta_info *sta)
+{
+	struct sta_info *lsta1 = sta->mxl_sta_info.linked_sta[0];
+	struct sta_info *lsta2 = sta->mxl_sta_info.linked_sta[1];
+
+	if (!lsta1 && !lsta2)
+		return -1;
+
+	if (lsta1 && !lsta2) {
+		lsta1->mxl_sta_info.linked_sta[0] = sta;
+	} else if (lsta1 && lsta2) {
+		lsta1->mxl_sta_info.linked_sta[0] = sta;
+		lsta1->mxl_sta_info.linked_sta[1] = lsta2;
+
+		lsta2->mxl_sta_info.linked_sta[0] = sta;
+		lsta2->mxl_sta_info.linked_sta[1] = lsta1;
+	} else {
+		return -1;
+	}
+
+	return 0;
+}
