+void mxl_ml_wpa_remove_siblings_ptk(struct wpa_state_machine *sm)
+{
+	struct mxl_wpa_link_info *link_info;
+	struct wpa_authenticator *sibling_wpa_auth;
+
+	if (!sm)
+		return;
+	
+	mxl_wpa_sm_for_each_sibling_link(link_info, sm) {
+		sibling_wpa_auth = mxl_wpa_sta_get_wpa_auth_by_link_id(sm, link_info->link_id);
+		if (!sibling_wpa_auth)
+			continue;
+		if (mxl_wpa_auth_set_key(sibling_wpa_auth, 0, WPA_ALG_NONE, link_info->addr, 0, NULL,
+					   0, KEY_FLAG_PAIRWISE)) {
+			wpa_printf(MSG_ERROR, "MXL_MLO RSN: PTK removal from the driver "
+				   "failed for sibling link %d", link_info->link_id);
+		}
+	}
+}
+
+int mxl_ml_wpa_set_siblings_fils_tk(struct wpa_state_machine *sm)
+{
+	struct mxl_wpa_link_info *link_info;
+	struct wpa_authenticator *sibling_wpa_auth;
+	enum wpa_alg alg;
+	int klen;
+
+	if (!sm)
+		return -1;
+
+	alg = wpa_cipher_to_alg(sm->pairwise);
+	klen = wpa_cipher_key_len(sm->pairwise);
+
+	mxl_wpa_sm_for_each_sibling_link(link_info, sm) {
+		sibling_wpa_auth = mxl_wpa_sta_get_wpa_auth_by_link_id(sm, link_info->link_id);
+		if (!sibling_wpa_auth) {
+			wpa_printf(MSG_ERROR,
+				   "MXL_MLO WPA: Sibling fils tk - no wpa_auth found for link id %d",
+				   link_info->link_id);
+			return -1;
+		}
+		if (mxl_wpa_auth_set_key(sibling_wpa_auth, 0, alg, link_info->addr, 0,
+					   sm->PTK.tk, klen, KEY_FLAG_PAIRWISE_RX_TX)) {
+			wpa_printf(MSG_ERROR, "MXL_MLO FILS: Failed to set TK to the driver "
+				   "for sibling link %d", link_info->link_id);
+			return -1;
+		}
+	}
+
+	return 0;
+}
+
+int mxl_ml_wpa_set_siblings_key(struct wpa_state_machine *sm)
+{
+	struct mxl_wpa_link_info *link_info;
+	struct wpa_authenticator *sibling_wpa_auth;
+	enum wpa_alg alg;
+	int klen;
+
+	if (!sm)
+		return -1;
+
+	alg = wpa_cipher_to_alg(sm->pairwise);
+	klen = wpa_cipher_key_len(sm->pairwise);
+
+	mxl_wpa_sm_for_each_sibling_link(link_info, sm) {
+		sibling_wpa_auth = mxl_wpa_sta_get_wpa_auth_by_link_id(sm, link_info->link_id);
+		if (!sibling_wpa_auth) {
+			wpa_printf(MSG_ERROR,
+				   "MXL_MLO WPA: Sibling set key - no wpa_auth found for link id %d",
+				   link_info->link_id);
+			return -1;
+		}
+		if (mxl_wpa_auth_set_key(sibling_wpa_auth, 0, alg, link_info->addr, 0,
+						   sm->PTK.tk, klen, KEY_FLAG_PAIRWISE_RX_TX)) {
+			wpa_printf(MSG_ERROR,
+				   "MXL_MLO WPA: Failed to set key for sibling link %d to driver",
+				   link_info->link_id);
+			mxl_wpa_sta_disconnect(sibling_wpa_auth, link_info->addr,
+						   WLAN_REASON_PREV_AUTH_NOT_VALID);
+			return -1;
+		}
+	}
+
+	return 0;
+}
+
+void mxl_wpa_group_ensure_siblings_init(struct wpa_state_machine *sm)
+{
+	struct wpa_authenticator *sib_wpa_auth = NULL;
+
+	mxl_wpa_for_each_sibling_wpa_auth(sib_wpa_auth, sm->wpa_auth) {
+		mxl_wpa_group_ensure_init(sib_wpa_auth, sm->group);
+	}
+}
+
+struct wpa_authenticator *mxl_wpa_sta_get_wpa_auth_by_link_id(struct wpa_state_machine *sm,
+															   u8 link_id)
+{
+	struct wpa_authenticator *sib_wpa_auth = NULL;
+
+	if (!sm || !mxl_wpa_is_multi_link_sta(sm))
+		return NULL;
+
+	wpa_printf(MSG_DEBUG, "get wpa_auth with link_id %u", link_id);
+	mxl_wpa_for_each_sibling_wpa_auth(sib_wpa_auth, sm->wpa_auth) {
+		if (sib_wpa_auth->mlo_conf.wpa_link_conf.link_id == link_id) {
+			return sib_wpa_auth;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * Check if the STA is a multi-link STA (non single-link MLO STA)
+ */
+bool mxl_wpa_is_multi_link_sta(struct wpa_state_machine *sm)
+{
+	if (!sm)
+		return false;
+
+	return (sm->mxl_sm.is_ml_sta && !sm->mxl_sm.is_single_link_ml_sta);
+}
+
+void mxl_wpa_auth_sta_deinit(struct wpa_state_machine *sm)
+{
+	if (!sm)
+		return;
+
+	sm->mxl_sm.valid = false;
+}
