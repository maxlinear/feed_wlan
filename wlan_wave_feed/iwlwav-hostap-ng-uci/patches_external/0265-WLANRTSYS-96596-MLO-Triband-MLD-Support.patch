+static size_t mxl_ml_wpa_auth_group_kdes_len(struct wpa_state_machine *sm)
+{
+	struct mxl_wpa_link_info *link_info;
+	struct wpa_authenticator *sibling_wpa_auth;
+	size_t gtk_len = 0;
+	struct wpa_group *gsm, *sib_gsm;
+	u8 *wpa_ie = NULL, *sib_wpa_ie = NULL;
+	int wpa_ie_len = 0, sib_wpa_ie_len = 0;
+	size_t sib_gtk_len = 0;
+	size_t kde_len = 0;
+
+	if (!sm)
+		return 0;
+	
+	gsm = sm->group;
+	gtk_len = gsm->GTK_len;
+	wpa_ie = sm->wpa_auth->wpa_ie;
+	wpa_ie_len = sm->wpa_auth->wpa_ie_len;
+
+	kde_len += wpa_auth_ml_group_kdes_len(sm, sm->wpa_auth, wpa_ie, wpa_ie_len, gtk_len);
+	/* MLO Group KDEs len is calculated only for setup links */
+	mxl_wpa_sm_for_each_sibling_link(link_info, sm) {
+		sibling_wpa_auth = mxl_wpa_sta_get_wpa_auth_by_link_id(sm, link_info->link_id);
+		if (!sibling_wpa_auth)
+			continue;
+		
+		sib_gsm = sibling_wpa_auth->group;
+		sib_gtk_len = sib_gsm->GTK_len;
+		sib_wpa_ie = sibling_wpa_auth->wpa_ie;
+		sib_wpa_ie_len = sibling_wpa_auth->wpa_ie_len;
+		kde_len += wpa_auth_ml_group_kdes_len(sm, sibling_wpa_auth, sib_wpa_ie, sib_wpa_ie_len, sib_gtk_len);
+	}
+
+	return kde_len;
+}
+
+static size_t mxl_ml_wpa_auth_kdes_len(struct wpa_state_machine *sm)
+{
+	struct wpa_authenticator *sibling_wpa_auth;
+	u8 *wpa_ie = NULL, *sib_wpa_ie = NULL;
+	int wpa_ie_len = 0, sib_wpa_ie_len = 0;
+	size_t kde_len = 0;
+
+	if (!sm)
+		return 0;
+
+	/* For the MAC address KDE */
+	kde_len += (2 + RSN_SELECTOR_LEN + ETH_ALEN);
+	/* MLO link RSN KDEs len */
+	wpa_ie = sm->wpa_auth->wpa_ie;
+	wpa_ie_len = sm->wpa_auth->wpa_ie_len;
+	kde_len += wpa_auth_ml_link_kde_len(sm, sm->wpa_auth, wpa_ie, wpa_ie_len);
+	if (rsn_is_snonce_cookie(sm->SNonce)) {
+		kde_len += wpa_auth_ml_rsno_kde_len(sm, sm->wpa_auth, wpa_ie, wpa_ie_len);
+	}
+	/* MLO link RSN KDE is consturcted for all affiliated links */
+	mxl_wpa_for_each_sibling_wpa_auth(sibling_wpa_auth, sm->wpa_auth) {
+		if (!sibling_wpa_auth)
+			continue;
+		sib_wpa_ie = sibling_wpa_auth->wpa_ie;
+		sib_wpa_ie_len = sibling_wpa_auth->wpa_ie_len;
+		kde_len += wpa_auth_ml_link_kde_len(sm, sibling_wpa_auth, sib_wpa_ie, sib_wpa_ie_len);
+		if (rsn_is_snonce_cookie(sm->SNonce)) {
+			kde_len += wpa_auth_ml_rsno_kde_len(sm, sibling_wpa_auth, sib_wpa_ie, sib_wpa_ie_len);
+		}
+	}
+
+	/* MLO Group KDEs len */
+	kde_len += mxl_ml_wpa_auth_group_kdes_len(sm);
+
+	return kde_len;
+}
+
+static u8 * mxl_ml_wpa_auth_kdes(struct wpa_state_machine *sm, u8 *pos)
+{
+	struct wpa_authenticator *sibling_wpa_auth;
+	u8 *wpa_ie = NULL, *sib_wpa_ie = NULL;
+	int wpa_ie_len = 0, sib_wpa_ie_len = 0;
+
+	if (!sm)
+		return pos;
+	
+	/* For the MAC Address KDE */
+	pos = wpa_add_kde(pos, RSN_KEY_DATA_MAC_ADDR, sm->wpa_auth->mlo_conf.ap_mld_mac, ETH_ALEN, NULL, 0);
+
+	/* MLO link RSN/RSNX KDEs */
+	wpa_ie = sm->wpa_auth->wpa_ie;
+	wpa_ie_len = sm->wpa_auth->wpa_ie_len;
+	pos = wpa_auth_ml_kdes(pos, sm->wpa_auth, wpa_ie, wpa_ie_len);
+	if (!pos)
+		return NULL;
+	if (rsn_is_snonce_cookie(sm->SNonce)) {
+		pos = wpa_auth_ml_rsno_kdes(pos, sm->wpa_auth, wpa_ie, wpa_ie_len);
+		if (!pos)
+			return NULL;
+	}
+	/* MLO link RSN/RSNX KDEs is consturcted for all affiliated links */
+	mxl_wpa_for_each_sibling_wpa_auth(sibling_wpa_auth, sm->wpa_auth) {
+		if (!sibling_wpa_auth)
+			continue;
+		sib_wpa_ie = sibling_wpa_auth->wpa_ie;
+		sib_wpa_ie_len = sibling_wpa_auth->wpa_ie_len;
+		pos = wpa_auth_ml_kdes(pos, sibling_wpa_auth, sib_wpa_ie, sib_wpa_ie_len);
+		if (!pos)
+			return NULL;
+		if (rsn_is_snonce_cookie(sm->SNonce)) {
+			pos = wpa_auth_ml_rsno_kdes(pos, sibling_wpa_auth, sib_wpa_ie, sib_wpa_ie_len);
+			if (!pos)
+				return NULL;
+		}
+	}
+
+	/* MLO Group KDEs */
+	pos = mxl_wpa_auth_ml_group_kdes(sm, pos);
+
 	return pos;
 }
 
