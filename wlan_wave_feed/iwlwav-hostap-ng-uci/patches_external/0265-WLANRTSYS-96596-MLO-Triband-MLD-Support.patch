+static u16 mxl_mld_proccess_per_sta_profile(struct hostapd_data *hapd, struct sta_info *sta,
+											   struct wpabuf *mlbuf, const u8 *per_sta_ie)
+{
+	const u8 *pos, *end;
+	u8 link_mac[ETH_ALEN] = {'\0'};
+	const u8 *ies = NULL;
+	const u8 *ies_end = NULL;
+	size_t ies_len;
+	struct hostapd_data *lhapd = NULL;
+	struct sta_info *lsta = NULL;
+	u8 profile_idx = 0;
+	bool per_sta_found = false;
+
+	ies = wpabuf_head(mlbuf);
+	ies_len = wpabuf_len(mlbuf);
+	ies_end = ((const u8 *) ies) + ies_len;
+
+	/* Parse the Link Info field that starts after the end of the variable
+	 * length Common Info field. */
+	end = per_sta_ie;
+	pos = end;
+	while (ies_end - pos > 2) {
+		size_t sub_elem_len, sta_info_len;
+		size_t nstr_bitmap_len = 0;
+		u16 control;
+		u16 capab = 0;
+		u8 link_id;
+		const u8 *sub_elem_end;
+		int num_frag_subelems;
+
+		num_frag_subelems = ieee802_11_defrag_mle_subelem(mlbuf, pos,
+											   &sub_elem_len);
+		if (num_frag_subelems < 0) {
+			wpa_printf(MSG_DEBUG,
+				   "MXL_MLO: Failed to parse MLE subelem");
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+
+		/* If fragmented - remove FID and frag len fields len */
+		ies_len -= num_frag_subelems * 2;
+		ies_end = ((const u8 *) ies) + ies_len;
+
+		wpa_printf(MSG_DEBUG,
+			   "MXL_MLO: sub element len=%zu, Fragment subelems=%u",
+			   sub_elem_len, num_frag_subelems);
+
+		/* Sub element length cannot be bigger than remaining IEs */
+		if (2 + sub_elem_len > (size_t) (ies_end - pos)) {
+			wpa_printf(MSG_ERROR,
+				   "MXL_MLO: Invalid link info len: %zu %zu",
+				   2 + sub_elem_len, ies_end - pos);
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+
+		if (*pos != WLAN_EID_SUBELEMENT_MLO_PER_STA_PROFILE) {
+			wpa_printf(MSG_WARNING,
+				   "MXL_MLO: Skip unknown Multi-Link element subelement ID=%u",
+				   *pos);
+			pos += 2 + sub_elem_len;
+			continue;
+		}
+
+		if (profile_idx >= MAX_LINKED_STAS) {
+			wpa_printf(MSG_ERROR,
+				   "MXL_MLO: Too many Per-STA Profile subelements - stop parsing");
+			/* Stop parsing when reaching maximum supported linked STAs */
+			break;
+		}
+
+		/* Skip the subelement ID and the length */
+		pos += 2;
+		sub_elem_end = pos + sub_elem_len;
+
+		/* Get the station control field */
+		if (sub_elem_end - pos < 2) {
+			wpa_printf(MSG_ERROR,
+				   "MXL_MLO: Too short Per-STA Profile subelement");
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+		control = WPA_GET_LE16(pos);
+		link_id = control & STA_CTRL_LINK_ID_MASK;
+		lhapd = mxl_ml_get_bss_by_link_id(hapd, link_id);
+		if (!lhapd) {
+			mxl_mld_log_no_sibling_bss(link_id);
+			/* Cant find linked bss - parse next possible per-sta Profile */
+			pos = sub_elem_end;
+			continue;
+		}
+		/* Check MAC address presence */
+		if (!(control & STA_CTRL_MAC_ADDR_PRESENT_MASK)) {
+			wpa_printf(MSG_ERROR,
+				   "MXL_MLO: MAC address not present in Per-STA Profile");
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+
+		if (control & STA_CTRL_NSTR_LINK_PAIR_PRESENT_MASK) {
+			if (control & STA_CTRL_NSTR_BITMAP_SIZE_MASK) {
+				nstr_bitmap_len = 2;
+			} else {
+				nstr_bitmap_len = 1;
+			}
+		}
+		/* Move pos to the start of the STA Info field */
+		pos += LINK_INFO_STA_CTRL_LEN;
+
+		/* The length octet and the MAC address must be present */
+		sta_info_len = 1 + ETH_ALEN;
+		/* Add NSTR info length if present */
+		sta_info_len += nstr_bitmap_len;
+
+		/* Check length */
+		if (sta_info_len > (size_t) (sub_elem_end - pos) ||
+		    sta_info_len > *pos ||
+		    *pos > sub_elem_end - pos) {
+			wpa_printf(MSG_ERROR, "MXL_MLO: Invalid STA Info length");
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+
+		/* Take length from STA Info field */
+		sta_info_len = *pos;
+		end = pos + sta_info_len;
+		
+		/* skip the length */
+		pos++;
+		
+		os_memset(link_mac, 0, ETH_ALEN);
+		memcpy_s(link_mac, ETH_ALEN, pos, ETH_ALEN);
+
+		/* reject assoc req if sibling sta is already associated */
+		lsta = ap_get_sta(lhapd, link_mac);
+		if (!lsta && mxl_hostapd_prune_sta(lhapd, link_mac, NULL)) {
+			wpa_printf(MSG_ERROR, "Sibling sta: " MACSTR
+					" Already present in other bss, Reject assoc req", MAC2STR(link_mac));
+			return WLAN_STATUS_ASSOC_REJECTED_TEMPORARILY;
+		} else if (lsta && lhapd->conf->wpa && mxl_check_sa_query(lhapd, lsta, 0)) {
+			wpa_printf(MSG_ERROR, "Sibling sta: " MACSTR
+					" Already present start SA Query, Reject assoc req", MAC2STR(link_mac));
+			return WLAN_STATUS_ASSOC_REJECTED_TEMPORARILY;
+		}
+
+		/* We dont support NSTR - so if present just skip it */
+		/* Skip to end of STA Info - Includes skipping MAC */
+		pos = end;
+
+		if (sub_elem_end - pos >= 2)
+			// Copy to link?
+			capab = WPA_GET_LE16(pos);
+
+		/* Got to end of sub elem IE */
+		pos = sub_elem_end;
+
+		/* Profile parsing done - set info for new linked STA */
+		sta->mxl_sta_info.linked_sta[profile_idx] = ap_sta_add(lhapd, link_mac);
+		if (!sta->mxl_sta_info.linked_sta[profile_idx]) {
+			wpa_printf(MSG_ERROR, "Unable to handle linked sta");
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+
+		per_sta_found = true;
+
+		lsta = sta->mxl_sta_info.linked_sta[profile_idx];
+
+		memcpy_s(lsta->mxl_sta_info.non_ap_mld_mac, ETH_ALEN, sta->mxl_sta_info.non_ap_mld_mac, ETH_ALEN);
+		lsta->mxl_sta_info.sta_ml_capab = sta->mxl_sta_info.sta_ml_capab;
+		lsta->mxl_sta_info.ext_flags |= WLAN_STA_MULTILINK;
+		lsta->mxl_sta_info.ext_flags &= ~WLAN_STA_SINGLE_LINK_ML_ASSOC;
+		lsta->mxl_sta_info.link_id = link_id;
+		lsta->mxl_sta_info.link_capab = capab;
+		lsta->auth_alg = sta->auth_alg;
+		lsta->flags |= WLAN_STA_AUTH;
+
+		/* Increment for next possible per-Sta Profile */
+		profile_idx++;
+	}
+
+	if (!per_sta_found) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: NO PerSTA Profile element present in AssocReq!!! Using single link ML association");
+		sta->mxl_sta_info.ext_flags |= WLAN_STA_SINGLE_LINK_ML_ASSOC;
+		return WLAN_STATUS_SUCCESS;
+	}
+
+	if (mxl_mld_set_linked_stas(sta)) {
+		wpa_printf(MSG_ERROR,
+			   "MXL_MLO: Failed to set up bidirectional links for linked STAs");
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	/* Don't retain the previous SingleLinkAssoc bit entry for the current MultiLink STA */
+	sta->mxl_sta_info.ext_flags &= ~WLAN_STA_SINGLE_LINK_ML_ASSOC;
+
+	sta->mxl_sta_info.ml_assoc_ie_processed = 1;
+
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		lsta->mxl_sta_info.ml_assoc_ie_processed = 1;
+		lsta->mxl_sta_info.ext_flags &= ~WLAN_STA_SINGLE_LINK_ML_ASSOC;
+	}
+
+	return WLAN_STATUS_SUCCESS;
+}
+
+static int mxl_ml_check_link_ids(struct sta_info *sta)
+{
+	struct sta_info *lsta = NULL;
+	u8 assoc_link_id;
+
+	/* Check is always valid for single link ml */
+	if (mxl_mlo_is_ml_single_link_sta(sta))
+		return 0;
+
+	if (mxl_mlo_is_ml_sta(sta)) {
+		assoc_link_id = sta->mxl_sta_info.link_id;
+		if (!mxl_is_valid_link_id(assoc_link_id)) {
+			wpa_printf(MSG_ERROR, "Invalid assoc link id %d", assoc_link_id);
+			return -1;
+		}
+		mxl_mld_for_each_sibling_sta(lsta, sta) {
+			if (!mxl_is_valid_link_id(lsta->mxl_sta_info.link_id)) {
+				wpa_printf(MSG_ERROR, "Invalid link id %d for linked STA",
+						   lsta->mxl_sta_info.link_id);
+				return -1;
+			}
+			if (lsta->mxl_sta_info.link_id == assoc_link_id) {
+				wpa_printf(MSG_ERROR, "Linked STA with same link id %d already present, reject assoc",
+						   assoc_link_id);
+				return -1;
+			}
+		}
+	}
+
+	return 0;
