+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+struct mxl_ml_wds_entry *mxl_ml_get_pending_wds_entry(struct hostapd_data *hapd,
+				   const u8 *mld_addr)
+{
+	struct p_ap_mld *mld = mxl_ml_get_ap_mld(hapd);
+	struct mxl_ml_wds_entry *wds_entry = NULL;
+	bool found = false;
+	
+	if (!mld_addr) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: Invalid MLD address provided");
+		return NULL;
+	}
+
+	if (!mld) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: ap mld not found");
+		return NULL;
+	}
+
+	dl_list_for_each(wds_entry, &mld->wds.wds_pending_assoc, struct mxl_ml_wds_entry, list) {
+		if (wds_entry == NULL)
+			continue;
+		if (!hostapd_mac_comp(mld_addr, wds_entry->mld_addr)) {
+			found = true;
+			break;
+		}
+	}
+
+	if (!found)
+		wpa_printf(MSG_ERROR, "MXL_MLO: No WDS entry with MLD MAC " MACSTR,
+			   MAC2STR(mld_addr));
+	
+	return found ? wds_entry : NULL;
+}
+
+static void mxl_ml_clear_pending_wds_entry(struct hostapd_data *hapd, const u8 *addr)
+{
+	struct p_ap_mld *mld = mxl_ml_get_ap_mld(hapd);
+	struct mxl_ml_wds_entry *wds = NULL, *entry = NULL;
+	struct wds_ml_link_info *link_info;
+	int i;
+
+	if (!mld || !addr)
+		return;
+
+	if (!mld->wds.initialized)
+		return;
+
+	dl_list_for_each(wds, &mld->wds.wds_pending_assoc, struct mxl_ml_wds_entry, list) {
+		if (wds == NULL)
+			continue;
+		for (i = 0; i < wds->num_of_links; i++) {
+			link_info = &wds->link_info[i];
+			if (!hostapd_mac_comp(link_info->bssid, addr)) {
+				entry = wds;
+				break;
+			}
+		}
+	}
+
+	if (entry)
+		mxl_ml_free_wds_entry(entry);
+}
+
+static void mxl_ml_free_wds_entry(struct mxl_ml_wds_entry *wds_entry)
+{
+	if (!wds_entry)
+		return;
+
+	dl_list_del(&wds_entry->list);
+	os_free(wds_entry);
+}
+
+/* Add affiliated STA of given MLD STA */
+static int mxl_mlo_add_affiliated_wds_sta(struct hostapd_data *hapd, struct sta_info *sta,
+							   int *new_assoc)
+{
+	struct ieee80211_ml_sta_info ml_sta_info;
+
+	if (!hapd || !sta)
+		return -1;
+
+	sta->mxl_sta_info.link_added = 0;
+	
+	os_memset(&ml_sta_info, 0, sizeof(ml_sta_info));
+	memcpy_s(ml_sta_info.mld_mac, ETH_ALEN, sta->mxl_sta_info.non_ap_mld_mac, ETH_ALEN);
+
+	ml_sta_info.is_ml = true;
+	ml_sta_info.is_single_link = mxl_mlo_is_ml_non_single_link_sta(sta) ? false : true;
+	ml_sta_info.link_id = sta->mxl_sta_info.link_id;
+	mxl_hostapd_ml_sta_info_set(sta, ml_sta_info);
+
+	if (mxl_wds_add_sta(hapd, sta, new_assoc)) {
+		wpa_printf(MSG_ERROR, "%s: MXL_MLO failed to add affiliated WDS STA",
+			   hapd->conf->iface);
+		return -1;
+	}
+
+	sta->mxl_sta_info.link_added = 1;
+
+	return 0;
+}
+
+static struct sta_info *mxl_ml_wds_get_sta(struct hostapd_data *hapd, const u8 *addr)
+{
+	struct p_ap_mld *mld = mxl_ml_get_ap_mld(hapd);
+	struct hostapd_data *lhapd;
+
+	if(!mld)
+		return NULL;
+	
+	mxl_mld_for_each_affiliated_link(lhapd, mld) {
+		struct sta_info *sta = ap_get_sta(lhapd, addr);
+		if (sta)
+			return sta;
+	}
+	return NULL;
+}
+
+static void mxl_ml_set_linked_stas(struct sta_info *sta)
+{
+	struct sta_info *lsta1 = sta->mxl_sta_info.linked_sta[0];
+	struct sta_info *lsta2 = sta->mxl_sta_info.linked_sta[1];
+
+	if (lsta1 && !lsta2) {
+		lsta1->mxl_sta_info.linked_sta[0] = sta;
+	} else if (lsta1 && lsta2) {
+		lsta1->mxl_sta_info.linked_sta[0] = sta;
+		lsta1->mxl_sta_info.linked_sta[1] = lsta2;
+
+		lsta2->mxl_sta_info.linked_sta[0] = sta;
+		lsta2->mxl_sta_info.linked_sta[1] = lsta1;
+	}
+}
+
+static int mxl_ml_add_wds_sta(struct hostapd_data *hapd, struct sta_info *sta,
+			   struct mxl_ml_wds_entry *wds_entry)
+{
+	struct hostapd_data *lhapd;
+	struct sta_info *lsta, *sib_sta;
+	struct wds_ml_link_info *link_info;
+	u8 link_id;
+	int i, j = 0, new_assoc = 1;
+	bool is_str = false;
+
+	/* Find and link all affiliated STAs */
+	if (mxl_mlo_is_ml_non_single_link_sta(sta)) {
+		for (i = 0; i < wds_entry->num_of_links; i++) {
+			link_info = &wds_entry->link_info[i];
+			if (link_info->valid && !hostapd_mac_comp(link_info->bssid, sta->addr))
+				continue; // Skip self link
+			if (link_info->valid && (j < MAX_LINKED_STAS)) {
+				sib_sta = mxl_ml_wds_get_sta(hapd, link_info->bssid);
+				if (sib_sta)
+					sta->mxl_sta_info.linked_sta[j++] = sib_sta;
+			}
+		}
+		mxl_ml_set_linked_stas(sta);
+
+		/* WDS STR STA */
+		is_str = !!(sta->mxl_sta_info.sta_ml_capab.mld_capab_oper & MLO_MAX_NUM_SIMUL_LINKS);
+		sta->mxl_sta_info.ext_flags |= is_str ? WLAN_STA_MLD_WDS_STR_STA : WLAN_STA_MLD_WDS_MLSR_STA;
+		mxl_mld_for_each_sibling_sta(lsta, sta) {
+			lsta->mxl_sta_info.ext_flags |= is_str ? WLAN_STA_MLD_WDS_STR_STA : WLAN_STA_MLD_WDS_MLSR_STA;
+		}
+	}
+
+	/* Get AID for MLD STA */
+	if (hostapd_get_aid(hapd, sta) < 0) {
+		hostapd_logger(hapd, sta->addr, HOSTAPD_MODULE_IEEE80211,
+				HOSTAPD_LEVEL_INFO, "No room for more AIDs");
+		goto fail;
+	}
+
+	/* Add first linked WDS STA */
+	if (mxl_mlo_add_affiliated_wds_sta(hapd, sta, &new_assoc)) {
+		ap_free_sta(hapd, sta);
+		return -1;
+	}
+	/* Add all other affiliated WDS STAs */
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		link_id = lsta->mxl_sta_info.link_id;
+		lhapd = mxl_ml_get_bss_by_link_id(hapd, link_id);
+		if (!lhapd) {
+			mxl_mld_log_no_sibling_bss(link_id);
+			goto fail;
+		}
+		if (mxl_mlo_add_affiliated_wds_sta(lhapd, lsta, &new_assoc)) {
+			goto fail;
+		}
+	}
+	/* Add MLD */
+	if (mxl_ml_add_sta_mld(hapd, sta) < 0) {
+		wpa_printf(MSG_ERROR,"MXL_MLO: WDS ML STA ADD failed");
+		goto fail;
+	}
+	/* Set Authorized and enable ports */
+	sta->flags |= WLAN_STA_AUTHORIZED;
+	hostapd_set_authorized(hapd, sta, 1);
+	hapd->new_assoc_sta_cb(hapd, sta, !new_assoc);
+	ieee802_1x_notify_port_enabled(sta->eapol_sm, 1);
+	hostapd_logger(hapd, sta->addr, HOSTAPD_MODULE_IEEE80211,
+		HOSTAPD_LEVEL_INFO, "hostapd_wds_sta_connect: WDS STA connected");
+
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		link_id = lsta->mxl_sta_info.link_id;
+		lhapd = mxl_ml_get_bss_by_link_id(hapd, link_id);
+		if (!lhapd) {
+			mxl_mld_log_no_sibling_bss(link_id);
+			goto fail;
+		}
+		lsta->flags |= WLAN_STA_AUTHORIZED;
+		hostapd_set_authorized(lhapd, lsta, 1);
+		lhapd->new_assoc_sta_cb(lhapd, lsta, !new_assoc);
+		ieee802_1x_notify_port_enabled(lsta->eapol_sm, 1);
+		hostapd_logger(lhapd, lsta->addr, HOSTAPD_MODULE_IEEE80211,
+			HOSTAPD_LEVEL_INFO, "hostapd_wds_sta_connect: WDS STA connected");
+	}
+	return 0;
+
+fail:
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		link_id = lsta->mxl_sta_info.link_id;
+		lhapd = mxl_ml_get_bss_by_link_id(hapd, link_id);
+		if (!lhapd) {
+			continue;
+		}
+		if (lsta->mxl_sta_info.link_added) {
+			ap_free_sta(lhapd, lsta);
+		}
+	}
+	if (sta->mxl_sta_info.link_added) {
+		ap_free_sta(hapd, sta);
+	}
+	return -1;
+}
+
+void mxl_ml_set_wds_link_info(struct mxl_ml_wds_entry *wds_entry, u8 link_id,
+				   const u8 *bssid)
+{
+	struct wds_ml_link_info *link_info;
+	int i;
+
+	if (!wds_entry)
+		return;
+
+	for (i = 0; i < MAX_NUM_LINKS; i++) {
+		link_info = &wds_entry->link_info[i];
+		if (!link_info->valid) {
+			link_info->link_id = link_id;
+			memcpy_s(link_info->bssid, ETH_ALEN, bssid, ETH_ALEN);
+			link_info->valid = true;
+			wds_entry->num_of_links++;
+			break;
+		}
+	}
+}
+
+static void mxl_ml_wds_update_handled_links(struct mxl_ml_wds_entry *wds_entry,
+			   struct sta_info *sta)
+{
+	struct wds_ml_link_info *link_info;
+	int idx;
+
+	for (idx = 0; idx < wds_entry->num_of_links; idx++) {
+		link_info = &wds_entry->link_info[idx];
+		if (link_info->valid &&
+			!hostapd_mac_comp(link_info->bssid, sta->addr) &&
+			link_info->link_id == sta->mxl_sta_info.link_id) {
+			wds_entry->wds_handled_links++;
+			wpa_printf(MSG_DEBUG, "MXL_MLO: WDS expected links %d currently added %d",
+							wds_entry->num_of_links, wds_entry->wds_handled_links);
+		}
+	}
+}
+
+static bool mxl_ml_wds_all_links_handled(struct mxl_ml_wds_entry *wds_entry)
+{
+	return (wds_entry->wds_handled_links == wds_entry->num_of_links);
+}
+
+
+
+void mxl_wds_init_pending_assoc(struct p_ap_mld *mld)
+{
+	if (!mld)
+		return;
+
+	if (!mld->wds.initialized) {
+		dl_list_init(&mld->wds.wds_pending_assoc);
+		mld->wds.initialized = true;
+	}
+}
+
+void mxl_wds_deinit_pending_assoc(struct p_ap_mld *mld)
+{
+	struct mxl_ml_wds_entry *iter;
+
+	if (!mld)
+		return;
+
+	if (!mld->wds.initialized)
+		return;
+
+	while ((iter = dl_list_first(&mld->wds.wds_pending_assoc, struct mxl_ml_wds_entry,
+		list)) != NULL)
+	{
+		dl_list_del(&iter->list);
+		os_free(iter);
+	}
+}
