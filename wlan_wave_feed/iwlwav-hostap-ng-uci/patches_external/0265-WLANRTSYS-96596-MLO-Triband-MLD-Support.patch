++			ap_sta_deauthenticate(hapd, sta, reason);
+ #endif /* CONFIG_IEEE80211BE_MXL_MLO */
+-      else if (addr[0] == 0xff)
+-         hostapd_free_stas(hapd);
+-   }
++		else if (addr[0] == 0xff)
++			hostapd_free_stas(hapd);
++	}
+ #else /* CONFIG_VENDOR_MXL */
+ 	sta = ap_get_sta(hapd, addr);
+ 	if (os_strstr(txtaddr, " tx=0")) {
