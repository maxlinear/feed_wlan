+static bool mxl_mld_pre_setup_status(struct p_ap_mld *mld)
+{
+	u8 links_per_ap_mld = mld->affiliated_links[LINK1]->conf->mxl_bss_conf.links_per_ap_mld;
+	struct hostapd_data *aff_hapd = NULL;
+
+	for (int link = LINK1; link < links_per_ap_mld; link++) {
+		aff_hapd = mld->affiliated_links[link];
+		if (!aff_hapd) {
+			wpa_printf(MSG_ERROR, "MXL_MLO: No BSS at link index (%d) for AP MLD with MLD MAC = "MACSTR,
+				   link, MAC2STR(mld->ap_mld_mac));
+			return false;
+		}
+		if (!aff_hapd->iface->set_freq_done || aff_hapd->beacon_set_done) {
+			wpa_printf(MSG_ERROR, "MXL_MLO: affiliated link (%s) is not setup for AP MLD with MLD MAC = "MACSTR
+				   " set_freq_done=%d, beacon_set_done=%d",
+				   aff_hapd->conf->iface, MAC2STR(mld->ap_mld_mac),
+				   aff_hapd->iface->set_freq_done, aff_hapd->beacon_set_done);
+			return false;
+		}
+		/* If MLD has affliliated MBSSID link
+		 * Consider MLD Ready only when TX BSS in MBSSID has started beaconing
+		 */
+		if (aff_hapd->iconf->multibss_enable) {
+			struct hostapd_data *tx_hapd = mxl_hostapd_mbssid_get_tx_bss(aff_hapd);
+			if (!mxl_hostapd_is_mbssid_tx_bss(aff_hapd) && !tx_hapd->beacon_set_done) {
+				wpa_printf(MSG_ERROR, "MXL_MLO: Tx BSS (%s) has not started yet - cannot enable non-TX BSS",
+					   tx_hapd->conf->iface);
+				return false;
+			}
+		}
+	}
+	return true;
+}
