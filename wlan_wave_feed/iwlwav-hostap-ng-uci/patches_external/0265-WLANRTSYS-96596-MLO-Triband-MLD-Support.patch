+int mxl_mld_check_sibling_iface(struct hostapd_iface *iface)
+{
+	struct hostapd_iface *other_iface;
+
+	for (size_t idx = 0; idx < iface->interfaces->count; idx++) {
+		other_iface = iface->interfaces->iface[idx];
+		if (other_iface == iface)
+			continue;
+		if (other_iface->conf->multibss_enable && other_iface->mxl_iface.disabled_by_sibling) {
+			other_iface->mxl_iface.disabled_by_sibling = 0;
+			if (hostapd_enable_iface(other_iface)) {
+				wpa_printf(MSG_ERROR, "MXL_MLO: Failed to enable sibling iface %s",
+					other_iface->conf->bss[0]->iface);
+					return -1;
+			}
+			wpa_printf(MSG_DEBUG, "MXL_MLO: Enable iface %s - which was stopped by sibling",
+				other_iface->conf->bss[0]->iface);
+		}
+	}
+
+	return 0;
+}
+
+bool mxl_ml_is_multilink_mld(struct hostapd_data *hapd)
+{
+	struct p_ap_mld *mld = mxl_ml_get_ap_mld(hapd);
+
+	if(!mld)
+		return false;
+
+	return (mld->num_links > MLD_SINGLE_BAND_NUM_LINKS);
+}
+
+struct hostapd_data *mxl_ml_get_bss_by_link_id(struct hostapd_data *hapd, u8 link_id)
+{
+	struct p_ap_mld *mld = NULL;
+	struct hostapd_data *aff_hapd = NULL, *bss = NULL;
+	bool found = false;
+
+	if (!hapd || !mxl_is_mlo_enabled(hapd->conf))
+		return NULL;
+
+	if (!mxl_is_valid_link_id(link_id))
+		return NULL;
+
+	mld = mxl_ml_get_ap_mld(hapd);
+	if (!mld)
+		return NULL;
+
+	mxl_mld_for_each_affiliated_link(aff_hapd, mld) {
+		if (aff_hapd->conf->mxl_bss_conf.link_id == link_id) {
+			bss = aff_hapd;
+			found = true;
+			break;
+		}
+	}
+
+	if (!found)
+		wpa_printf(MSG_ERROR, "No bss found for link id (%u)", link_id);
+
+	return bss;
+}
+
+struct sta_info *mxl_ml_get_main_link_sta(struct sta_info *sta)
+{
+	struct sta_info *lsta = NULL, *main_link_sta = NULL;
+	u8 main_link_id;
+
+	if (!sta || !mxl_mlo_is_ml_sta(sta))
+		return NULL;
+
+	main_link_id = sta->mxl_sta_info.main_link_id;
+	if (!mxl_is_valid_link_id(main_link_id))
+		return NULL;
+
+	if (sta->mxl_sta_info.link_id == main_link_id)
+		return sta;
+
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		if (lsta->mxl_sta_info.link_id == main_link_id) {
+			main_link_sta = lsta;
+			break;
+		}
+	}
+
+	return main_link_sta;
+}
+
+struct p_ap_mld *mxl_ml_get_ap_mld(struct hostapd_data *hapd)
+{
+	struct p_ap_mld *mld = NULL;
+	u8 mld_id = INVALID_MLD_ID;
+
+	if (!hapd || !mxl_is_mlo_enabled(hapd->conf))
+		return NULL;
+
+	mld_id = hapd->conf->mld_id;
+
+	if (!mxl_mlo_is_valid_mld_id(mld_id))
+		return NULL;
+
+	mld = &(hapd->iface->interfaces->mxl_interfaces.g_ap_mld[mld_id]);
+
+	return mld;
+}
+
+int mxl_ml_switch_to_main_link_context(struct hostapd_data **hapd, 
+								   struct sta_info **sta)
+{
+	struct hostapd_data *main_bss = NULL;
+	struct sta_info *main_link_sta = NULL;
+	u8 main_link_id;
+
+	if (!hapd || !*hapd || !sta || !*sta)
+		return -1;
+
+	/* Check if this is an ML STA */
+	if (!mxl_mlo_is_ml_sta(*sta))
+		return 0; /* No switch needed */
+	
+	/* Check if we're already on the main link */
+	if ((*hapd)->conf->mxl_bss_conf.link_id == (*sta)->mxl_sta_info.main_link_id)
+		return 0; /* Already on main link */
+
+	/* Get main link context */
+	main_link_id = (*sta)->mxl_sta_info.main_link_id;
+	main_link_sta = mxl_ml_get_main_link_sta(*sta);
+	main_bss = mxl_ml_get_bss_by_link_id(*hapd, main_link_id);
+
+	if (main_link_sta && main_bss) {
+		/* Switch to main link context */
+		*sta = main_link_sta;
+		*hapd = main_bss;
+		wpa_printf(MSG_DEBUG, "MXL_MLO: Switched to main link context (link_id=%u)", 
+			   main_link_id);
+		return 0;
+	} else {
+		wpa_printf(MSG_DEBUG, "MXL_MLO: Can't find main link STA or BSS for link_id=%u",
+			   main_link_id);
+		return -1;
+	}
+}
+
+u8 mxl_ml_get_num_of_sim_links(struct hostapd_data *hapd)
+{
+	struct p_ap_mld *mld = NULL;
+	struct hostapd_data *sib_hapd = NULL;
+	u8 num_of_sim_links = MLD_AUTO_NUM_SIMUL_LINKS;
+
+	if (!hapd)
+		return 0;
+
+	mld = mxl_ml_get_ap_mld(hapd);
+	if (!mld)
+		return 0;
+
+	num_of_sim_links = hapd->conf->mxl_bss_conf.mld_num_simul_links;
+
+	/* Validate that all links have the same mld_num_simul_links 
+	 * otherwise fallback using automanaged value
+	 */
+	mxl_mld_for_each_sibling_link(sib_hapd, hapd) {
+		if (num_of_sim_links != sib_hapd->conf->mxl_bss_conf.mld_num_simul_links) {
+			wpa_printf(MSG_ERROR,
+				   "MXL_MLO: Failed to use custom value - use auto managed value");
+			return (mld->num_links - 1);
+		}
+	}
+
+	/* When auto managed - number of simultaneous links is total links - 1 */
+	return (num_of_sim_links == MLD_AUTO_NUM_SIMUL_LINKS ? mld->num_links - 1 : num_of_sim_links);
+}
+
+void mxl_ml_store_mld_config(struct hostapd_data *hapd, struct hostapd_config *oldconf,
+					   struct mxl_ml_mld_config *mld_config)
+{
+	/* Reset before using it */
+	mld_config->mld_id = INVALID_MLD_ID;
+	mld_config->link_id = INVALID_LINK_ID;
+	mld_config->add_ml_ie = false;
+
+	/* Store mlo supported for MLD and non-MLD BSS */
+	hapd->iconf->mxl_conf.mlo_supported = oldconf->mxl_conf.mlo_supported;
+
+	if (!mxl_is_mlo_enabled(hapd->conf))
+		return;
+
+	mld_config->mld_id = hapd->conf->mld_id;
+	mld_config->link_id = hapd->conf->mxl_bss_conf.link_id;
+	mld_config->add_ml_ie = hapd->conf->mxl_bss_conf.ml_ie_add;
+}
+
+void mxl_ml_restore_mld_config(struct hostapd_data *hapd, struct mxl_ml_mld_config *mld_config)
+{
+	struct p_ap_mld *mld = NULL;
+
+	if (!mxl_is_mlo_enabled(hapd->conf))
+		return;
+
+	hapd->conf->mld_id = mld_config->mld_id;
+	hapd->conf->mxl_bss_conf.link_id = mld_config->link_id;
+
+	mld = mxl_ml_get_ap_mld(hapd);
+	if (mld && mxl_hostapd_verify_mld_config(mld)) {
+		hapd->conf->mxl_bss_conf.ml_ie_add = mld_config->add_ml_ie;
+		wpa_printf(MSG_DEBUG, "MXL_MLO: %s ml_ie_add restored to %d",
+			   hapd->conf->iface, hapd->conf->mxl_bss_conf.ml_ie_add);
+	}
+}
+
+void mxl_ml_iface_disabled(struct hostapd_data *hapd)
+{
+	struct p_ap_mld *mld = mxl_ml_get_ap_mld(hapd);
+
+	if (!mld)
+		return;
+	
+	if (mld->mld_added) {
+		mld->mld_added = false;
+		wpa_printf(MSG_DEBUG, "MXL_MLO: %s MLD removed by driver - reset mld added status",
+			   hapd->conf->iface);
+	}
+}
+
+bool mxl_ml_is_last_link_in_mld(struct hostapd_data *hapd)
+{
+	struct p_ap_mld *mld = mxl_ml_get_ap_mld(hapd);
+	struct hostapd_data *aff_hapd = NULL;
+
+	if (!mld)
+		return false;
+	
+	mxl_mld_for_each_affiliated_link(aff_hapd, mld) {
+		if (aff_hapd == hapd)
+			return (mld->num_links == 1);
+	}
+
+	return false;
+}
+
+static void mxl_ml_remove_affiliated_link(struct p_ap_mld *mld, struct hostapd_data *hapd)
+{
+	struct hostapd_data *aff_hapd = NULL;
+
+	/* Clear explicitly disabled link from affiliated links list */
+	for (int aff_link = LINK1; aff_link < mld->num_links; aff_link++) {
+		aff_hapd = mld->affiliated_links[aff_link];
+		if (aff_hapd == hapd) {
+			/* Remove the selected affiliated link from MLD affiliated links */
+			for (int link = aff_link; link < mld->num_links - 1; link++) {
+				mld->affiliated_links[link] = mld->affiliated_links[link + 1];
+			}
+			mld->affiliated_links[mld->num_links - 1] = NULL;
+			mld->num_links--;
+			break;
+		}
+	}
+}
+
+int mxl_ml_deinit_link(struct hostapd_data *hapd)
+{
+	struct p_ap_mld *mld;
+	struct hostapd_data *sib_hapd = NULL;
+
+	if (!hapd)
+		return -1;
+
+	mld = mxl_ml_get_ap_mld(hapd);
+	if (!mld) {
+		return -1;
+	}
+
+	/* Send destroy MLD */
+	mxl_hostapd_remove_mld(mld);
+	mxl_mld_for_each_sibling_link(sib_hapd, hapd) {
+		hostapd_bss_deinit_no_free(sib_hapd);
+	}
+	/* De-init of any affiliated link of MLD will disable all the links */
+	mxl_mlo_sibling_links_delete(hapd);
+
+	mxl_ml_remove_affiliated_link(mld, hapd);
+
+	hapd->mxl_data.removed_by_sibling = false;
+	mxl_hostapd_deinit_mld_params(hapd);
+
+	return 0;
+}
+
+int mxl_ml_deinit_link_free(struct hostapd_data *hapd)
+{
+	struct p_ap_mld *mld;
+
+	if (!hapd)
+		return -1;
+
+	mld = mxl_ml_get_ap_mld(hapd);
+	if (!mld) {
+		return -1;
+	}
+
+	/* Send destroy MLD */
+	mxl_hostapd_remove_mld(mld);
+	mxl_ml_remove_affiliated_link(mld, hapd);
+	hapd->mxl_data.removed_by_sibling = false;
+	mxl_hostapd_deinit_mld_params(hapd);
+
+	return 0;
+}
