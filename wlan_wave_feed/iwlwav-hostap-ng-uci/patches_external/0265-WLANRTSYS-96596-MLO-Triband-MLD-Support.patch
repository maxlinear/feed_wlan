+int mxl_ap_sta_deauth(struct hostapd_data *hapd, struct sta_info *sta, u16 reason)
+{
+	struct hostapd_data *lhapd = NULL;
+	struct sta_info *lsta = NULL;
+	u8 link_id;
+
+	if (!hapd || !sta)
+		return -1;
+
+	if (mxl_mlo_is_ml_sta(sta)) {
+		mxl_mld_for_each_sibling_sta(lsta, sta) {
+			link_id = lsta->mxl_sta_info.link_id;
+			lhapd = mxl_ml_get_bss_by_link_id(hapd, link_id);
+			if (!lhapd) {
+				mxl_mld_log_no_sibling_bss(link_id);
+				continue;
+			}
+			ap_sta_deauthenticate(lhapd, lsta, reason);
+		}
+	}
+
+	ap_sta_deauthenticate(hapd, sta, reason);
+
+	return 0;
+}
