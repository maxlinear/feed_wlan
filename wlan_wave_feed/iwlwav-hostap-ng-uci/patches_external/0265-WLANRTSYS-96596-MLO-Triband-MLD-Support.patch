+int mxl_ml_build_per_sta_assoc_resp(struct hostapd_data *hapd, struct sta_info *sta)
+{
+	struct sta_info *lsta = NULL;
+	struct hostapd_data *lhapd = NULL;
+	u8 link_id;
+
+	if (!mxl_is_mlo_enabled(hapd->conf))
+		return 0;
+
+	if (sta->mxl_sta_info.resp_per_sta_profile) {
+		os_free(sta->mxl_sta_info.resp_per_sta_profile);
+	}
+	sta->mxl_sta_info.resp_per_sta_profile = NULL;
+	sta->mxl_sta_info.resp_per_sta_profile_len = 0;
+
+	/* Allocate per sta resp only for sibling links */
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		if (lsta->mxl_sta_info.resp_per_sta_profile) {
+			os_free(lsta->mxl_sta_info.resp_per_sta_profile);
+		}
+		lsta->mxl_sta_info.resp_per_sta_profile = NULL;
+		lsta->mxl_sta_info.resp_per_sta_profile_len = 0;
+		link_id = lsta->mxl_sta_info.link_id;
+		lhapd = mxl_ml_get_bss_by_link_id(hapd, link_id);
+		if (!lhapd) {
+			mxl_mld_log_no_sibling_bss(link_id);
+			continue;
+		}
+		lsta->mxl_sta_info.resp_per_sta_profile = mxl_ml_build_persta_capab_assoc(lhapd,
+				lsta, &lsta->mxl_sta_info.resp_per_sta_profile_len);
+	}
+
+	return 0;
