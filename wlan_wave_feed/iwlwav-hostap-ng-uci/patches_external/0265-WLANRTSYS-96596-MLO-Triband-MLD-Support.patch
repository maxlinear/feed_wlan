+u8 * mxl_ml_eid_multilink_assoc(struct hostapd_data *hapd, struct sta_info *sta, u8 *eid)
+{
+	struct hostapd_data *lhapd;
+	struct sta_info *lsta;
+	struct wpabuf *buf;
+	u8 *pos = eid;
+	const u8 *ptr;
+	size_t len, slice_len;
+	u8 link_id;
+	u8 common_info_len;
+	u16 control = 0;
+	u16 msd_info = 0;
+	u16 eml_capab = 0;
+	u16 mld_capab = 0;
+	u8 mld_num_simul_links = mxl_ml_get_num_of_sim_links(hapd);
+	bool mld_mediumsync_present = hapd->conf->mxl_bss_conf.mld_mediumsync_present;
+	u8 bpcc = hapd->conf->mxl_bss_conf.mld_bpcc_count;
+
+	size_t sta_info_len = 0;
+	size_t total_len = 0;
+	u8 *per_sta_cap = NULL;
+	size_t per_sta_cap_len = 0;
+	u16 sta_ctrl = 0;
+	u64 tsf = 0;
+
+	/*
+	 * As the Multi-Link element can exceed the size of 255 bytes need to
+	 * first build it and then handle fragmentation.
+	 */
+	buf = wpabuf_alloc(EHT_ML_MAX_STA_PROF_LEN);
+	if (!buf)
+		return pos;
+
+	/* Multi-Link Control field */
+	control |= MULTI_LINK_CONTROL_TYPE_BASIC;
+	control |= (MLO_LINK_ID_INFO_PRESENT |
+		MLO_BSS_PARAM_CHANGE_COUNT_PRESENT |
+		MLO_MLD_CAPAB_PRESENT);
+	control |= MLO_EML_CAPAB_PRESENT;
+	if (mld_mediumsync_present)
+		control |= MLO_MSDI_PRESENT;
+
+	/* Set the basic Multi-Link common information */
+	common_info_len = COMMON_INFO_LEN;
+
+	if (mld_mediumsync_present)
+		common_info_len += MULTILINK_MSD_LEN;
+
+	wpabuf_put_le16(buf, control);
+
+	wpabuf_put_u8(buf, common_info_len);
+
+	/* MLD MAC Address */
+	wpabuf_put_data(buf, hapd->conf->mxl_bss_conf.ap_mld_mac, ETH_ALEN);
+
+	/* Link ID */
+	wpabuf_put_u8(buf, hapd->conf->mxl_bss_conf.link_id);
+
+	wpabuf_put_u8(buf, bpcc);
+
+	if (mld_mediumsync_present) {
+		msd_info = hapd->conf->mxl_bss_conf.mld_mediumsync_duration;
+		msd_info |= hapd->conf->mxl_bss_conf.mld_mediumsync_ofdmedthresh << MLO_MEDIUM_SYNC_OFDMED_THRESH_START_POSITION;
+		msd_info |= hapd->conf->mxl_bss_conf.mld_mediumsync_maxtxop << MLO_MEDIUM_SYNC_MAX_TXOP_START_POSITION;
+		wpabuf_put_le16(buf, msd_info);
+	}
+
+	/* Fill EML Capab */
+	if (hapd->iconf->mxl_conf.mlo_supported == MULTILINK_EMLSR)
+		eml_capab |= MLO_EMLSR;
+	else if (hapd->iconf->mxl_conf.mlo_supported == MULTILINK_EMLMR)
+		eml_capab |= MLO_EMLMR;
+	eml_capab |= hapd->conf->mxl_bss_conf.eml_transition_timeout << MLO_TRANSITION_TIMEOUT_MASK;
+	wpabuf_put_le16(buf, eml_capab);
+
+	/* Fill MLD Capab */
+	mld_capab |= mld_num_simul_links;
+	if (hapd->conf->mxl_bss_conf.mlo_t2lm_support)
+		mld_capab |= MLO_T2LM_NEGOTIATION_SUPPORT_MAP_ALL_TID_TO_SAME_LINK;
+	wpabuf_put_le16(buf, mld_capab);
+
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		link_id = lsta->mxl_sta_info.link_id;
+		lhapd = mxl_ml_get_bss_by_link_id(hapd, link_id);
+		if (!lhapd) {
+			wpa_printf(MSG_ERROR,
+				   "MXL MLO: Couldn't find link BSS for link id %d - skip it",
+				   link_id);
+			continue;
+		}
+
+		per_sta_cap = lsta->mxl_sta_info.resp_per_sta_profile;
+		per_sta_cap_len = lsta->mxl_sta_info.resp_per_sta_profile_len;
+	
+		/* Prepare next per-Sta info */
+		sta_info_len = LINK_INFO_STA_CTRL_LEN + ML_PER_STA_INFO_LEN;
+		total_len = 0;
+		sta_ctrl = 0;
+		tsf = 0;
+
+		/* Prepare per-STA Profile subelement length */
+		total_len = sta_info_len + per_sta_cap_len;
+
+		/* Per-STA Profile subelement */
+		wpabuf_put_u8(buf, WLAN_EID_SUBELEMENT_MLO_PER_STA_PROFILE);
+
+		if (total_len <= 255)
+			wpabuf_put_u8(buf, total_len);
+		else
+			wpabuf_put_u8(buf, 255);
+
+		/* STA Control */
+		sta_ctrl |= (lhapd->conf->mxl_bss_conf.link_id | MLO_LINK_INFO_COMPLETE_PROFILE |
+			MLO_LINK_INFO_MACADDR_PRESENT | MLO_LINK_INFO_BI_PRESENT |
+			MLO_LINK_INFO_TSF_OFFSET_PRESENT | MLO_LINK_INFO_DTIM_INFO_PRESENT |
+			MLO_LINK_INFO_BSS_PARAM_CHANGE_CNT_PRESENT);
+
+		wpabuf_put_le16(buf, sta_ctrl);
+
+		/* STA Info */
+		wpabuf_put_u8(buf, ML_PER_STA_INFO_LEN);
+		wpabuf_put_data(buf, lhapd->own_addr, ETH_ALEN);
+		wpabuf_put_le16(buf, lhapd->iconf->beacon_int);
+#ifdef CONFIG_WIFI_CERTIFICATION
+		if((hapd->iface->current_mode->mode == HOSTAPD_MODE_IEEE80211B ||
+				 hapd->iface->current_mode->mode == HOSTAPD_MODE_IEEE80211G) ||
+				 (lhapd->iface->current_mode->mode == HOSTAPD_MODE_IEEE80211B ||
+				  lhapd->iface->current_mode->mode == HOSTAPD_MODE_IEEE80211G))
+			tsf = hapd->iconf->mxl_conf.eht_mld_tsf_diff;
+#endif /* CONFIG_WIFI_CERTIFICATION */
+		wpabuf_put_le64(buf, tsf);
+		wpabuf_put_u8(buf, 0); /* DTIM Count */
+		wpabuf_put_u8(buf, lhapd->conf->dtim_period);
+		/* Param change count */
+		wpabuf_put_u8(buf, 0);
+
+		if (!per_sta_cap)
+			continue;
+
+		/* Fragment the sub element if needed */
+		if (total_len <= 255) {
+			wpabuf_put_data(buf, per_sta_cap,
+					per_sta_cap_len);
+		} else {
+			ptr = per_sta_cap;
+			len = per_sta_cap_len;
+
+			slice_len = 255 - sta_info_len;
+
+			wpabuf_put_data(buf, ptr, slice_len);
+			len -= slice_len;
+			ptr += slice_len;
+
+			while (len) {
+				if (len <= 255)
+					slice_len = len;
+				else
+					slice_len = 255;
+
+				wpabuf_put_u8(buf, EHT_ML_SUB_ELEM_FRAGMENT);
+				wpabuf_put_u8(buf, slice_len);
+				wpabuf_put_data(buf, ptr, slice_len);
+
+				len -= slice_len;
+				ptr += slice_len;
+			}
+		}
+	}
+
+	/* Fragment the Multi-Link element, if needed */
+	len = wpabuf_len(buf);
+	ptr = wpabuf_head(buf);
+
+	if (len <= 254)
+		slice_len = len;
+	else
+		slice_len = 254;
+
+	*pos++ = WLAN_EID_EXTENSION;
+	*pos++ = slice_len + 1;
+	*pos++ = WLAN_EID_EXT_MULTI_LINK;
+	os_memcpy(pos, ptr, slice_len);
+
+	ptr += slice_len;
+	pos += slice_len;
+	len -= slice_len;
+
+	while (len) {
+		if (len <= 255)
+			slice_len = len;
+		else
+			slice_len = 255;
+
+		*pos++ = WLAN_EID_FRAGMENT;
+		*pos++ = slice_len;
+		os_memcpy(pos, ptr, slice_len);
+
+		ptr += slice_len;
+		pos += slice_len;
+		len -= slice_len;
+	}
+
+	wpabuf_free(buf);
+	return pos;
+}
