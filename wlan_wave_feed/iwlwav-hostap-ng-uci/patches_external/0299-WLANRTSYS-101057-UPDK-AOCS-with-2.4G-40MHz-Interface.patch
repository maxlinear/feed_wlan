+#include "utils/includes.h"
+#include "utils/common.h"
+#include "hostapd.h"
+#include "ap_config.h"
+#include "mxl_hw_features.h"
+
+
+/* Fixed-channel 2.4GHz HT40: validate center segment index and
+ * correct it if it does not match primary channel + secondary offset.
+ * Do not modify secondary_channel in this path.
+ */
+void mxl_check_2G_HT_channel_segment_idx(struct hostapd_iface *iface)
+{
+	int expected_seg0 = 0;
+	u8 curr_seg0 = 0;
+
+	if (!iface || !iface->conf)
+		return;
+
+	if (!iface->conf->acs &&
+			iface->freq >= 2412 && iface->freq <= 2472 &&
+			iface->conf->secondary_channel) {
+
+		/* calculate expected seg0 */
+		expected_seg0 = iface->conf->channel + iface->conf->secondary_channel * 2;
+
+		/* Get the current seg0 idx */
+		curr_seg0 = hostapd_get_oper_centr_freq_seg0_idx(iface->conf);
+
+		/* Validate the seg0 idx & adjust it */
+		if (expected_seg0 >= 1 && expected_seg0 <= 13 &&
+				curr_seg0 != expected_seg0) {
+			wpa_printf(MSG_INFO,
+					"2.4GHz HT40: Correcting center_segment0 from %u to %d (channel=%d sec_offset=%d)",
+					curr_seg0, expected_seg0, iface->conf->channel, iface->conf->secondary_channel);
+			hostapd_set_oper_centr_freq_seg0_idx(iface->conf,
+					expected_seg0);
+		}	
+	}
+	return;
+}
