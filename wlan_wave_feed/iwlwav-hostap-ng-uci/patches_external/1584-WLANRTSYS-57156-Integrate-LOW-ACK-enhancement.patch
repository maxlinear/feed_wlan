From 65d23b4302993ae41f18e395ff5899644941b0a2 Mon Sep 17 00:00:00 2001
From: Jurijs Soloveckis <jsoloveckis@maxlinear.com>
Date: Mon, 24 Jul 2023 15:27:38 +0200
Subject: [PATCH] WLANRTSYS-57156: Integrate LOW ACK enhancement

---
 src/ap/drv_callbacks.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/ap/drv_callbacks.c b/src/ap/drv_callbacks.c
index 5f0a44abc..a5f1093d0 100644
--- a/src/ap/drv_callbacks.c
+++ b/src/ap/drv_callbacks.c
@@ -1102,7 +1102,21 @@ legacy:
 
 void hostapd_event_sta_low_ack(struct hostapd_data *hapd, const u8 *addr)
 {
+#ifndef CONFIG_VENDOR_MXL
 	struct sta_info *sta = ap_get_sta(hapd, addr);
+#else /* CONFIG_VENDOR_MXL */
+	struct sta_info *sta = NULL;
+	struct hostapd_iface *iface = hapd->iface;
+	size_t i;
+
+	for (i = 0; i < iface->num_bss; i++) {
+		sta = ap_get_sta(iface->bss[i], addr);
+		if (sta) {
+			hapd = iface->bss[i];
+			break;
+		}
+	}
+#endif /* CONFIG_VENDOR_MXL */
 #ifdef CONFIG_IEEE80211BE
 	struct hostapd_data *orig_hapd = hapd;
 
