+#if defined(CONFIG_SCS_MXL) || defined(CONFIG_MSCS_MXL)
+int mxl_parse_mac_str_to_hex(const char *s, u8 mac[ETH_ALEN])
+{
+	unsigned int o[ETH_ALEN];
+	if (sscanf(s, "%02x:%02x:%02x:%02x:%02x:%02x",
+				&o[0], &o[1], &o[2], &o[3], &o[4], &o[5]) != 6)
+		return -1;
+	for (int i = 0; i < ETH_ALEN; i++)
+		mac[i] = (u8) o[i];
+	return 0;
+}
+
+static int mxl_hostapd_parse_qos_deny_mac_list(struct mxl_qos_deny_list **qos_head, char *mac_list)
+{
+	u8 sta_mac[ETH_ALEN];
+	struct mxl_qos_deny_list *qos_free = *qos_head, *tmp = NULL;
+	char *saveptr = NULL, *mac = NULL;
+	char *tok = strtok_r(mac_list, " ", &saveptr);
+
+	while (qos_free) {
+		tmp = qos_free->next;
+		os_free(qos_free);
+		qos_free = tmp;
+	}
+	*qos_head = NULL;
+
+	if (!tok) {
+		wpa_printf(MSG_DEBUG, "(M)SCS DENY MAC list empty");
+		return 0;
+	}
+
+	while (tok) {
+		mac = tok;
+		if (mac[0] != '\0') {
+			if (mxl_parse_mac_str_to_hex(mac, sta_mac) != 0) {
+				wpa_printf(MSG_DEBUG, "(M)SCS DENY MAC Invalid MAC entry");
+				return 0;
+			}
+
+			struct mxl_qos_deny_list *new = (struct mxl_qos_deny_list *)os_malloc(sizeof(struct mxl_qos_deny_list));
+			if (!new) {
+				return 0;
+			}
+			new->next = NULL;
+			os_memcpy(new->mxl_qos_deny_mac, sta_mac, ETH_ALEN);
+
+			if(!tmp)
+				tmp = new;
+			else {
+				new->next = tmp;
+				tmp = new;
+			}
+		}
+		tok = strtok_r(NULL, " ", &saveptr);
+	}
+
+	*qos_head = tmp;
+
+	return 0;
+}
+
+int mxl_config_check_qos_deny_list(struct hostapd_config *conf, const char *buf, char* pos)
+{
+	struct mxl_hostapd_config *mxl_conf = &conf->mxl_conf;
+	if (os_strcmp(buf, "scs_deny_mac") == 0) {
+#ifdef CONFIG_SCS_MXL
+		mxl_hostapd_parse_qos_deny_mac_list(&mxl_conf->scs_deny, pos);
+#endif /* CONFIG_SCS_MXL */
+	}
+	else if (os_strcmp(buf, "mscs_deny_mac") == 0) {
+#ifdef CONFIG_MSCS_MXL
+		mxl_hostapd_parse_qos_deny_mac_list(&mxl_conf->mscs_deny, pos);
+#endif /* CONFIG_MSCS_MXL */
+	}
+	else {
+		return 0;
+	}
+
+	return 1;
+}
+
+void mxl_hostapd_config_free_qos_deny_list(struct hostapd_config *conf)
+{
+	struct mxl_hostapd_config *mxl_conf = &conf->mxl_conf;
+	struct mxl_qos_deny_list *tmp = NULL;
+
+#ifdef CONFIG_SCS_MXL
+	if (mxl_conf->scs_deny) {
+		tmp = mxl_conf->scs_deny;
+		while (tmp) {
+			mxl_conf->scs_deny = tmp->next;
+			os_free(tmp);
+			tmp = mxl_conf->scs_deny;
+		}
+		mxl_conf->scs_deny = NULL;
+	}
+#endif /* CONFIG_SCS_MXL */
+
+#ifdef CONFIG_MSCS_MXL
+	if (mxl_conf->mscs_deny) {
+		tmp = mxl_conf->mscs_deny;
+		while (tmp) {
+			mxl_conf->mscs_deny = tmp->next;
+			os_free(tmp);
+			tmp = mxl_conf->mscs_deny;
+		}
+		mxl_conf->mscs_deny = NULL;
+	}
+#endif /* CONFIG_MSCS_MXL */
+	return;
+}
