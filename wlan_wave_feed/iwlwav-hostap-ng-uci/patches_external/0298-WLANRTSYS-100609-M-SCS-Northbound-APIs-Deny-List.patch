+/*
+ * mxl_northbound_scs_add_req
+ * Parses SCS request from northbound API and stores a copy in scs_data_entry
+ * as well as calls handle_scs_req to add to driver.
+ *
+ * mac_str : mac address of station in string format 
+ * scsId   : scsId of the rule to be added
+ * hex_str : scs req in hex format
+ * returns : one - success and zero - failure.
+ */
+int mxl_northbound_scs_add_req(struct hostapd_data *hapd, char *mac_str, unsigned int scsId, char *hex_str)
+{
+	int res = 0;
+	u8 mac[ETH_ALEN] = {'\0'};
+	u8 *mgmt_buf = NULL;
+	size_t mgmt_len = 0;
+	const struct ieee80211_mgmt *mgmt = NULL;
+	struct mxl_scs_entry *ref_entry = hapd->mxl_data.scs_entry_list; 
+	struct mxl_scs_entry *new_entry = NULL;
+
+	if (mxl_parse_mac_str_to_hex(mac_str, mac) != 0) {
+		wpa_printf(MSG_ERROR, "ERR: invalid STA_MAC\n");
+		return res;
+	}
+
+	if (mxl_convert_hex_to_bytes(hex_str, &mgmt_buf, &mgmt_len)) {
+		wpa_printf(MSG_ERROR, "ERR: invalid hexstream\n");
+		return res;
+	}
+
+	/* typecast to mgmt structure */
+	mgmt = (const struct ieee80211_mgmt *) mgmt_buf;
+
+	new_entry = (struct mxl_scs_entry *)os_malloc(sizeof(struct mxl_scs_entry));
+	if (!new_entry) {
+		wpa_printf(MSG_ERROR, "Memory allocation issue in SCS store");
+		os_free(mgmt_buf);
+		return res;
+	}
+
+	/* Avoid redundancy in SCS req */
+	if (!mxl_scs_remove_entry(hapd, mac, scsId)) {
+		wpa_printf(MSG_DEBUG, "No existing SCS entry before updating");
+	}
+
+	/* Copy params to scs list */
+	new_entry->scsId = scsId;
+	os_memcpy(new_entry->sta_mac, mac, ETH_ALEN);
+	new_entry->mgmt_bytes = os_malloc(mgmt_len);
+	if (!new_entry->mgmt_bytes) { 
+		wpa_printf(MSG_ERROR, "Memory allocation issue in SCS store");
+		os_free(new_entry);
+		os_free(mgmt_buf);
+		return res;
+	}
+	os_memcpy(new_entry->mgmt_bytes, mgmt, mgmt_len);
+	new_entry->mgmt_len = mgmt_len;
+	new_entry->next = NULL;
+	res = 1;
+
+	/* preserve scs list nodes */
+	if(!ref_entry)
+		ref_entry = new_entry;
+	else {
+		new_entry->next = ref_entry;
+		ref_entry = new_entry;
+	}
+
+	hapd->mxl_data.scs_entry_list = ref_entry;
+	/* scs add request hook to driver */
+	mxl_handle_scs_req(hapd, mgmt, mgmt_len, true);
+
+	return res;
 }
