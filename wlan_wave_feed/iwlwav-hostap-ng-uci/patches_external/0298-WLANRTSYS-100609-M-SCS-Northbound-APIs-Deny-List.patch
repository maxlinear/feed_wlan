+			os_free(ref_entry->mgmt_bytes);
+			os_free(ref_entry);
+			/* reset the node to continue through the list */
+			if (prev_entry)
+				ref_entry = prev_entry->next;
+			else {
+				ref_entry = hapd->mxl_data.mscs_entry_list;
+			}
+			match = 1;
+			res++;
+		}
+		if (!match) {
+			prev_entry = ref_entry;
+			ref_entry = ref_entry->next;
+		}
+	}
+
+	/* mscs remove request hook to driver */
+	mxl_mscs_remove_req(hapd, mac, 0);
+
+	return res;
+}
+
+/*
+ * mxl_northbound_mscs_add_req
+ * Parses MSCS request from northbound API and stores a copy in mscs_data_entry
+ * as well as calls handle_mscs_req to add to driver.
+ *
+ * mac_str : mac address of station in string format 
+ * hex_str : mscs req in hex format
+ * returns : one - success and zero - failure.
+ */
+int mxl_northbound_mscs_add_req(struct hostapd_data *hapd, char *mac_str, char *hex_str)
+{
+	int res = 0;
+	u8 mac[ETH_ALEN] = {'\0'};
+	u8 *mgmt_buf = NULL;
+	size_t mgmt_len = 0;
+	const struct ieee80211_mgmt *mgmt = NULL;
+	struct mxl_mscs_entry *ref_entry = hapd->mxl_data.mscs_entry_list; 
+	struct mxl_mscs_entry *new_entry = NULL;
+
+	if (mxl_parse_mac_str_to_hex(mac_str, mac) != 0) {
+		wpa_printf(MSG_ERROR, "ERR: invalid STA_MAC\n");
+		return res;
+	}
+
+	if (mxl_convert_hex_to_bytes(hex_str, &mgmt_buf, &mgmt_len)) {
+		wpa_printf(MSG_ERROR, "ERR: invalid hexstream\n");
+		return res;
+	}
+
+	/* typecast to mgmt structure */
+	mgmt = (const struct ieee80211_mgmt *) mgmt_buf;
+
+	/* store mgmt in mscs_entry_list */
+	new_entry = (struct mxl_mscs_entry *)os_malloc(sizeof(struct mxl_mscs_entry));
+	if (!new_entry) {
+		wpa_printf(MSG_ERROR, "Memory allocation issue in MSCS store");
+		os_free(mgmt_buf);
+		return res;
+	}
+
+	/*TODO : Decide whether MSCS req has to checked fore redundnacy */
+	/* Copy params to mscs list */
+	os_memcpy(new_entry->sta_mac, mac, ETH_ALEN);
+	new_entry->mgmt_bytes = os_malloc(mgmt_len);
+	if (!new_entry->mgmt_bytes) { 
+		wpa_printf(MSG_ERROR, "Memory allocation issue in MSCS store");
+		os_free(mgmt_buf);
+		os_free(new_entry);
+		return res;
+	}
+	os_memcpy(new_entry->mgmt_bytes, mgmt, mgmt_len);
+	new_entry->mgmt_len = mgmt_len;
+	new_entry->next = NULL;
+	res = 1;
+
+	/* preserve mscs list nodes */
+	if(!ref_entry)
+		ref_entry = new_entry;
+	else {
+		new_entry->next = ref_entry;
+		ref_entry = new_entry;
+	}
+
+	hapd->mxl_data.mscs_entry_list = ref_entry;
+	/* mscs add request hook to driver */
+	mxl_handle_mscs_req(hapd, mgmt, mgmt_len, true);
+
+	return res;
+}
 #endif /* CONFIG_MSCS_MXL */
 
