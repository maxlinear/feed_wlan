+/*
+ * mxl_northbound_scs_list_req
+ * get SCS rule from scs_data_entry list and store to buf
+ *
+ * hapd         : ref to hapd instance
+ * scs_list_buf : store list entries
+ * returns      : one - success and zero - failure or empty.
+ */
+int mxl_northbound_scs_list_rule(struct hostapd_data *hapd, char *scs_list_buf)
+{
+	int res = 0;
+	size_t len = 0;
+	int offset = 0, written = 0;
+	char mac_str[18] = {'\0'};
+	struct mxl_scs_entry *ref_entry = NULL;
+
+	ref_entry = hapd->mxl_data.scs_entry_list;
+	if (!ref_entry)
+		return res;
+	else
+		res = 1;
+
+	/* logic to loop through each entry and store data in buf */
+	len = QOS_BUFFER_MAX;
+	while (ref_entry) {
+		if ((offset + 21) < len) {
+			mxl_parse_mac_hex_to_str(ref_entry->sta_mac, mac_str);
+			written = snprintf(scs_list_buf + offset, len - offset,
+					"%u %s\n",ref_entry->scsId, mac_str);
+
+			if (written > 0 && offset + written < len) {
+				offset += written;
+			}
+		}
+		else {
+			wpa_printf(MSG_ERROR, "Buffer size exceeds for SCS rule listing");
+			break;
+		}
+		ref_entry = ref_entry->next;
+	}
+
+	return res;
+}
+
+/*
+ * mxl_scs_remove_entry
+ * Remove SCS rule from northbound API in scs_data_entry list
+ *
+ * hapd     : ref to hapd instance
+ * sta_mac  : mac address of station
+ * scsId    : scsId of the rule to be added
+ * returns  : one - success and zero - failure.
+ */
+int mxl_scs_remove_entry(struct hostapd_data *hapd, const u8 sta_mac[ETH_ALEN], unsigned int scsId)
+{
+	int res = 0;
+	struct mxl_scs_entry *ref_entry = hapd->mxl_data.scs_entry_list; 
+	struct mxl_scs_entry *prev_entry = NULL;
+
+	/* logic to remove entry on matching scs and sta mac */
+	while (ref_entry) {
+		if (os_memcmp(ref_entry->sta_mac, sta_mac, ETH_ALEN) == 0 && 
+			ref_entry->scsId == scsId) {
+
+			if (prev_entry) {
+				prev_entry->next = ref_entry->next;
+			}
+			else {
+				hapd->mxl_data.scs_entry_list = ref_entry->next;
+			}
+
+			os_free(ref_entry->mgmt_bytes);
+			os_free(ref_entry);
+			res = 1;
+			break;
+		}
+		prev_entry = ref_entry;
+		ref_entry = ref_entry->next;
+	}
+
+	return res;
+}
+
+/*
+ * mxl_northbound_scs_remove_req
+ * SCS remove request from northbound API is handled where copy in scs_data_entry
+ * is removed and  handle_scs_req to remove rule from driver.
+ *
+ * mac_str : mac address of station in string format 
+ * scsId   : scsId of the rule to be removed
+ * returns : one - success and zero - failure.
+ */
+int mxl_northbound_scs_remove_req(struct hostapd_data *hapd, char *mac_str, unsigned int scsId)
+{
+	int res = 0;
+	u8 mac[ETH_ALEN] = {'\0'};
+
+	if (mxl_parse_mac_str_to_hex(mac_str, mac) != 0) {
+		wpa_printf(MSG_ERROR, "ERR: invalid STA_MAC\n");
+		return res;
+	}
+
+	/* remove scs entry from mxl_scs_entry list */
+	res = mxl_scs_remove_entry(hapd, mac, scsId);
+	if (!res) {
+		wpa_printf(MSG_ERROR, "ERR: failed to remove scs entry\n");
+		return res;	
+	}
+
+	/* scs remove request hook to driver */
+	mxl_scs_remove_req(hapd, mac, 0, scsId);
+
+	return res;
+}
