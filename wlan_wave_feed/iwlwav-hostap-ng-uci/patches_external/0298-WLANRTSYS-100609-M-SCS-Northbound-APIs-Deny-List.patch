+int mxl_hostapd_cli_cmd_scs_add(struct wpa_ctrl *ctrl, int argc,
+					char *argv[])
+{
+	char cmd[2048];
+	int res = 0;
+
+	if (argc < 3) {
+		printf("Usage: scs_add <STA_MAC> <SCS_ID> <hexdump>\n");
+		return -1;
+	}
+
+	res = sprintf_s(cmd, sizeof(cmd), "SCS_ADD_RULE %s %s %s",
+			argv[0], argv[1], argv[2]);
+
+	if (res <= 0) {
+		printf("%s: sprintf_s error %d", __func__, res);
