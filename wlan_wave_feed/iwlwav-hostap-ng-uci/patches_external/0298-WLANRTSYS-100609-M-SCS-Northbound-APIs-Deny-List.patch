+/* Add scs and mscs rules if present after sta connects 
+ * is_scs - true - add_scs_rules
+ * is_scs - false - add_mscs_rules
+ * */
+int mxl_qos_add_pending_rule(struct hostapd_data *hapd, u8 sta_addr[ETH_ALEN], bool is_scs)
+{
+	
+	int rule = 0;
+	const struct ieee80211_mgmt *mgmt = NULL;
+	struct mxl_scs_entry *scs_entry = NULL;
+	struct mxl_mscs_entry *mscs_entry = NULL;
+
+	/* Add scs rules here*/
+	if (is_scs) {
+		scs_entry = hapd->mxl_data.scs_entry_list;
+		while (scs_entry) {
+			wpa_printf(MSG_DEBUG, "STA MAC "MACSTR" || ENTRY MAC "MACSTR, MAC2STR(sta_addr), MAC2STR(scs_entry->sta_mac));
+			if (os_memcmp(scs_entry->sta_mac, sta_addr, ETH_ALEN) == 0) {
+				if (scs_entry->mgmt_bytes) {
+					mgmt =  (const struct ieee80211_mgmt *)scs_entry->mgmt_bytes;
+					mxl_handle_scs_req(hapd, mgmt, scs_entry->mgmt_len, true);
+					rule++;
+				}
+				else {
+					wpa_printf(MSG_ERROR, "SCS Rules mgmt_bytes null");
+				}
+			}
+			scs_entry = scs_entry->next;
+		}
+		wpa_printf(MSG_DEBUG, "%d MSCS Rules Added after sta connection", rule);
+	}
+	else {
+		/* Add mscs rules here */
+		mscs_entry = hapd->mxl_data.mscs_entry_list;
+		while (mscs_entry) {
+			wpa_printf(MSG_DEBUG, "STA MAC "MACSTR" || ENTRY MAC "MACSTR, MAC2STR(sta_addr), MAC2STR(mscs_entry->sta_mac));
+			if (os_memcmp(mscs_entry->sta_mac, sta_addr, ETH_ALEN) == 0) {
+				if (mscs_entry->mgmt_bytes) {
+					mgmt =  (const struct ieee80211_mgmt *)mscs_entry->mgmt_bytes;
+					mxl_handle_mscs_req(hapd, mgmt, mscs_entry->mgmt_len, true);
+					rule++;
+				}
+				else {
+					wpa_printf(MSG_ERROR, "MSCS Rules mgmt_bytes null");
+				}
+			}
+			mscs_entry = mscs_entry->next;
+		}
+		wpa_printf(MSG_DEBUG, "%d MSCS Rules Added after sta connection", rule);
+	}
+	return rule;
+}
+#endif /* CONFIG_SCS_MXL  || CONFIG_MSCS_MXL */
 #endif /* CONFIG_NATIVE_WINDOWS */
