+/* Parser function to convert hexstream to bytes
+ * Hex -> bytes (accepts spaces/newlines/colons) 
+ * returns zero on success and non-zero on failure*/
+static int mxl_convert_hex_to_bytes(const char *hex, u8 **out, size_t *outlen)
+{
+	size_t n = 0;
+	char *clean = os_malloc(os_strlen(hex) + 1);
+	if (!clean)
+		return -1;
+
+	int clean_len = os_strlen(hex);
+	for (size_t i = 0; hex[i]; ++i) {
+		if (isxdigit((unsigned char) hex[i]) && n < clean_len) {
+			clean[n++] = hex[i];
+		}
+	}
+	clean[n] = '\0';
+
+	if (n < 2 || (n % 2) != 0) {
+		os_free(clean);
+		return -2;
+	}
+
+	*outlen = n / 2;
+	*out = os_malloc(*outlen);
+	if (!*out) {
+		os_free(clean);
+		return -3;
+	}
+
+	for (size_t i = 0; i < *outlen; ++i) {
+		char bh[3] = { clean[2*i], clean[2*i+1], 0 };
+		(*out)[i] = (u8) strtoul(bh, NULL, 16);
+	}
+	os_free(clean);
+	return 0;
+}
