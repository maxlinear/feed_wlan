+
+static int mxl_hostapd_ctrl_iface_scs_remove_rule(struct hostapd_data *hapd, char *buf, char *reply, size_t replylen)
+{
+	int rc = 0, n_args = 0;
+	unsigned int scsId;
+	char mac_str[64] = {0};
+
+	if (!hapd->conf->mxl_bss_conf.scs_enable) {
+		wpa_printf(MSG_ERROR, "SCS: ctrl-iface scs_remove - not enabled/supported");
+		return -1;
+	}
+
+	n_args = sscanf(buf, " %63s %u", mac_str, &scsId);
+	if (n_args != 2) {
+		wpa_printf(MSG_ERROR, "Parse error: expected 2 tokens, got %d\n", n_args);
+		return -1;
+	}
+
+	/* remove and handle scs northbound request */
+	rc = mxl_northbound_scs_remove_req(hapd, mac_str, scsId);
+
+	if (rc) {
+		rc = sprintf_s(reply, replylen, "SCS rule removed\nSTA_MAC %s  SCS_ID %u\n", mac_str, scsId);
+	}
+	else {
+		rc = sprintf_s(reply, replylen, "Failed to remove SCS rule\nSTA_MAC %s  SCS_ID %u\n", mac_str, scsId);
+	}
+
+	return rc;
+}
+
+static int mxl_hostapd_ctrl_iface_scs_add_rule(struct hostapd_data *hapd, char *buf, char *reply, size_t replylen)
+{
+	int rc = 0, n_args = 0;
+	unsigned int scsId;
+	char mac_str[64] = {0};
+	char hex_str[1024] = {0};
+
+	if (!hapd->conf->mxl_bss_conf.scs_enable) {
+		wpa_printf(MSG_ERROR, "SCS: ctrl-iface scs_add/remove - not enabled/supported");
+		return -1;
+	}
+
+	n_args = sscanf(buf, " %63s %u %[^\n]", mac_str, &scsId, hex_str);
+	if (n_args != 3) {
+		wpa_printf(MSG_ERROR, "Parse error: expected 3 tokens, got %d\n", n_args);
+		return -1;
+	}
+
+	/* store and handle scs northbound request */
+	rc = mxl_northbound_scs_add_req(hapd, mac_str, scsId, hex_str);
+
+	if (rc) {
+		rc = sprintf_s(reply, replylen, "SCS rule added\nSTA_MAC : %s  SCS_ID : %u\n", mac_str, scsId);
+	}
+	else {
+		rc = sprintf_s(reply, replylen, "Failed to add SCS rule\nSTA_MAC %s  SCS_ID : %u\n", mac_str, scsId);
+	}
+
+	return rc;
+}
