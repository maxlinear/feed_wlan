+#if defined(CONFIG_SCS_MXL) || defined(CONFIG_MSCS_MXL)
+/* Parser function to convert MAC hexbytes to string*/
+static void mxl_parse_mac_hex_to_str(const u8 mac[ETH_ALEN], char out[18])
+{
+	os_snprintf(out, 18, "%02x:%02x:%02x:%02x:%02x:%02x",
+			mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+}
+
+/* function to check qos deny mac list 
+ * is_scs - true - then scs_deny_mac_list
+ * is_scs - false - then mscs_deny_mac_list
+ * */
+int is_mxl_qos_deny_mac(struct hostapd_data *hapd, const u8 *mac, bool is_scs)
+{
+	int res = 1;
+	struct mxl_qos_deny_list *ref;
+	/* is_scs is true - scs, is_scs is false - mscs */
+	if (is_scs)
+#ifdef CONFIG_SCS_MXL
+		ref = hapd->iface->conf->mxl_conf.scs_deny;
+#endif /* CONFIG_SCS_MXL */
+	else
+#ifdef CONFIG_MSCS_MXL
+		ref = hapd->iface->conf->mxl_conf.mscs_deny;
+#endif /* CONFIG_MSCS_MXL */
+
+	while (ref) {
+		if (os_memcmp(mac, ref->mxl_qos_deny_mac, ETH_ALEN) == 0) {
+			return res;
+		}
+		ref = ref->next;
+	}
+	res = 0;
+	return res;
+}
+
+/* helper to free qos deny mac list */
+void mxl_qos_deny_mac_free(struct mxl_qos_deny_list *ref)
+{
+	struct mxl_qos_deny_list *tmp = NULL;
+	while (ref) {
+		tmp = ref->next;
+		os_free(ref);
+		ref = tmp;
+	}
+	return;
+}
+
+/*
+ * mxl_get_qos_deny_mac_list
+ * fetches  mac_address from qos list puts it into qos_buf.
+ *
+ * hapd    : reference to hapd instance
+ * qos_buf : buffer to store mac address 
+ * is_scs  : true - scs mac_list, false - mscs mac_list
+ * returns : one - success and zero - failure/empty.
+ */
+int mxl_get_qos_deny_mac_list(struct hostapd_data *hapd, char *qos_buf, bool is_scs)
+{
+	int res = 0, written = 0;
+	size_t offset = 0, len = 0;
+	char mac_str[18] = {'\0'};
+	struct mxl_qos_deny_list *ref_list = NULL;
+
+	if (is_scs) {
+#ifdef CONFIG_SCS_MXL
+		ref_list = hapd->iface->conf->mxl_conf.scs_deny;
+#endif /* CONFIG_SCS_MXL */
+		if (!ref_list)
+			return res;
+	}
+	else {
+#ifdef CONFIG_MSCS_MXL
+		ref_list = hapd->iface->conf->mxl_conf.mscs_deny;
+#endif /* CONFIG_MSCS_MXL */
+		if (!ref_list)
+			return res;
+	}
+
+	len = QOS_BUFFER_MAX;
+	while (ref_list) {
+		if ((offset + 20) < len) {
+			mxl_parse_mac_hex_to_str(ref_list->mxl_qos_deny_mac, mac_str);
+			written = snprintf(qos_buf + offset, len - offset,
+					"%s\n", mac_str);
+			if (written > 0 && offset + written < len) {
+				offset += written;
+			}
+		}
+		else {
+			wpa_printf(MSG_ERROR, "Buffer size exceeded for Qos deny mac list");
+			break;
+		}
+		ref_list = ref_list->next;
+	}
+	res = 1;
+
+	return res;
+}
+
+/*
+ * mxl_set_qos_deny_mac_list
+ * Parses mac_address sepreated spaces into a list and stores it.
+ *
+ * hapd    : reference to hapd instance
+ * mac_str : list of mac address seperated by spaces 
+ * is_scs  : true - scs mac_list, false - mscs mac_list
+ * returns : one - success and zero - failure/empty.
+ */
+int mxl_set_qos_deny_mac_list(struct hostapd_data *hapd, char *mac_str, bool is_scs)
+{
+	int res = 0;
+	u8 sta_mac[ETH_ALEN] = {'\0'};
+	char *tok = NULL;
+	char *saveptr = NULL, *mac = NULL;
+	struct mxl_qos_deny_list *ref_deny_list = NULL, *tmp_deny_list = NULL;
+
+	tok = strtok_r(mac_str, " ", &saveptr);
+	if (!tok) {
+		if (is_scs) {
+#ifdef CONFIG_SCS_MXL
+			ref_deny_list = hapd->iface->conf->mxl_conf.scs_deny;
+			hapd->iface->conf->mxl_conf.scs_deny = NULL;
+#endif /* CONFIG_SCS_MXL */
+		}
+		else {
+#ifdef CONFIG_MSCS_MXL
+			ref_deny_list = hapd->iface->conf->mxl_conf.mscs_deny;
+			hapd->iface->conf->mxl_conf.mscs_deny = NULL;
+#endif /* CONFIG_MSCS_MXL */
+		}
+		mxl_qos_deny_mac_free(ref_deny_list);
+		return res;
+	}
+
+	while (tok) {
+		mac = tok;
+		if (mac[0] != '\0') {
+			if (mxl_parse_mac_str_to_hex(mac, sta_mac) != 0) {
+				wpa_printf(MSG_ERROR, "ERR: invalid mac");
+				mxl_qos_deny_mac_free(ref_deny_list);
+				return -1;
+			}
+
+			struct mxl_qos_deny_list *qos_new_list = (struct mxl_qos_deny_list *)os_malloc(sizeof(struct mxl_qos_deny_list));
+			if (!qos_new_list) {
+				wpa_printf(MSG_ERROR, "ERR: memory allocation issue");
+				mxl_qos_deny_mac_free(ref_deny_list);
+				return -1;
+			}
+			qos_new_list->next = NULL;
+			os_memcpy(qos_new_list->mxl_qos_deny_mac, sta_mac, ETH_ALEN);
+
+			if(!tmp_deny_list)
+				tmp_deny_list = qos_new_list;
+			else {
+				qos_new_list->next = tmp_deny_list;
+				tmp_deny_list = qos_new_list;
+			}
+		}
+		tok = strtok_r(NULL, " ", &saveptr);
+	}
+
+	res = 1;
+
+	if (is_scs) {
+#ifdef CONFIG_SCS_MXL
+		ref_deny_list = hapd->iface->conf->mxl_conf.scs_deny;
+		hapd->iface->conf->mxl_conf.scs_deny = tmp_deny_list;
+#endif /* CONFIG_SCS_MXL */
+	}
+	else {
+#ifdef CONFIG_MSCS_MXL
+		ref_deny_list = hapd->iface->conf->mxl_conf.mscs_deny;
+		hapd->iface->conf->mxl_conf.mscs_deny = tmp_deny_list;
+#endif /* CONFIG_MSCS_MXL */
+	}
+
+	/* free existing entry */
+	mxl_qos_deny_mac_free(ref_deny_list);
+
+	return res;
+}
