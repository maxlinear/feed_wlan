From 8159e6e6afee70b275ef0590a2dd78acd69dfa25 Mon Sep 17 00:00:00 2001
From: hmgokhale <hmgokhale@maxlinear.com>
Date: Tue, 22 Sep 2026 02:53:04 -0700
Subject: [PATCH] WLANRTSYS-104126 Set zwdfs_is_primary_cac flag in CoC and
 radar-recovery background CAC paths

Signed-off-by: hmgokhale <hmgokhale@maxlinear.com>
---
 src/ap/mxl_dfs_common.c | 10 +++++-----
 src/ap/mxl_zwdfs.c      | 41 +++++++++++++++++++++++++++++++++++++++++
 2 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/src/ap/mxl_dfs_common.c b/src/ap/mxl_dfs_common.c
index 1d2c13b6c..1d6ce2094 100644
--- a/src/ap/mxl_dfs_common.c
+++ b/src/ap/mxl_dfs_common.c
@@ -717,11 +717,11 @@ bool mxl_hostapd_radar_chandef_matches_subband(struct hostapd_iface *iface, int
 bool mxl_hostapd_handle_radar_non_match_freq(struct hostapd_iface *iface, int cf1, int chan_width)
 {
 
-	if (!(mxl_hostapd_radar_chandef_matches_operational(iface, cf1, chan_width))) {
-		if (!(mxl_hostapd_radar_chandef_matches_subband(iface, cf1, chan_width))) {
-			wpa_printf(MSG_DEBUG, "Radar detected on non matching freq and BW, ignoring");
-			return true;
-		}
+	if (!mxl_hostapd_radar_chandef_matches_operational(iface, cf1, chan_width) &&
+		 !mxl_hostapd_radar_chandef_matches_subband(iface, cf1, chan_width) &&
+		 !mxl_dfs_are_channels_overlapped(iface, 0, chan_width, cf1, 0)) {
+		wpa_printf(MSG_DEBUG, "Radar detected on non matching freq and BW, ignoring");
+		return true;
 	}
 	return false;
 }
diff --git a/src/ap/mxl_zwdfs.c b/src/ap/mxl_zwdfs.c
index 6d36bd16b..edc9addff 100644
--- a/src/ap/mxl_zwdfs.c
+++ b/src/ap/mxl_zwdfs.c
@@ -476,6 +476,9 @@ int mxl_hostapd_zwdfs_cac_on_autoCoC(struct hostapd_iface *iface)
 		return -1;
 	}
 	iface->mxl_iface.autococ_background_cac_running = 1;
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	iface->mxl_iface.sec_best_ch.zwdfs_is_primary_cac = true;
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
 	return 0;
 }
 
@@ -662,6 +665,9 @@ void mxl_hostapd_zwdfs_cac_on_radar(struct hostapd_iface *iface, struct csa_sett
 	int secondary_channel;
 	u8 vht_oper_centr_freq_seg0_idx;
 	u8 vht_oper_centr_freq_seg1_idx;
+	int orig_freq, orig_channel, orig_secondary_channel;
+	u8 orig_seg0_idx, orig_seg1_idx;
+	enum oper_chan_width orig_chwidth;
 
 	/* If the new channel is a static failsafe channel, then no need for ZWDFS and
 	 * directly set the channel to operational vaps.
@@ -676,6 +682,25 @@ void mxl_hostapd_zwdfs_cac_on_radar(struct hostapd_iface *iface, struct csa_sett
 	}
 
 	memcpy_s(&new_chan_settings, sizeof(struct csa_settings), settings, sizeof(struct csa_settings));
+
+	/* dfs_get_start_chan_idx()/dfs_get_used_n_chans() below take only iface
+	 * and read the channel to check out of iface->conf - they have no
+	 * explicit channel argument. Temporarily load the ZWDFS target into
+	 * iface->conf just so they can compute against it, then restore the
+	 * original, currently-confirmed values right after. No CSA has been
+	 * requested yet at this point, so iface->conf/freq must keep describing
+	 * the channel we are actually still operating on - beacons read these
+	 * fields directly - until the real switch (interim failsafe or ZWDFS
+	 * target, whichever CSA our caller ends up issuing) is confirmed via
+	 * hostapd_event_ch_switch().
+	 */
+	orig_freq = iface->freq;
+	orig_channel = iface->conf->channel;
+	orig_secondary_channel = iface->conf->secondary_channel;
+	orig_seg0_idx = hostapd_get_oper_centr_freq_seg0_idx(iface->conf);
+	orig_seg1_idx = hostapd_get_oper_centr_freq_seg1_idx(iface->conf);
+	orig_chwidth = hostapd_get_oper_chwidth(iface->conf);
+
 	mxl_hostapd_set_conf_from_freq_params(iface, &new_chan_settings.freq_params);
 
 	/* Get start (first) channel for current configuration */
@@ -688,6 +713,19 @@ void mxl_hostapd_zwdfs_cac_on_radar(struct hostapd_iface *iface, struct csa_sett
 	/* Get number of used channels, depend on width */
 	n_chans = mxl_dfs_get_used_n_chans(iface, &n_chans1);
 
+	/* Both lookups above are done with the temporary target values - restore
+	 * iface->conf/freq to what they were before this function ran. Nothing
+	 * from here on (chans-available check, chans-unavailable check, dynamic
+	 * failsafe lookup, background CAC start) needs iface->conf to reflect
+	 * the target channel.
+	 */
+	iface->freq = orig_freq;
+	iface->conf->channel = orig_channel;
+	iface->conf->secondary_channel = orig_secondary_channel;
+	hostapd_set_oper_centr_freq_seg0_idx(iface->conf, orig_seg0_idx);
+	hostapd_set_oper_centr_freq_seg1_idx(iface->conf, orig_seg1_idx);
+	hostapd_set_oper_chwidth(iface->conf, orig_chwidth);
+
 	/* Check if all channels are DFS available */
 	err = mxl_dfs_check_chans_available(iface, start_chan_idx, n_chans);
 	if (err) {
@@ -748,6 +786,9 @@ void mxl_hostapd_zwdfs_cac_on_radar(struct hostapd_iface *iface, struct csa_sett
 		wpa_printf(MSG_ERROR, "%s: Failed to start Background CAC in ZWDFS antenna\n", __func__);
 		goto fail;
 	}
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	iface->mxl_iface.sec_best_ch.zwdfs_is_primary_cac = true;
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
 	return;
 
 fail:
-- 
2.43.0

