--- a/src/ap/mxl_wds.c
+++ b/src/ap/mxl_wds.c
@@ -32,6 +32,8 @@ static void mxl_ml_wds_update_handled_links(struct mxl_ml_wds_entry *wds_entry,
 static void mxl_ml_free_wds_entry(struct mxl_ml_wds_entry *wds_entry);
 static void mxl_ml_clear_pending_wds_entry(struct hostapd_data *hapd,
 			   const u8 *addr);
+static void mxl_ml_wds_clear_sta_timers(struct hostapd_data *hapd, struct sta_info *sta);
+static void mxl_ml_wds_set_sta_timers(struct hostapd_data *hapd, struct sta_info *sta);
 static bool mxl_ml_wds_all_links_handled(struct mxl_ml_wds_entry *wds_entry);
 static int mxl_ml_add_wds_sta(struct hostapd_data *hapd, struct sta_info *sta,
 			   struct mxl_ml_wds_entry *wds_entry);
@@ -453,6 +455,7 @@ void mxl_wds_event_connect(struct hostapd_data *hapd,
 	if (mxl_is_mlo_enabled(hapd->conf) && mxl_mlo_is_ml_sta(sta)) {
 		wds_entry = mxl_ml_get_pending_wds_entry(hapd, sta->mxl_sta_info.non_ap_mld_mac);
 		if (wds_entry) {
+			mxl_ml_wds_clear_sta_timers(hapd, sta);
 			mxl_ml_wds_update_handled_links(wds_entry, sta);
 			if (mxl_ml_wds_all_links_handled(wds_entry)) {
 				mxl_ml_add_wds_sta(hapd, sta, wds_entry);
@@ -549,7 +552,7 @@ struct mxl_ml_wds_entry *mxl_ml_get_pending_wds_entry(struct hostapd_data *hapd,
 	}
 
 	if (!found)
-		wpa_printf(MSG_ERROR, "MXL_MLO: No WDS entry with MLD MAC " MACSTR,
+		wpa_printf(MSG_INFO, "MXL_MLO: No WDS entry with MLD MAC " MACSTR,
 			   MAC2STR(mld_addr));
 	
 	return found ? wds_entry : NULL;
@@ -589,6 +592,9 @@ static void mxl_ml_free_wds_entry(struct mxl_ml_wds_entry *wds_entry)
 	if (!wds_entry)
 		return;
 
+	wpa_printf(MSG_DEBUG, "MXL_MLO: Free WDS entry for MLD " MACSTR,
+		   MAC2STR(wds_entry->mld_addr));
+
 	dl_list_del(&wds_entry->list);
 	os_free(wds_entry);
 }
@@ -636,9 +642,42 @@ static struct sta_info *mxl_ml_wds_get_sta(struct hostapd_data *hapd, const u8 *
 		if (sta)
 			return sta;
 	}
+	wpa_printf(MSG_ERROR, "MXL_MLO: WDS No STA found with MAC " MACSTR, MAC2STR(addr));
 	return NULL;
 }
 
+static void mxl_ml_wds_clear_sta_timers(struct hostapd_data *hapd, struct sta_info *sta)
+{
+	if (!sta)
+		return;
+
+	eloop_cancel_timeout(ap_handle_timer, hapd, sta);
+	ap_sta_clear_assoc_timeout(hapd, sta);
+}
+
+static void mxl_ml_wds_set_sta_timers(struct hostapd_data *hapd, struct sta_info *sta)
+{
+	int max_inactivity = hapd->conf->ap_max_inactivity;
+
+	if (!sta)
+		return;
+
+	if (sta->max_idle_period)
+		max_inactivity = (sta->max_idle_period * 1024 + 999) / 1000;
+
+	mxl_ml_wds_clear_sta_timers(hapd, sta);
+
+	if (!(hapd->iface->drv_flags & WPA_DRIVER_FLAGS_INACTIVITY_TIMER)) {
+		wpa_printf(MSG_DEBUG, "MXL_MLO: %s WDS register ap_handle_timer timeout "
+			   "for " MACSTR " (%d seconds - ap_max_inactivity)",
+			   hapd->conf->iface, MAC2STR(sta->addr),
+			   max_inactivity);
+		eloop_register_timeout(max_inactivity, 0,
+				       ap_handle_timer, hapd, sta);
+	}
+	ap_sta_set_assoc_timeout(hapd, sta);
+}
+
 static void mxl_ml_set_linked_stas(struct sta_info *sta)
 {
 	struct sta_info *lsta1 = sta->mxl_sta_info.linked_sta[0];
@@ -687,6 +726,14 @@ static int mxl_ml_add_wds_sta(struct hostapd_data *hapd, struct sta_info *sta,
 		}
 	}
 
+	wpa_printf(MSG_DEBUG, "MXL_MLO: %s Adding WDS ML STA " MACSTR 
+		   " assoc link " MACSTR,
+		   hapd->conf->iface, MAC2STR(wds_entry->mld_addr), MAC2STR(sta->addr));
+
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		wpa_printf(MSG_DEBUG, "MXL_MLO: WDS sibling link " MACSTR, MAC2STR(lsta->addr));
+	}
+
 	/* Get AID for MLD STA */
 	if (hostapd_get_aid(hapd, sta) < 0) {
 		hostapd_logger(hapd, sta->addr, HOSTAPD_MODULE_IEEE80211,
@@ -695,6 +742,7 @@ static int mxl_ml_add_wds_sta(struct hostapd_data *hapd, struct sta_info *sta,
 	}
 
 	/* Add first linked WDS STA */
+	mxl_ml_wds_set_sta_timers(hapd, sta);
 	if (mxl_mlo_add_affiliated_wds_sta(hapd, sta, &new_assoc)) {
 		ap_free_sta(hapd, sta);
 		return -1;
@@ -707,6 +755,7 @@ static int mxl_ml_add_wds_sta(struct hostapd_data *hapd, struct sta_info *sta,
 			mxl_mld_log_no_sibling_bss(link_id);
 			goto fail;
 		}
+		mxl_ml_wds_set_sta_timers(lhapd, lsta);
 		if (mxl_mlo_add_affiliated_wds_sta(lhapd, lsta, &new_assoc)) {
 			goto fail;
 		}
@@ -787,7 +836,10 @@ void mxl_ml_set_wds_link_info(struct mxl_ml_wds_entry *wds_entry, u8 link_id,
 			memcpy_s(link_info->bssid, ETH_ALEN, bssid, ETH_ALEN);
 			link_info->valid = true;
 			wds_entry->num_of_links++;
-			break;
+			wpa_printf(MSG_DEBUG, "MXL_MLO: WDS Entry MLD " MACSTR " Add new link " MACSTR
+				   " num_of_links %d", MAC2STR(wds_entry->mld_addr),
+				   MAC2STR(bssid), wds_entry->num_of_links);
+			return;
 		}
 	}
 }
@@ -806,18 +858,21 @@ static void mxl_ml_wds_update_handled_links(struct mxl_ml_wds_entry *wds_entry,
 			wds_entry->wds_handled_links++;
 			wpa_printf(MSG_DEBUG, "MXL_MLO: WDS expected links %d currently added %d",
 							wds_entry->num_of_links, wds_entry->wds_handled_links);
+			return;
 		}
 	}
 }
 
 static bool mxl_ml_wds_all_links_handled(struct mxl_ml_wds_entry *wds_entry)
 {
-	return (wds_entry->wds_handled_links == wds_entry->num_of_links);
+	bool res = (wds_entry->wds_handled_links == wds_entry->num_of_links);
+	wpa_printf(MSG_DEBUG, "MXL_MLO: %s res(%d)", __func__, res);
+	return res;
 }
 
 
 
-void mxl_wds_init_pending_assoc(struct p_ap_mld *mld)
+void mxl_ml_wds_init(struct p_ap_mld *mld)
 {
 	if (!mld)
 		return;
@@ -828,7 +883,7 @@ void mxl_wds_init_pending_assoc(struct p_ap_mld *mld)
 	}
 }
 
-void mxl_wds_deinit_pending_assoc(struct p_ap_mld *mld)
+void mxl_ml_wds_cleanup_pending_assoc(struct p_ap_mld *mld)
 {
 	struct mxl_ml_wds_entry *iter;
 
@@ -844,5 +899,17 @@ void mxl_wds_deinit_pending_assoc(struct p_ap_mld *mld)
 		dl_list_del(&iter->list);
 		os_free(iter);
 	}
+
+	wpa_printf(MSG_DEBUG, "MXL_MLO: WDS pending assoc cleanup done for MLD " MACSTR
+		   ,MAC2STR(mld->ap_mld_mac));
+}
+
+void mxl_ml_wds_deinit(struct p_ap_mld *mld)
+{
+	if (!mld)
+		return;
+
+	mxl_ml_wds_cleanup_pending_assoc(mld);
+	mld->wds.initialized = false;
 }
 #endif /* CONFIG_IEEE80211BE_MXL_MLO */
