From ee02818c89c756dde22d80bcc9edfaf87c60d283 Mon Sep 17 00:00:00 2001
From: Nikita Chernikov <nchernikov@maxlinear.com>
Date: Mon, 6 Apr 2026 15:54:34 +0300
Subject: [PATCH] WLANRTSYS-101355 MLO WDS Fixes

- Add more debug in ML WDS flow
- Cancel assoc timeout and ap handle timer and start them only when all ML peers are added
- Cleanup WDS assoc pending list during MLO init and destroy
- Set wds_force_6g_assoc to false by default

Fixup to: WLANRTSYS-96596 MLO: Triband MLD Support

Signed-off-by: Nikita Chernikov <nchernikov@maxlinear.com>
---
 hostapd/mxl_config.c  |  2 +-
 src/ap/mxl_hostapd.c  |  5 ++-
 src/ap/mxl_mld.c      | 16 +++++++--
 src/ap/mxl_sta_info.h | 10 +++---
 src/ap/mxl_wds.c      | 77 ++++++++++++++++++++++++++++++++++++++++---
 src/ap/mxl_wds.h      |  5 +--
 src/ap/sta_info.c     |  8 +++++
 src/ap/sta_info.h     |  2 ++
 8 files changed, 108 insertions(+), 17 deletions(-)

diff --git a/hostapd/mxl_config.c b/hostapd/mxl_config.c
index 0b9c63ef8..f7955c4b8 100644
--- a/hostapd/mxl_config.c
+++ b/hostapd/mxl_config.c
@@ -2184,6 +2184,7 @@ void mxl_hostapd_config_defaults_bss(struct hostapd_bss_config *bss)
 	bss->mxl_bss_conf.mlo_enable = false;
 	bss->mxl_bss_conf.wds_single_ml_assoc = false;
 	bss->mxl_bss_conf.wds_primary_link = false;
+	bss->mxl_bss_conf.mld_wds_force_6g_assoc = false;
 	bss->mxl_bss_conf.switch_initial_active_link = false;
 	bss->mxl_bss_conf.ml_ie_add = false;
 	bss->mld_id = INVALID_MLD_ID;
@@ -2192,7 +2193,6 @@ void mxl_hostapd_config_defaults_bss(struct hostapd_bss_config *bss)
 	os_memset(bss->mxl_bss_conf.ap_mld_mac, '\0', ETH_ALEN);
 	bss->mxl_bss_conf.eml_transition_timeout = EML_CAPAB_TRANSITION_TIMEOUT_DEFAULT;
 	bss->mxl_bss_conf.links_per_ap_mld = LINKS_PER_AP_MLD_DEFAULT;
-	bss->mxl_bss_conf.mld_wds_force_6g_assoc = true;
 #endif /* CONFIG_IEEE80211BE_MXL_MLO */
 	mxl_bss_conf->rnr_auto_update = 1;
 	mxl_bss_conf->disable_pbac = false;
diff --git a/src/ap/mxl_hostapd.c b/src/ap/mxl_hostapd.c
index e243be84f..af2da5148 100644
--- a/src/ap/mxl_hostapd.c
+++ b/src/ap/mxl_hostapd.c
@@ -2864,6 +2864,9 @@ void mxl_hostapd_remove_mld(struct p_ap_mld *mld)
 		hostapd_free_stas(aff_hapd);
 	}
 
+	if (mld->mld_added)
+		mxl_ml_wds_cleanup_pending_assoc(mld);
+
 	if (mxl_hostapd_send_mld_remove(mld))
 		wpa_printf(MSG_ERROR, "MXL_MLO: %s: MLD removal failure MLD MAC "MACSTR, __func__, MAC2STR(mld->ap_mld_mac));
 }
@@ -2879,7 +2882,7 @@ int mxl_hostapd_deinit_gmld(struct hostapd_data *hapd)
 		return -1;
 	}
 
-	mxl_wds_deinit_pending_assoc(mld);
+	mxl_ml_wds_deinit(mld);
 	os_memset(mld, 0, sizeof(struct p_ap_mld));
 	wpa_printf(MSG_DEBUG, "MXL_MLO: MLD id %d deinitialized", mld_id);
 	hapd->mxl_data.removed_by_sibling = false;
diff --git a/src/ap/mxl_mld.c b/src/ap/mxl_mld.c
index 481401753..bc93403c4 100644
--- a/src/ap/mxl_mld.c
+++ b/src/ap/mxl_mld.c
@@ -105,7 +105,7 @@ static void mxl_update_mld_info(struct hostapd_data *hapd, int mld_id, bool set_
 	mld->affiliated_links[mld->num_links++] = hapd;
 	if (set_ap_mld_mac) {
 		memcpy_s(mld->ap_mld_mac, ETH_ALEN, hapd->conf->mxl_bss_conf.ap_mld_mac, ETH_ALEN);
-		mxl_wds_init_pending_assoc(mld);
+		mxl_ml_wds_init(mld);
 	}
 
 	hapd->conf->mld_id = mld_id;
@@ -589,6 +589,8 @@ static int mxl_mlo_wds_setup(struct p_ap_mld *mld)
 {
 	struct hostapd_data *aff_hapd = NULL;
 
+	mxl_ml_wds_cleanup_pending_assoc(mld);
+
 	mxl_mld_for_each_affiliated_link(aff_hapd, mld) {
 		if (mxl_wds_setup(aff_hapd)){
 			wpa_printf(MSG_ERROR, "MXL_MLO: WDS setup failed for %s of MLD MAC "MACSTR, aff_hapd->conf->iface, MAC2STR(mld->ap_mld_mac));
@@ -2217,7 +2219,9 @@ static u16 mxl_mld_parse_wds_ml_rnr(struct hostapd_data *hapd, struct mxl_ml_wds
 		const struct ieee80211_neighbor_ap_info *ap_info;
 		const u8 *pos = elem->data;
 		size_t len = elem->datalen;
-			
+
+		wpa_hexdump(MSG_DEBUG, "MXL_MLO: rnr_wds", pos, len);
+
 		while (sizeof(*ap_info) <= len) {
 			size_t ap_info_len = sizeof(*ap_info);
 			u8 count;
@@ -2266,6 +2270,8 @@ static u16 mxl_mld_handle_wds_pending_assoc(struct hostapd_data *hapd, struct st
 	wds_entry = mxl_ml_get_pending_wds_entry(hapd, sta->mxl_sta_info.non_ap_mld_mac);
 	if (wds_entry) {
 		/* Pending wds assoc entry exists - do nothing */
+		wpa_printf(MSG_DEBUG, "MXL_MLO: Pending WDS entry already exists for non-AP MLD " MACSTR,
+			   MAC2STR(sta->mxl_sta_info.non_ap_mld_mac));
 		return WLAN_STATUS_SUCCESS;
 	}
 
@@ -2275,6 +2281,8 @@ static u16 mxl_mld_handle_wds_pending_assoc(struct hostapd_data *hapd, struct st
 		wpa_printf(MSG_ERROR, "MXL_MLO: failed to allocate new wds entry");
 		return WLAN_STATUS_UNSPECIFIED_FAILURE;
 	}
+	wpa_printf(MSG_DEBUG, "MXL_MLO: Created new pending WDS entry for non-AP MLD " MACSTR,
+		   MAC2STR(sta->mxl_sta_info.non_ap_mld_mac));
 
 	memcpy_s(new_wds->mld_addr, ETH_ALEN, sta->mxl_sta_info.non_ap_mld_mac, ETH_ALEN);
 	dl_list_add_tail(&mld->wds.wds_pending_assoc, &new_wds->list);
@@ -2341,7 +2349,7 @@ u16 mxl_mld_parse_ml_ie_wds(struct hostapd_data *hapd, struct sta_info *sta,
 		goto out;
 	}
 
-	wpa_hexdump(MSG_DEBUG, "multilink_ie_wds_validate", ml_ies, ml_ies_len);
+	wpa_hexdump(MSG_DEBUG, "MXL_MLO: multilink_ie_wds", ml_ies, ml_ies_len);
 	sta->mxl_sta_info.sta_ml_capab.ml_control_field = *(u16 *)ml_ies;
 	common_info_ie = (ml_ies + MULTILINK_CTRL_LEN) + 1;
 	memcpy_s(sta->mxl_sta_info.non_ap_mld_mac, ETH_ALEN, common_info_ie, ETH_ALEN);
@@ -3121,6 +3129,8 @@ void mxl_ml_iface_disabled(struct hostapd_data *hapd)
 		wpa_printf(MSG_DEBUG, "MXL_MLO: %s MLD removed by driver - reset mld added status",
 			   hapd->conf->iface);
 	}
+
+	mxl_ml_wds_cleanup_pending_assoc(mld);
 }
 
 bool mxl_ml_is_last_link_in_mld(struct hostapd_data *hapd)
diff --git a/src/ap/mxl_sta_info.h b/src/ap/mxl_sta_info.h
