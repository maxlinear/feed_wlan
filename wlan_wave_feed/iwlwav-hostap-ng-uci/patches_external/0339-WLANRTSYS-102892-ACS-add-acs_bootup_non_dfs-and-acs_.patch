+void mxl_acs_stop_bootup_non_dfs_timer(struct hostapd_data *hapd)
+{
+	if (eloop_is_timeout_registered(mxl_acs_bootup_non_dfs_timer_cb, hapd, NULL)) {
+		hapd->iface->mxl_iface.acs_bootup_non_dfs_done = true;
+		wpa_printf(MSG_INFO,
+			   "%s: acs_bootup_non_dfs: cancel timer because ACS is disabled",
+			   hapd->conf->iface);
+		eloop_cancel_timeout(mxl_acs_bootup_non_dfs_timer_cb, hapd, NULL);
+	}
+}
+
+void mxl_acs_bootup_non_dfs_timer_cb(void *eloop_data, void *user_ctx)
+{
+	struct hostapd_data *hapd = (struct hostapd_data *) eloop_data;
+	struct hostapd_iface *iface = hapd->iface;
+	mxl_acs_chandef cur_chan;
+
+	wpa_printf(MSG_INFO,
+		   "%s: acs_bootup_non_dfs timer expired - re-enabling DFS channels for ACS re-evaluation",
+		   hapd->conf->iface);
+
+	iface->mxl_iface.acs_bootup_non_dfs_done = true;
+	iface->mxl_iface.sec_best_ch.flag = false;
+	iface->mxl_iface.sec_best_ch.bg_cac = false;
+
+	acs_push_chandef(iface, &cur_chan);
+	if (mxl_acs_recalc_ranks_and_set_chan(iface, SWR_INITIAL) > 0) {
+		int cac_res;
+
+		wpa_printf(MSG_INFO,
+			   "%s: acs_bootup_non_dfs re-evaluation selected a new channel",
+			   hapd->conf->iface);
+		cac_res = mxl_dfs_try_background_cac_if_required(iface);
+		if (cac_res > 0) {
+			wpa_printf(MSG_INFO,
+				   "DFS: background CAC started for acs_bootup_non_dfs ch=%d freq=%d",
+				   iface->conf->channel, iface->freq);
+			return;
+		}
+		if (cac_res == 0) {
+			wpa_printf(MSG_INFO,
+				   "DFS: acs_bootup_non_dfs does not require CAC, proceeding with channel switch");
+		} else {
+			wpa_printf(MSG_INFO,
+				   "DFS: bgCAC needed for acs_bootup_non_dfs but could not start, falling back to channel switch");
+		}
+		mxl_hostapd_dfs_switch_to_iface_chandef(iface);
+	} else {
+		wpa_printf(MSG_INFO,
+			   "%s: acs_bootup_non_dfs re-evaluation: staying on current channel",
+			   hapd->conf->iface);
+	}
+
+	mxl_acs_set_bgscan_int(hapd);
+}
+
+void mxl_acs_start_bootup_non_dfs_timer(struct hostapd_data *hapd)
+{
+	if (!eloop_is_timeout_registered(mxl_acs_bootup_non_dfs_timer_cb, hapd, NULL)) {
+		wpa_printf(MSG_INFO,
+			   "%s: acs_bootup_non_dfs: scheduling 15-min DFS re-evaluation timer",
+			   hapd->conf->iface);
+		eloop_register_timeout(ACS_BOOTUP_NON_DFS_TIMER_SECS, 0,
+					      mxl_acs_bootup_non_dfs_timer_cb, hapd, NULL);
+	}
+}
