+	oper_width = mxl_hostapd_get_num_width(hostapd_get_oper_chwidth(iface->conf),
+						     iface->conf->secondary_channel);
+	ret = mxl_acs_recalc_ranks_and_set_chan(iface, SWR_EX_OP_UPDATE);
+	if (ret > 0) {
+		if (WAVE_FREQ_IS_5G(iface->freq) && mxl_is_dfs_channel(hapd->iface->conf->channel,
+					      hostapd_get_oper_chwidth(hapd->iface->conf))) {
+			acs_sel_width = mxl_hostapd_get_num_width(hostapd_get_oper_chwidth(iface->conf),
+							       iface->conf->secondary_channel);
+			if (channels_overlap(oper_freq, oper_width, hapd->iface->freq, acs_sel_width)) {
+				ch_switch = true;
+			} else if (iface->mxl_iface.sec_best_ch.channel) {
+				if (channels_overlap(iface->mxl_iface.sec_best_ch.freq,
+						     iface->mxl_iface.sec_best_ch.width,
+						     hapd->iface->freq, acs_sel_width)) {
+					ch_switch = true;
+				}
+			} else {
+				iface->mxl_iface.acs_bgscan_enable = 1;
+				mxl_acs_request_background_cac(iface);
+			}
+		} else {
+			ch_switch = true;
+		}
+
+		if (ch_switch && mxl_acs_do_switch_channel(iface, 0) < 0)
+			acs_pop_chandef(iface, &cur_chan);
+	}
+
+	return ret;
+}
