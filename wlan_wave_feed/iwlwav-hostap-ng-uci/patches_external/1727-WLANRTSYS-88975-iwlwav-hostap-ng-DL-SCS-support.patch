+int mxl_scs_parse_qos_characteristics_elems(const u8 *pos, struct mxl_scs_add_req *scs_add_req)
+{
+	u32 ctrl_info;
+
+	if (*pos++ != WLAN_EID_EXT_QOS_CHARACTERISTICS)
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+
+	os_memcpy(&ctrl_info, pos, sizeof(u32));
+	pos += sizeof(u32); /* Length of control info */
+
+	os_memcpy(&(scs_add_req->minServiceInterval), pos, sizeof(u32));
+	pos += sizeof(u32); /* Length of minimum service time */
+
+	os_memcpy(&(scs_add_req->maxServiceInterval), pos, sizeof(u32));
+	pos += sizeof(u32); /* Length of maximum service time */
+
+	os_memcpy(&(scs_add_req->minDataRate), pos, 3 * sizeof(u8));
+	pos += 3 * sizeof(u8); /* Length of min data rate */
+
+	os_memcpy(&(scs_add_req->delayBound), pos, 3 * sizeof(u8));
+	pos += 3 * sizeof(u8); /* Length of delay bound */
+
+	scs_add_req->direction = QOS_CTRL_INFO_DIR_MASK & ctrl_info;
+	scs_add_req->tid = QOS_CTRL_INFO_TID_MASK  &  ( ctrl_info >> QOS_CTRL_INFO_TID_SHIFT);
+	scs_add_req->userPrio = QOS_CTRL_INFO_USER_PRIORITY_MASK &
+		(ctrl_info >> QOS_CTRL_INFO_USER_PRIORITY_SHIFT);
+	scs_add_req->bitmapNextParamPresence  = QOS_CTRL_INFO_BIT_MAP_MASK  &
+		(ctrl_info >> QOS_CTRL_INFO_BIT_MAP_SHIFT);
+	scs_add_req->linkId = QOS_CTRL_INFO_LINKID_MASK &
+		(ctrl_info >> QOS_CTRL_INFO_LINKID_SHIFT);
+
+	if (scs_add_req->bitmapNextParamPresence & BIT(QOS_MAX_MSDU_SIZE)) {
+		os_memcpy(&(scs_add_req->maxMsduSize), pos, sizeof(u16));
+		pos += sizeof(u16); /* Length of maxMsduSize */
+	}
+
+	if (scs_add_req->bitmapNextParamPresence & BIT(QOS_SERVICE_START_TIME)) {
+		os_memcpy(&(scs_add_req->serviceStartTime), pos, sizeof(u32));
+		pos += sizeof(u32); /* Length of serviceStartTime */
+	}
+
+	if (scs_add_req->bitmapNextParamPresence & BIT(QOS_SERVICE_START_TIME_LINK_ID)) {
+		os_memcpy(&(scs_add_req->serviceStartTimeLinkId), pos, sizeof(u8));
+		pos += sizeof(u8); /* Length of serviceStartTimeLinkId */
+	}
+
+	if (scs_add_req->bitmapNextParamPresence & BIT(QOS_MEAN_DATA_RATE)) {
+		os_memcpy(&(scs_add_req->meanDataRate), pos, 3 * sizeof(u8));
+		pos += 3 * sizeof(u8); /* Length of meanDataRate */
+	}
+
+	if (scs_add_req->bitmapNextParamPresence & BIT(QOS_BURST_SIZE)) {
+		os_memcpy(&(scs_add_req->burstSize), pos, sizeof(u32));
+		pos += sizeof(u32); /* Length of burstSize */
+	}
+
+	if (scs_add_req->bitmapNextParamPresence & BIT(QOS_MSDU_LIFE_TIME)) {
+		os_memcpy(&(scs_add_req->msduLifeTime), pos, sizeof(u16));
+		pos += sizeof(u16); /* length of msduLifeTime */
+	}
+
+	if (scs_add_req->bitmapNextParamPresence & BIT(QOS_MSDU_DELIVERY_RATIO)) {
+		os_memcpy(&(scs_add_req->msduDeliveryRatio), pos, sizeof(u8));
+		pos += sizeof(u8); /* Length of msduDeliveryRatio */
+	}
+
+	if (scs_add_req->bitmapNextParamPresence & BIT(QOS_MSDU_COUNT_EXPONENT)) {
+		os_memcpy(&(scs_add_req->msduCountExponent), pos, sizeof(u8));
+		pos += sizeof(u8); /* Length of msduCountExponent */
+	}
+
+	if (scs_add_req->bitmapNextParamPresence & BIT(QOS_MEDIUM_TIME)) {
+		os_memcpy(&(scs_add_req->mediumTime), pos, sizeof(u16));
+		pos += sizeof(u16); /* length of mediumTime */
+	}
+
+	return WLAN_STATUS_SUCCESS;
+}
+
+int mxl_scs_parse_tclas_elems(const u8 *pos, struct mxl_scs_add_req *scs_add_req, size_t len, u8 *elems_num)
+{
+	const u8 *end;
+	u8 class_type, version;
+	u8 mask = 0, tclas_len = 0;
+	bool has_type4 = false, has_type10 = false;
+
+	tclas_len = len;
+	scs_add_req->tclasInfo.tclasLen = tclas_len;
+	scs_add_req->tclasInfo.tclasElemsUp = *pos++; /* populate user priority */
+	len--;
+
+	end = pos + len;
+
+	while (pos < end) {
+		class_type = *pos++;
+		switch (class_type) { /* Classifier type 4 and 10 are allowed */
+			case SCS_CLASSIFIER_TYPE4:
+				mask = *pos++;
+
+				/* Process classifiers frames */
+				if (mask & BIT(SCS_CLASS_TYPE4_VERSION))
+					scs_add_req->type4Params.version = *pos++; /* Version */
+
+				if (scs_add_req->type4Params.version != IPV4 && scs_add_req->type4Params.version != IPV6)
+					return WLAN_STATUS_UNSPECIFIED_FAILURE;
+
+				version = scs_add_req->type4Params.version;
+
+				if (mask & BIT(SCS_CLASS_TYPE4_SRC_IP)) { /* source IP address */
+					if (version == IPV4) {
+						memcpy(&(scs_add_req->type4Params.u.v4.srcIp), pos, sizeof(u32));
+						pos += sizeof(u32);
+					} else {
+						memcpy(scs_add_req->type4Params.u.v6.srcIp, pos, 16);
+						pos += 16;
+					}
+				}
+
+				if (mask & BIT(SCS_CLASS_TYPE4_DST_IP)) { /* Destination IP address */
+					if (version == IPV4) {
+						memcpy(&(scs_add_req->type4Params.u.v4.dstIp), pos, sizeof(u32));
+						pos += sizeof(u32);
+					} else {
+						memcpy(scs_add_req->type4Params.u.v6.dstIp, pos, 16);
+						pos += 16;
+					}
+				}
+
+				if (mask & BIT(SCS_CLASS_TYPE4_SRC_PORT)) { /* Source port */
+					if (version == IPV4) {
+						memcpy(&(scs_add_req->type4Params.u.v4.srcPort), pos, sizeof(u16));
+						pos += sizeof(u16);
+					} else {
+						memcpy(&(scs_add_req->type4Params.u.v6.srcPort), pos, sizeof(u16));
+						pos += sizeof(u16);
+					}
+				}
+
+				if (mask & BIT(SCS_CLASS_TYPE4_DST_PORT)) { /* Dst port */
+					if (version == IPV4) {
+						memcpy(&(scs_add_req->type4Params.u.v4.dstPort), pos, sizeof(u16));
+						pos += sizeof(u16);
+					} else {
+						memcpy(&(scs_add_req->type4Params.u.v6.dstPort), pos, sizeof(u16));
+						pos += sizeof(u16);
+					}
+				}
+
+				if (mask & BIT(SCS_CLASS_TYPE4_DSCP)) { /* DSCP */
+					if (version == IPV4)
+						scs_add_req->type4Params.u.v4.dscp = *pos++;
+					else
+						scs_add_req->type4Params.u.v6.dscp = *pos++;
+				}
+
+				if (mask & BIT(SCS_CLASS_TYPE4_PROTO)) { /* Protocol or next header */
+					if (version == IPV4)
+						scs_add_req->type4Params.u.v4.proto = *pos++;
+					else
+						scs_add_req->type4Params.u.v6.nextHeader = *pos++;
+				}
+
+				if (mask & BIT(SCS_CLASS_TYPE4_FLOW_LABEL)) { /* Flow label only for ipv6 */
+						memcpy(scs_add_req->type4Params.u.v6.flowLabel, pos, 3);
+						pos += 3;
+				}
+
+				has_type4 = true;
+				scs_add_req->tclasInfo.tclasElemstype = 4;
+				elems_num ++;
+				break;
+			 case SCS_CLASSIFIER_TYPE10:
+				scs_add_req->type10Params.protoInstance = *pos++;
+				scs_add_req->type10Params.protoNum = *pos++;
+				scs_add_req->type10Params.filterLen = (tclas_len - 4) / 2;
+				memcpy(scs_add_req->type10Params.filterValue, pos, scs_add_req->type10Params.filterLen);
+				pos += scs_add_req->type10Params.filterLen;
+				memcpy(scs_add_req->type10Params.filterMask, pos, scs_add_req->type10Params.filterLen);
+				pos += scs_add_req->type10Params.filterLen;
+				has_type10 = true;
+				elems_num ++;
+				break;
+			 default:
+				return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+	}
+	/* TCLAS type 10 without TCLAS type 4, one of the illegal class options.
+	 * Not sure on the order of class types , in case if its random i.e class 10
+	 * appears before class 4. So, has_type10 and has_type6 variables are used *
+	 * and the tclas type 10 without tclas 4 is checked after the loop ends */
+	if (has_type10) {
+		if (!has_type4)
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		/* TCLAS type 10 with a protocol different than 17 or 50 is illegal */
+		if (scs_add_req->type10Params.protoInstance != 0 ||
+		    (scs_add_req->type10Params.protoNum != 17 &&
+		    scs_add_req->type10Params.protoNum != 50))
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		if (version == IPV4) {
+			if (scs_add_req->type4Params.u.v4.srcPort != 0)
+				return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+		else if (version == IPV6) {
+			if (scs_add_req->type4Params.u.v6.srcPort != 0)
+				return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+		scs_add_req->tclasInfo.tclasElemstype = 10;
+	}
+	return WLAN_STATUS_SUCCESS;
+}
