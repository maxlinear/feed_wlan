diff --git a/hostapd/mxl_ctrl_iface.c b/hostapd/mxl_ctrl_iface.c
index 28d2b4136..72c0c79b6 100644
--- a/hostapd/mxl_ctrl_iface.c
+++ b/hostapd/mxl_ctrl_iface.c
@@ -3109,6 +3109,34 @@ int mxl_hostapd_ctrl_iface_update_mbss_beacon(struct hostapd_data *hapd)
 	return 0;
 }
 
+#ifdef CONFIG_SCS_MXL
+static int mxl_hostapd_drv_get_scs_enable(struct hostapd_data *hapd, int *enabled)
+{
+	int ret;
+
+	ret = MXL_DRV_VENDOR_GET(LTQ_NL80211_VENDOR_SUBCMD_GET_SCS_ENABLE, NULL, 0, enabled, sizeof(*enabled));
+	if (ret < 0)
+		wpa_printf(MSG_ERROR, "nl80211: sending GET_SCS_ENABLE failed: %i (%s)", ret, strerror(-ret));
+	return ret;
+}
+
+static int mxl_hostapd_ctrl_iface_get_scs_enable(struct hostapd_data *hapd, char *reply, size_t reply_size)
+{
+	int res = 0;
+	int enabled;
+
+	if (mxl_hostapd_drv_get_scs_enable(hapd, &enabled))
+		return -1;
+
+	res = sprintf_s(reply, reply_size, "%d\n", enabled);
+	if (res <= 0) {
+		wpa_printf(MSG_ERROR, "%s: sprintf_s error %d", __func__, res);
+		return -1;
+	}
+
+	return res;
+}
+#endif
 
 int mxl_hostapd_ctrl_iface_receive_process(struct hostapd_data *hapd,
 					      char *buf, char *reply,
@@ -3342,6 +3370,11 @@ int mxl_hostapd_ctrl_iface_receive_process(struct hostapd_data *hapd,
 	} else if (os_strncmp(buf, "BSS_RECONF", 10) == 0) {
 		if (mxl_hostapd_ctrl_iface_bss_reconf(hapd->iface))
 			*reply_len = -1;
+#ifdef CONFIG_SCS_MXL
+	} else if (os_strncmp(buf, "GET_SCS_ENABLE", 14) == 0) {
+		if (mxl_hostapd_ctrl_iface_get_scs_enable(hapd, reply, reply_size) < 0)
+			*reply_len = -1;
+#endif /* CONFIG_SCS */
 	} else {
 		return 0;
 	}
