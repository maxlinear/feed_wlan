+		hapd->iface->mxl_iface.ml_csa_in_progress = true;
+		mxl_set_csa_status_on_all_reporting_link(hapd, true);
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
 	}
 #endif /* defined(CONFIG_IEEE80211BE) */
 	return 0;
