+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+/* Set or reset the csa_on_reporting_link to indicate the CSA complete event should be processed
+ * for reporting link
+ */
+void mxl_set_csa_status_on_all_reporting_link(struct hostapd_data *hapd, bool status)
+{
+	struct hostapd_iface *iface = hapd->iface;
+	unsigned int i;
+
+	for (i = 1; i < iface->num_bss; i++) {
+		struct hostapd_data *lhapd, *h_hapd = iface->bss[i];
+		if (mxl_is_mlo_enabled(h_hapd->conf)) {
+			mxl_mld_for_each_sibling_link(lhapd, h_hapd) {
+				if (!lhapd)
+					continue;
+				lhapd->mxl_data.csa_on_reporting_link = status;
+			}
+		}
+	}
+}
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
