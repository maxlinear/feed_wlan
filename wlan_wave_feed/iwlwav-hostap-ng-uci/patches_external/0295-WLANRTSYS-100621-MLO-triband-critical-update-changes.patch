+static void mxl_clear_channel_switch_occurred(struct hostapd_data *hapd)
+{
+	unsigned int i;
+	struct hostapd_iface *iface = hapd->iface;
+
+	for (i = 0; i < iface->interfaces->count; i++) {
+		if (iface->interfaces->iface[i]->mxl_iface.ml_csa_in_progress) {
+			iface->interfaces->iface[i]->mxl_iface.ml_csa_in_progress = false;
+		}
+	}
+}
+
+/* Check if channel switch completed event received on all reporting links */
+static bool mxl_is_csa_done_on_all_reporting_link(struct hostapd_data *hapd)
+{
+	unsigned int i, j, reporting_link = 0;
+	struct hostapd_iface *iface = hapd->iface;
+
+	for (i = 0; i < iface->interfaces->count; i++) {
+		struct hostapd_iface *h_iface = iface->interfaces->iface[i];
+		for (j = 0; j < h_iface->num_bss; j++) {
+			struct hostapd_data *h_hapd = h_iface->bss[j];
+			if (!mxl_is_mlo_enabled(h_hapd->conf))
+				continue;
+			if (h_hapd->mxl_data.csa_on_reporting_link)
+				reporting_link++;
+		}
+	}
+	return (reporting_link == 0)? true : false;
+}
+
 #define EVENT_CHAN_SWITCH_COUNT_DONE        0
 #define EVENT_MAX_CHAN_SWITCH_TIME_EXPIRY   1
 static void mxl_hostapd_event_ml_csa_done_on_reporting_link(struct hostapd_data *hapd, enum wpa_event_type event)
 {
 	int ret = 0;
 	u32 max_chan_switch_time;
-	struct hostapd_data *sibling_hapd = hapd->mxl_data.sibling_hapd[LINK1]; /* TODO: WLANRTSYS-95653 - Need to handle during the CSA task */
+	struct hostapd_data *lhapd = NULL;
 
-	if (!sibling_hapd) {
-		wpa_printf(MSG_ERROR, "MXL_MLO: mxl_hostapd_event_ml_csa_done_on_reporting_link: sibling_hapd NULL");
+	mxl_mld_for_each_sibling_link(lhapd, hapd) {
+		if (lhapd->iface->mxl_iface.ml_csa_in_progress)
+			break;
+	}
+	if (!lhapd) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: mxl_hostapd_event_ml_csa_done_on_reporting_link: sibling hapd NULL");
 		return;
 	}
 
-	max_chan_switch_time = sibling_hapd->iconf->mxl_conf.max_chan_switch_time;
+	max_chan_switch_time = lhapd->iconf->mxl_conf.max_chan_switch_time;
 	if (event == EVENT_CHAN_SWITCH_COUNT_DONE) {
 		ret = mxl_ml_send_bss_critical_update_info(hapd,
 				ML_BCN_PER_STA_PROF_MAX_SWITCH_TIME, 0, max_chan_switch_time);
@@ -123,6 +158,13 @@ static void mxl_hostapd_event_ml_csa_done_on_reporting_link(struct hostapd_data
 	ieee802_11_set_beacon_per_bss_only(hapd);
 
 	hapd->mxl_data.ml_ie_max_chan_sw_time_ie_len_add = false;
+
+	if (event == EVENT_MAX_CHAN_SWITCH_TIME_EXPIRY) {
+		hapd->mxl_data.csa_on_reporting_link = false;
+		if (mxl_is_csa_done_on_all_reporting_link(hapd)) {
+			mxl_clear_channel_switch_occurred(hapd);
+		}
+	}
 }
 
