From e760cf769e297bf3a92ba7101ba0957651673340 Mon Sep 17 00:00:00 2001
From: akgupta <akgupta@maxlinear.com>
Date: Mon, 1 Apr 2024 11:51:31 +0530
Subject: [PATCH] WLANRTSYS-63318 Adding advertise_ecsa_ie config.

---
 hostapd/ctrl_iface.c      | 11 +++++++++++
 hostapd/mxl_config.c      |  7 +++++++
 hostapd/mxl_ctrl_iface.c  |  2 +-
 hostapd/mxl_hostapd_cli.c |  6 ++++++
 hostapd/mxl_hostapd_cli.h |  3 +++
 src/ap/hostapd.c          |  8 +++++++-
 src/ap/mxl_config.h       |  1 +
 src/ap/mxl_hostapd.c      | 30 +++++++++++++++++++++++++++---
 8 files changed, 63 insertions(+), 5 deletions(-)

diff --git a/hostapd/ctrl_iface.c b/hostapd/ctrl_iface.c
index 6cca86a0d..b409c42d0 100644
--- a/hostapd/ctrl_iface.c
+++ b/hostapd/ctrl_iface.c
@@ -3161,6 +3161,17 @@ static int hostapd_ctrl_iface_chan_switch(struct hostapd_iface *iface,
 
 	iface->block_tx = false;
 	if (dfs_range) {
+#ifdef CONFIG_IEEE80211BE_MXL_MLO
+		struct hostapd_data *hapd = NULL;
+		int j, mlo_enable = 0;
+		for (j = 0; j < iface->num_bss; j++) {
+			hapd = iface->bss[j];
+			if (hapd->conf->mxl_bss_conf.mlo_enable) {
+				mlo_enable = 1;
+				break;
+			}
+		}
+#endif /* CONFIG_IEEE80211BE_MXL_MLO */
 		ret = ieee80211_freq_to_chan(settings.freq_params.freq, &chan);
 		if (ret == NUM_HOSTAPD_MODES) {
 			wpa_printf(MSG_ERROR,
diff --git a/hostapd/mxl_config.c b/hostapd/mxl_config.c
index dd760d8c7..048b5503a 100644
--- a/hostapd/mxl_config.c
+++ b/hostapd/mxl_config.c
@@ -1420,6 +1420,13 @@ mxl_conf_fill_be(struct hostapd_config *conf, const char *buf, char *pos, int li
 				return 0;
 			}
 			mxl_conf->rnr_6g_op_class_137_allowed = val;
+	} else if (os_strcmp(buf, "advertise_ecsa_ie") == 0) {
+		int val = atoi(pos);
+		if (!IS_VALID_BOOL_RANGE(val)) {
+			wpa_printf(MSG_ERROR, "Line %d: invalid advertise_ecsa_ie %d (expected 0 or 1)",line, val);
+			return 0;
+		}
+		mxl_conf->advertise_ecsa_ie = val;
 	} else if (os_strcmp(buf, "max_chan_switch_time") == 0) {
 		int val = atoi(pos);
 		if (!IS_VALID_RANGE(val, MAX_CHAN_SWITCH_TIME_MIN, MAX_CHAN_SWITCH_TIME_MAX)) {
diff --git a/hostapd/mxl_ctrl_iface.c b/hostapd/mxl_ctrl_iface.c
index 70096788f..4880a99e4 100644
--- a/hostapd/mxl_ctrl_iface.c
+++ b/hostapd/mxl_ctrl_iface.c
@@ -2861,7 +2861,7 @@ static int mxl_hostapd_ctrl_iface_send_t2lm_teardown_frame(struct hostapd_data *
 {
 	u8 addr[ETH_ALEN];
 
-	hapd = mxl_get_bss_index(&cmd, hapd, true, true);
+	hapd = mxl_get_bss_index(&cmd, hapd, true, false);
 	if (NULL == hapd) {
 		wpa_printf(MSG_ERROR, "CTRL: SEND_T2LM_TEARDOWN_FRAME - there is no iface with the given name");
 		return -1;
diff --git a/hostapd/mxl_hostapd_cli.c b/hostapd/mxl_hostapd_cli.c
index 6ca2a0e78..03c126862 100644
--- a/hostapd/mxl_hostapd_cli.c
+++ b/hostapd/mxl_hostapd_cli.c
@@ -437,4 +437,10 @@ int mxl_hostapd_cli_cmd_ml_bss_critical_update(struct wpa_ctrl *ctrl, int argc,
 {
 	return mxl_wpa_ctrl_command(ctrl, "ML_BSS_CRITICAL_UPDATE");
 }
+
+int mxl_hostapd_cli_cmd_send_t2lm_teardown_frame(struct wpa_ctrl *ctrl, int argc,
+                                                    char *argv[])
+{
+	return mxl_hostapd_cli_cmd(ctrl, "SEND_T2LM_TEARDOWN_FRAME", 2, argc, argv);
+}
 #endif /* CONFIG_IEEE80211BE_MXL_MLO */
diff --git a/hostapd/mxl_hostapd_cli.h b/hostapd/mxl_hostapd_cli.h
index d28621a5d..468b96fe0 100644
--- a/hostapd/mxl_hostapd_cli.h
+++ b/hostapd/mxl_hostapd_cli.h
@@ -108,10 +108,13 @@ int mxl_hostapd_cli_cmd_send_epcs_req_frame(struct wpa_ctrl *ctrl, int argc, cha
 #endif /* CONFIG_EPCS_MXL */
 #ifdef CONFIG_IEEE80211BE_MXL_MLO
 int mxl_hostapd_cli_cmd_ml_bss_critical_update(struct wpa_ctrl *ctrl, int argc, char *argv[]);
+int mxl_hostapd_cli_cmd_send_t2lm_teardown_frame(struct wpa_ctrl *ctrl, int argc, char *argv[]);
 
 #define MXL_CLI_COMMANDS_MLO \
 	{ "ml_bss_critical_update", mxl_hostapd_cli_cmd_ml_bss_critical_update, NULL, \
 	  " = ml_bss_critical_update" }, \
+	{ "send_t2lm_teardown_frame", mxl_hostapd_cli_cmd_send_t2lm_teardown_frame, NULL, \
+	  "<bss> <mac_addr>" }, \
 
 #else
 #define MXL_CLI_COMMANDS_MLO
diff --git a/src/ap/hostapd.c b/src/ap/hostapd.c
index b84d42d48..af1876a22 100644
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -2762,7 +2762,13 @@ static int setup_interface(struct hostapd_iface *iface)
 #ifdef CONFIG_VENDOR_MXL
 	if (mxl_hostapd_setup_interface(hapd))
 		return -1;
-#endif
+
+	/* Enable background CAC by default for WAV700 */
+	if (iface->drv_flags2 & WPA_DRIVER_FLAGS2_RADAR_BACKGROUND) {
+		wpa_printf(MSG_DEBUG, "Enabling background_CAC\n");
+		iface->conf->mxl_conf.background_cac = 1;
+	}
+#endif /* CONFIG_VENDOR_MXL */
 
 	if (hapd->iconf->country[0] && hapd->iconf->country[1]) {
 		char country[4], previous_country[4];
diff --git a/src/ap/mxl_config.h b/src/ap/mxl_config.h
index 5dcbc5f40..b3b6ed455 100644
--- a/src/ap/mxl_config.h
+++ b/src/ap/mxl_config.h
@@ -338,6 +338,7 @@ struct mxl_hostapd_config {
 	int eht_mld_tsf_diff;
 	u8 rnr_tbtt_mld_non_zero_pad;
 	bool rnr_6g_op_class_137_allowed;
+	bool advertise_ecsa_ie;
 	u32 max_chan_switch_time;
 #endif /* CONFIG_IEEE80211BE_MXL_MLO */
 #endif /* CONFIG_IEEE80211BE */
diff --git a/src/ap/mxl_hostapd.c b/src/ap/mxl_hostapd.c
index 34e1fc566..c87c580c8 100644
--- a/src/ap/mxl_hostapd.c
+++ b/src/ap/mxl_hostapd.c
@@ -2665,10 +2665,34 @@ int mxl_switch_channel(struct hostapd_data *hapd, struct csa_settings *settings)
 		settings->block_tx = 1;
 
 #ifdef CONFIG_IEEE80211BE_MXL_MLO
-	u8 op_class = 0;
+	u8 op_class = 0, channel, bandwidth;
 	int ret;
-	if (is_6ghz_op_class(hapd->iconf->op_class))
-		op_class = hapd->iconf->op_class;
+	if (is_6ghz_op_class(hapd->iconf->op_class) || hapd->iconf->mxl_conf.advertise_ecsa_ie) {
+		switch (settings->freq_params.bandwidth) {
+			case 80:
+				if (settings->freq_params.center_freq2)
+					bandwidth = CONF_OPER_CHWIDTH_80P80MHZ;
+				else
+					bandwidth = CONF_OPER_CHWIDTH_80MHZ;
+				break;
+			case 160:
+				bandwidth = CONF_OPER_CHWIDTH_160MHZ;
+				break;
+			case 320:
+				bandwidth = CONF_OPER_CHWIDTH_320MHZ;
+				break;
+			default:
+				bandwidth = CONF_OPER_CHWIDTH_USE_HT;
+				break;
+		}
+		if (ieee80211_freq_to_channel_ext(settings->freq_params.freq,
+		    settings->freq_params.sec_channel_offset,
+		    bandwidth,
+		    &op_class, &channel) == NUM_HOSTAPD_MODES) {
+			wpa_printf(MSG_ERROR, "ieee80211_freq_to_channel_ext failed in mxl_switch_channel!");
+			return -1;
+		}
+	}
 
 	ret = mxl_ml_send_bss_critical_update_info(hapd, 0, op_class, 0);
 	if (ret) {
-- 
