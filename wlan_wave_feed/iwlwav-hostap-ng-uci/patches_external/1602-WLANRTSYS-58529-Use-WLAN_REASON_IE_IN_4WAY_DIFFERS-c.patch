From 9835cfc09ea8206b60da1c8f2e5a6103896016bd Mon Sep 17 00:00:00 2001
From: Dmitrijs Martinovs <dmartinovs@maxlinear.com>
Date: Thu, 14 Sep 2023 10:39:12 +0200
Subject: [PATCH] WLANRTSYS-58529: Use WLAN_REASON_IE_IN_4WAY_DIFFERS code in
 4-Way Handshake

---
 src/ap/wpa_auth.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/ap/wpa_auth.c b/src/ap/wpa_auth.c
index 44ef8639d..9df3f5c21 100644
--- a/src/ap/wpa_auth.c
+++ b/src/ap/wpa_auth.c
@@ -3920,7 +3920,7 @@ SM_STATE(WPA_PTK, PTKCALCNEGOTIATING)
 			    eapol_key_ie, eapol_key_ie_len);
 		/* MLME-DEAUTHENTICATE.request */
 		wpa_sta_disconnect(wpa_auth, sm->addr,
-				   WLAN_REASON_PREV_AUTH_NOT_VALID);
+				   WLAN_REASON_IE_IN_4WAY_DIFFERS);
 		goto out;
 	}
 	if ((!sm->rsnxe && kde.rsnxe) ||
@@ -3936,7 +3936,7 @@ SM_STATE(WPA_PTK, PTKCALCNEGOTIATING)
 			    kde.rsnxe, kde.rsnxe_len);
 		/* MLME-DEAUTHENTICATE.request */
 		wpa_sta_disconnect(wpa_auth, sm->addr,
-				   WLAN_REASON_PREV_AUTH_NOT_VALID);
+				   WLAN_REASON_IE_IN_4WAY_DIFFERS);
 		goto out;
 	}
 #ifdef CONFIG_OCV
-- 
2.43.0

