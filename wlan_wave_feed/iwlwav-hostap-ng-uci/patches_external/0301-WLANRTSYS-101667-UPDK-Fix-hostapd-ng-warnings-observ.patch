From 62326c457353921a28f2f3aeda9ba506ef5caf41 Mon Sep 17 00:00:00 2001
From: "mujiburrahimank@maxlinear.com"
 <mujiburrahimank@lvdocker7.lvsw.maxlinear.com>
Date: Sun, 3 May 2026 23:35:08 -0700
Subject: [PATCH] WLANRTSYS-101667 [UPDK] Fix hostapd-ng warnings observed
 after up-step

Recent up-step builds report hostapd-ng compiler warnings, which can hide real issues. This change removes the warning sources so builds stay clean and easier to review.

The update addresses:

missing forward declaration for struct wpa_ctrl in CLI prototypes,
an unused local variable in MLD CSA cleanup flow,
an unused static color-change handler under 11ax build conditions.
This is a warning-cleanup change only and does not alter runtime behavior or feature logic.
---
 hostapd/mxl_hostapd_cli.h | 2 ++
 src/ap/drv_callbacks.c    | 2 ++
 src/ap/mxl_mld.c          | 1 -
 3 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/hostapd/mxl_hostapd_cli.h b/hostapd/mxl_hostapd_cli.h
index f69d8c98d..01fc07426 100644
--- a/hostapd/mxl_hostapd_cli.h
+++ b/hostapd/mxl_hostapd_cli.h
@@ -14,6 +14,8 @@
 #ifndef MXL_HOSTAPD_CLI_H
 #define MXL_HOSTAPD_CLI_H
 
+#include "common/wpa_ctrl.h"
+
 int mxl_hostapd_cli_cmd(struct wpa_ctrl *ctrl, const char *cmd, int min_args, int argc, char *argv[]);
 int mxl_hostapd_cli_cmd_accept_macacl(struct wpa_ctrl *ctrl, int argc, char *argv[]);
 int mxl_hostapd_cli_cmd_deny_macacl(struct wpa_ctrl *ctrl, int argc, char *argv[]);
diff --git a/src/ap/drv_callbacks.c b/src/ap/drv_callbacks.c
index 08c7246fe..6613f54b9 100644
--- a/src/ap/drv_callbacks.c
+++ b/src/ap/drv_callbacks.c
@@ -2653,6 +2653,7 @@ static void hostapd_eapol_tx_status(struct hostapd_data *hapd, const u8 *dst,
 
 
 #ifdef CONFIG_IEEE80211AX
+#ifndef CONFIG_VENDOR_MXL
 static void hostapd_event_color_change(struct hostapd_data *hapd, bool success)
 {
 	struct hostapd_data *bss;
@@ -2675,6 +2676,7 @@ static void hostapd_event_color_change(struct hostapd_data *hapd, bool success)
 		}
 	}
 }
+#endif /* CONFIG_VENDOR_MXL */
 #endif  /* CONFIG_IEEE80211AX */
 
 
diff --git a/src/ap/mxl_mld.c b/src/ap/mxl_mld.c
index 672fc75bc..ac0758067 100644
--- a/src/ap/mxl_mld.c
+++ b/src/ap/mxl_mld.c
@@ -3061,7 +3061,6 @@ error:
 
 void mxl_cleanup_ml_csa_params(struct hostapd_iface *iface)
 {
-	struct hostapd_iface *other_iface;
 	struct hostapd_data *bss, *lhapd;
 	struct p_ap_mld *mld = NULL;
 	int i;
-- 
