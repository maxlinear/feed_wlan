From 23bbbb922e02b0ab1ff9891cc80b2b01cd24cef7 Mon Sep 17 00:00:00 2001
From: nchernikov <nchernikov@maxlinear.com>
Date: Sun, 18 Jan 2026 14:18:42 +0200
Subject: [PATCH] WLANRTSYS-100259 Use OS tx_bss_auth for Beacon Protection
 when setting bigtk key and requesting pn

Signed-off-by: nchernikov <nchernikov@maxlinear.com>
---
 src/ap/mxl_hostapd.c   | 12 ++++++++++++
 src/ap/mxl_hostapd.h   |  1 +
 src/ap/wpa_auth_glue.c |  4 ++++
 3 files changed, 17 insertions(+)

diff --git a/src/ap/mxl_hostapd.c b/src/ap/mxl_hostapd.c
index c3dcd03aa..dc73fcecb 100644
--- a/src/ap/mxl_hostapd.c
+++ b/src/ap/mxl_hostapd.c
@@ -3644,6 +3644,18 @@ size_t mxl_hostapd_get_mbssid_tx_bss_idx(struct hostapd_iface *iface)
 	return MULTIBSS_REFERENCE_BSS_IDX;
 }
 
+struct hostapd_data *mxl_hostapd_mbssid_get_tx_bss(struct hostapd_data *hapd)
+{
+	size_t tx_bss_idx;
+
+	if (hapd->iconf->multibss_enable) {
+		tx_bss_idx = mxl_hostapd_get_mbssid_tx_bss_idx(hapd->iface);
+		return hapd->iface->bss[tx_bss_idx];
+	}
+
+	return hapd;
+}
+
 void mxl_print_acs_state(struct hostapd_iface *iface)
 {
 #ifdef CONFIG_VENDOR_MXL_PROPRIETARY
diff --git a/src/ap/mxl_hostapd.h b/src/ap/mxl_hostapd.h
index 239eb7067..68bbbc17d 100644
--- a/src/ap/mxl_hostapd.h
+++ b/src/ap/mxl_hostapd.h
@@ -374,6 +374,7 @@ void mxl_hostapd_check_limit_reached(struct hostapd_data *hapd, const u8 *sta_ad
 int mxl_hostapd_check_and_reorder_bss_conf(struct hostapd_iface *iface, struct hostapd_config *newconf);
 struct hostapd_data *mxl_hostapd_get_setup_mbssid_bss(struct hostapd_iface *iface, size_t idx);
 size_t mxl_hostapd_get_mbssid_tx_bss_idx(struct hostapd_iface *iface);
+struct hostapd_data *mxl_hostapd_mbssid_get_tx_bss(struct hostapd_data *hapd);
 void mxl_acs_clear_second_bg_cac_param(struct hostapd_iface *iface);
 int mxl_hostapd_ieee80211n_check_40mhz_wrap(struct hostapd_iface *iface);
 void mxl_dynamic_wmm_param_init_wrap(struct hostapd_data *hapd);
diff --git a/src/ap/wpa_auth_glue.c b/src/ap/wpa_auth_glue.c
index 3f8afcc3f..b85966e86 100644
--- a/src/ap/wpa_auth_glue.c
+++ b/src/ap/wpa_auth_glue.c
@@ -44,7 +44,11 @@ static void hostapd_wpa_auth_config_update(struct hostapd_data *hapd,
 	struct hostapd_data *tx_bss;
 
 	_conf->msg_ctx = hapd->msg_ctx;
+#ifdef CONFIG_VENDOR_MXL
+	tx_bss = mxl_hostapd_mbssid_get_tx_bss(hapd);
+#else
 	tx_bss = hostapd_mbssid_get_tx_bss(hapd);
+#endif /* CONFIG_VENDOR_MXL */
 	if (tx_bss != hapd)
 		_conf->tx_bss_auth = tx_bss->wpa_auth;
 	if (hapd->iface->drv_flags & WPA_DRIVER_FLAGS_EAPOL_TX_STATUS)
-- 
2.43.0

