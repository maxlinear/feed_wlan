+++ b/src/ap/ctrl_iface_ap.c
@@ -646,6 +646,11 @@ int hostapd_ctrl_iface_deauthenticate(struct hostapd_data *hapd,
 
 	if (os_strstr(txtaddr, " tx=0"))
