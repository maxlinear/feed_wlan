 static bool mxl_acs_is_freq_rule_present_parse_power(struct hostapd_iface *iface, int start_freq, int end_freq, int bw, int *tx) {
-	int afc_bw =0;
+	int best_bw = INT_MAX;
+	int best_eirp = INT_MAX;
+	bool found = false;
+	int best_freq_idx = -1;
+
 	for (int freq_idx = 0; freq_idx < iface->afc.num_freq_range; freq_idx++) {
-		afc_bw = iface->afc.freq_range[freq_idx].high_freq - iface->afc.freq_range[freq_idx].low_freq;
+		int afc_bw = iface->afc.freq_range[freq_idx].high_freq - iface->afc.freq_range[freq_idx].low_freq;
+		int eirp;
+
 		if (!afc_bw)
 			continue;
-		if(start_freq >= iface->afc.freq_range[freq_idx].low_freq && end_freq <= iface->afc.freq_range[freq_idx].high_freq && bw == afc_bw) {
-			*tx = mxl_afc_calculate_psd_to_eirp(iface->afc.freq_range[freq_idx].max_psd,afc_bw);
-			return true;
+
+		if (start_freq < iface->afc.freq_range[freq_idx].low_freq ||
+		    end_freq > iface->afc.freq_range[freq_idx].high_freq)
+			continue;
+
+		/*
+		 * Match driver BW-aware AFC selection:
+		 * choose the narrowest covering rule with max_bw >= requested BW,
+		 * and for same BW choose the lower EIRP.
+		 */
+		if (afc_bw < bw)
+			continue;
+
+		eirp = (int)mxl_afc_calculate_psd_to_eirp(iface->afc.freq_range[freq_idx].max_psd, afc_bw);
+		wpa_printf(MSG_DEBUG,
+			"AFC-BW: candidate rule idx=%d req_bw=%d rule_bw=%d req=[%d,%d] rule=[%d,%d] eirp=%d",
+			freq_idx, bw, afc_bw, start_freq, end_freq,
+			iface->afc.freq_range[freq_idx].low_freq,
+			iface->afc.freq_range[freq_idx].high_freq,
+			eirp);
+		if (!found || afc_bw < best_bw || (afc_bw == best_bw && eirp < best_eirp)) {
+			best_bw = afc_bw;
+			best_eirp = eirp;
+			found = true;
+			best_freq_idx = freq_idx;
+			wpa_printf(MSG_DEBUG,
+				"AFC-BW: best rule updated idx=%d selected_bw=%d selected_eirp=%d",
+				best_freq_idx, best_bw, best_eirp);
 		}
 	}
-	return false;
+
+	if (found) {
+		wpa_printf(MSG_DEBUG,
+			"AFC-BW: final selection idx=%d req_bw=%d selected_bw=%d selected_eirp=%d",
+			best_freq_idx, bw, best_bw, best_eirp);
+		*tx = best_eirp;
+	}
+	else {
+		wpa_printf(MSG_DEBUG,
+			"AFC-BW: no matching freq rule req_bw=%d req_range=[%d,%d]",
+			bw, start_freq, end_freq);
+	}
+
+	return found;
 }
 
 static void mxl_acs_if_afc_rule_present_parse_power(struct hostapd_iface *iface, int center_chan_idx, int bw_start, int bw_end, int bw, int *tx)
@@ -3314,6 +3360,8 @@ static void mxl_acs_tx_power_update(struct hostapd_iface *iface)
 
 	for (i = 0; (i < iface->mxl_iface.num_candidates && i < MAX_CANDIDATES); i++) {
