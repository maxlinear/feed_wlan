 			candidates[i].tx_power[SEC_MAX_160] += 9; /* compensation factor eight channels */
@@ -3336,7 +3384,7 @@ static void mxl_acs_tx_power_update(struct hostapd_iface *iface)
 			if ((new_power = mxl_acs_get_chan_id_freq_range_sec_tx(iface, sub_freq, candidates[i].primary, 20, &sub_freq)) != 0) candidates[i].tx_power[SEC_20] = new_power;
 		}
 		if (candidates[i].width ==  40) {
-			if ((new_power = mxl_acs_get_chan_id_freq_range_sec_tx(iface, sub_freq, candidates[i].primary, 20, &sub_freq)) != 0) candidates[i].tx_power[SEC_20] = new_power;
+			if ((new_power = mxl_acs_get_chan_id_freq_range_sec_tx(iface, candidates[i].freq, candidates[i].primary, 20, &sub_freq)) != 0) candidates[i].tx_power[SEC_20] = new_power;
 		}
 		if ((new_power = mxl_acs_if_afc_rule_present_parse_power_pri20(iface, candidates[i].primary)) != 0) candidates[i].tx_power[PRI_20] = new_power;
 	}
@@ -3832,19 +3880,15 @@ int mxl_acs_recalc_ranks_and_set_chan (struct hostapd_iface *iface, int switch_r
 
 	}
 
-#ifdef CONFIG_AFC
-	if (!iface->mxl_iface.sec_best_ch.flag && !iface->afc.acs_pwr_mode_6g) {
-#else /* CONFIG_AFC */
 	if (!iface->mxl_iface.sec_best_ch.flag) {
-#endif /* CONFIG_AFC */
-		if ((!iface->conf->mxl_conf.acs_bg_scan_do_switch && (SWR_BG_SCAN == switch_reason)) ||
-		    iface->mxl_iface.cac_required || !(iface->conf->mxl_conf.acs_init_done)) {
-			wpa_printf(MSG_DEBUG, "ACS: stay on channel reason SWR_BG_SCAN switch not enabled or cac required or acs init not done");
+		if (!iface->conf->mxl_conf.acs_update_do_switch && (SWR_UPDATE == switch_reason)) {
+			wpa_printf(MSG_DEBUG, "ACS: stay on channel reason SWR_UPDATE switch not enabled");
 			goto stay_on_chan;
 		}
 
-		if (!iface->conf->mxl_conf.acs_update_do_switch && (SWR_UPDATE == switch_reason)) {
-			wpa_printf(MSG_DEBUG, "ACS: stay on channel reason SWR_UPDATE switch not enabled");
+		if ((!iface->conf->mxl_conf.acs_bg_scan_do_switch && (SWR_BG_SCAN == switch_reason)) ||
+		    iface->mxl_iface.cac_required || !(iface->conf->mxl_conf.acs_init_done)) {
+			wpa_printf(MSG_DEBUG, "ACS: stay on channel reason SWR_BG_SCAN switch not enabled or cac required or acs init not done");
 			goto stay_on_chan;
 		}
 	}
