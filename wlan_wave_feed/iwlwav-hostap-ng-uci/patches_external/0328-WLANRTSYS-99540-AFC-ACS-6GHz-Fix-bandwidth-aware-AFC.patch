 src/ap/hostapd.h     |  1 -
 src/ap/mxl_acs.c     | 79 +++++++++++++++++++++++++++++++++++---------
 src/ap/mxl_afc.c     |  6 ++--
 src/ap/mxl_hostapd.c |  4 ---
 5 files changed, 65 insertions(+), 27 deletions(-)

