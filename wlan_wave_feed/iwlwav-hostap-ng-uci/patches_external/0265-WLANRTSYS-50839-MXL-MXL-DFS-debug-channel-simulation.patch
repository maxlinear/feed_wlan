+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	return mxl_hostapd_handle_dfs_debug_pre_cac(iface);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return false;
+}
+
+void mxl_hostapd_handle_dfs_debug_post_cac_wrap(struct hostapd_iface *iface, int res) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	mxl_hostapd_handle_dfs_debug_post_cac(iface, res);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return;
+}
+
+int mxl_hostapd_handle_dfs_debug_wrap(struct hostapd_iface *iface, int res, int start_chan_idx, int n_chans) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	return mxl_hostapd_handle_dfs_debug(iface, res, start_chan_idx, n_chans);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return res;
+}
+
+bool mxl_is_dfs_debug_chan(struct hostapd_iface *iface) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	return !(iface->conf->mxl_conf.dfs_debug_chan);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return false;
+}
+
+void mxl_hostapd_handle_dfs_debug_pre_csa_wrap(struct hostapd_iface *iface, struct csa_settings *csa_settings) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	mxl_hostapd_handle_dfs_debug_pre_csa(iface, csa_settings);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return;
+}
+
+bool mxl_hostapd_handle_dfs_debug_post_csa_wrap(struct hostapd_data *hapd, int freq, int width, int cf1, int channel) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	return mxl_hostapd_handle_dfs_debug_post_csa(hapd, freq, width, cf1, channel);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return false;
+}
+
+void mxl_hostapd_handle_dfs_debug_cac_event_wrap(struct hostapd_iface *iface) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	mxl_hostapd_handle_dfs_debug_cac_event(iface);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return;
+}
+
+bool mxl_hostapd_handle_dfs_debug_radar_wrap(struct hostapd_iface *iface) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	return mxl_hostapd_handle_dfs_debug_radar(iface);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return false;
+}
+
+void mxl_hostapd_send_dfs_debug_channel_flag_wrap(struct hostapd_iface *iface) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	mxl_hostapd_send_dfs_debug_channel_flag(iface);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return;
+}
+
+void mxl_hostapd_cleanup_dfs_debug_cac_wrap(struct hostapd_iface *iface) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+	mxl_hostapd_cleanup_dfs_debug_cac(iface);
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+	return;
+}
