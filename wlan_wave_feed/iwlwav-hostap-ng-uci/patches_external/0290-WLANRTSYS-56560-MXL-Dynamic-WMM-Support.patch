+void mxl_update_dynamic_wmm_params_elem(struct hostapd_data *hapd, struct hostapd_wmm_ac_params *wmmp) {
+	/* Update WMM parameters from driver */
+	int e;
+	if (hapd->iconf->mxl_conf.dynamic_wmm || hapd->iconf->mxl_conf.dynamic_edca) {
+		for (e = 0; e < WMM_AC_NUM; e++) {
+			if (-1 == hapd->mxl_dynamic_wmm_params.dynamic_wmm_params[e].cwmin) /* not updated by driver */
+				continue;
+
+			wmmp[e].aifs = hapd->mxl_dynamic_wmm_params.dynamic_wmm_params[e].aifs;
+			wmmp[e].cwmin = hapd->mxl_dynamic_wmm_params.dynamic_wmm_params[e].cwmin;
+			wmmp[e].cwmax = hapd->mxl_dynamic_wmm_params.dynamic_wmm_params[e].cwmax;
+			wmmp[e].txop_limit = hapd->mxl_dynamic_wmm_params.dynamic_wmm_params[e].txop_limit;
+		}
+	}
+	return;
+}
