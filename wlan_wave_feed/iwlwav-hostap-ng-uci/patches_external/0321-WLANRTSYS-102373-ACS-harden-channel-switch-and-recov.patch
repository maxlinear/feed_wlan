From b0de2d8fa44583e639bb35ff19a3af71eab23106 Mon Sep 17 00:00:00 2001
From: "mujiburrahimank@maxlinear.com"
 <mujiburrahimank@lvdocker7.lvsw.maxlinear.com>
Date: Wed, 3 Jun 2026 22:30:14 -0700
Subject: [PATCH] WLANRTSYS-102373 ACS harden channel switch and recovery paths

Issue:
ACS/ZWDFS flows may attempt CSA with invalid channel 0, and ACS restart/bgscan/country-change paths can leave runtime channel state inconsistent on failure.

Fix:

 -Preserve current primary channel for live interface ACS start and restore it on failure.
 -Reject CSA when primary channel is 0.
 -Reject CSA when freq_params channel is 0.
 -Defer country-change ACS restart when regdom changes during active ACS and re-trigger safely after scan.
 -In bgscan ACS failure path, restore op_class and clear acs_reenable_iface.
 -Add ZWDFS guard to refuse channel switch with invalid primary channel 0.

Fixup : WLANRTSYS-50170 MXL Smart ACS implementation
---
 hostapd/mxl_ctrl_iface.c | 19 ++++++++++--
 src/ap/mxl_acs.c         | 63 +++++++++++++++++++++++++++++++---------
 src/ap/mxl_hostapd.h     |  1 +
 src/ap/mxl_zwdfs.c       |  6 ++++
 4 files changed, 73 insertions(+), 16 deletions(-)

diff --git a/hostapd/mxl_ctrl_iface.c b/hostapd/mxl_ctrl_iface.c
index e4fafefc9..bc38687b8 100644
--- a/hostapd/mxl_ctrl_iface.c
+++ b/hostapd/mxl_ctrl_iface.c
@@ -4804,9 +4804,13 @@ int mxl_hostapd_ctrl_iface_acs_start(struct hostapd_iface *iface, enum chan_widt
 	enum oper_chan_width chwidth;
 	bool bgscan = iface->mxl_iface.acs_bgscan_enable;
 	int acs_bgscan_interval = iface->conf->mxl_conf.acs_bgscan_interval;
+	int saved_channel = iface->conf->channel;
 
 	acs_bgscan_interval *= 60;
-	iface->conf->channel = 0;
+	/* Keep current primary channel on live interfaces in case ACS fails. */
+	if (iface->state == HAPD_IFACE_DISABLED ||
+	    iface->state == HAPD_IFACE_COUNTRY_UPDATE)
+		iface->conf->channel = 0;
 
 	if (bw != CHAN_WIDTH_UNKNOWN) {
 		iface->conf->secondary_channel = 0;
@@ -4861,7 +4865,18 @@ int mxl_hostapd_ctrl_iface_acs_start(struct hostapd_iface *iface, enum chan_widt
 		}
 	}
 
-	return mxl_acs_start(iface);
+	if (mxl_acs_start(iface) < 0) {
+		if (iface->state == HAPD_IFACE_ENABLED ||
+		    iface->state == HAPD_IFACE_ACS ||
+		    iface->state == HAPD_IFACE_DFS ||
+		    iface->state == HAPD_IFACE_ACS_DONE) {
+			iface->conf->channel = saved_channel;
+			iface->mxl_iface.acs_reenable_iface = 0;
+		}
+		return -1;
+	}
+
+	return 0;
 }
 
 int mxl_hostapd_ctrl_iface_get_dynamic_failsafe(struct hostapd_data *hapd, char *cmd, char *buf, size_t buflen, int *reply_len)
diff --git a/src/ap/mxl_acs.c b/src/ap/mxl_acs.c
index 5561ead2b..fd72b6130 100644
--- a/src/ap/mxl_acs.c
+++ b/src/ap/mxl_acs.c
@@ -2576,6 +2576,12 @@ int mxl_acs_do_switch_channel(struct hostapd_iface *iface, int block_tx)
 			hostapd_get_oper_centr_freq_seg0_idx(iface->conf),
 			hostapd_get_oper_centr_freq_seg1_idx(iface->conf));
 
+	if (!iface->conf->channel) {
+		wpa_printf(MSG_ERROR,
+			   "ACS: refusing CSA with invalid primary channel 0");
+		return -1;
+	}
+
 	/* Setup CSA request */
 	os_memset(&csa_settings, 0, sizeof(csa_settings));
 	csa_settings.cs_count = mxl_hostapd_get_cs_count(iface);
@@ -2608,6 +2614,12 @@ int mxl_acs_do_switch_channel(struct hostapd_iface *iface, int block_tx)
 		return -1;
 	}
 
+	if (!csa_settings.freq_params.channel) {
+		wpa_printf(MSG_ERROR,
+			   "ACS: refusing CSA with invalid freq params channel 0");
+		return -1;
+	}
+
 	hostapd_prepare_and_send_csa_deauth_cfg_to_driver(iface->bss[0]);
 
 	for (i = 0; i < iface->num_bss; i++) {
@@ -5003,6 +5015,15 @@ void mxl_event_scan_results(struct hostapd_data *hapd, union wpa_event_data *dat
 
 	if (hapd->iface->conf->acs && mxl_acs_is_smart(hapd->iface) && !hapd->iface->conf->mxl_conf.acs_init_done) {
 		mxl_acs_recalc_ranks_and_set_chan(hapd->iface, SWR_BG_SCAN);
+
+		if (hapd->iface->mxl_iface.acs_restart_on_country_change) {
+			wpa_printf(MSG_INFO, "ACS: Country changed during scan, re-triggering ACS with new regulatory domain");
+			hapd->iface->mxl_iface.acs_restart_on_country_change = 0;
+			hapd->iface->conf->mxl_conf.acs_init_done = 0;
+			hapd->iface->conf->channel = 0;
+			if (mxl_acs_start(hapd->iface))
+				wpa_printf(MSG_INFO, "ACS: Failed to re-trigger ACS after country change");
+		}
 	}
 
 	if (hapd->iface->mxl_iface.cac_required){
@@ -5100,21 +5121,29 @@ int mxl_hostapd_check_and_abort_scan(struct hostapd_iface *iface)
 int mxl_hostapd_change_country(struct hostapd_iface *iface, struct channel_list_changed *info)
 {
 #ifdef CONFIG_ACS
-	if (mxl_acs_is_smart(iface) && iface->conf->mxl_conf.acs_init_done) {
-		wpa_printf(MSG_INFO, "Regdom change: will reset candidates and re-trigger ACS");
-		iface->conf->mxl_conf.acs_init_done = 0;
-		iface->conf->channel = 0;
+	if (mxl_acs_is_smart(iface)) {
+		if (iface->conf->mxl_conf.acs_init_done) {
+			wpa_printf(MSG_INFO, "Regdom change: will reset candidates and re-trigger ACS");
+			iface->conf->mxl_conf.acs_init_done = 0;
+			iface->conf->channel = 0;
 
-		iface->conf->country[0] = info->alpha2[0];
-		iface->conf->country[1] = info->alpha2[1];
+			iface->conf->country[0] = info->alpha2[0];
+			iface->conf->country[1] = info->alpha2[1];
 
-		iface->whm_if_fail = false;
-		if (hostapd_disable_iface(iface) < 0)
-			return -1;
+			iface->whm_if_fail = false;
+			if (hostapd_disable_iface(iface) < 0)
+				return -1;
 
-		if (hostapd_enable_iface(iface) < 0)
-			return -1;
-		return 0;
+			if (hostapd_enable_iface(iface) < 0)
+				return -1;
+			return 0;
+		} else if (iface->state == HAPD_IFACE_ACS) {
+			wpa_printf(MSG_INFO, "Regdom change during ACS: deferring ACS re-trigger");
+			iface->conf->country[0] = info->alpha2[0];
+			iface->conf->country[1] = info->alpha2[1];
+			iface->mxl_iface.acs_restart_on_country_change = 1;
+			return 0;
+		}
 	}
 #endif
 	return 0;
@@ -5122,7 +5151,7 @@ int mxl_hostapd_change_country(struct hostapd_iface *iface, struct channel_list_
 
 int mxl_acs_check_bgscan(struct hostapd_iface *iface)
 {
-	iface->conf->channel = 0;
+	int saved_op_class = iface->conf->op_class;
 
 	if ((iface->state == HAPD_IFACE_DFS)) {
 		return -1;
@@ -5141,7 +5170,13 @@ int mxl_acs_check_bgscan(struct hostapd_iface *iface)
 	if (iface->state == HAPD_IFACE_ENABLED)
 		iface->mxl_iface.acs_reenable_iface = 1;
 
-	return mxl_acs_start(iface);
+	if (mxl_acs_start(iface) < 0) {
+		iface->conf->op_class = saved_op_class;
+		iface->mxl_iface.acs_reenable_iface = 0;
+		return -1;
+	}
+
+	return 0;
 }
 
 void mxl_acs_bgscan_timer_cb(void *eloop_data, void *user_ctx)
diff --git a/src/ap/mxl_hostapd.h b/src/ap/mxl_hostapd.h
index 5710c1970..c987b8608 100644
--- a/src/ap/mxl_hostapd.h
+++ b/src/ap/mxl_hostapd.h
@@ -144,6 +144,7 @@ struct mxl_hostapd_iface {
 	int acs_6ghz_passive_ch_list[MAX_6GHZ_CH];
 	int acs_6ghz_passive_ch_num;
 	bool retrigger_acs;
+	bool acs_restart_on_country_change;  /* Set when regulatory domain changes during active ACS */
 	bool acs_bgscan;
 	bool acs_bgscan_enable;
 	int acs_reenable_iface;
diff --git a/src/ap/mxl_zwdfs.c b/src/ap/mxl_zwdfs.c
index 5e109a98b..9c771e787 100644
--- a/src/ap/mxl_zwdfs.c
+++ b/src/ap/mxl_zwdfs.c
@@ -251,6 +251,12 @@ int mxl_hostapd_zwdfs_switch(struct hostapd_iface *iface, int cac_status,
 	if (HOSTAPD_CAC_STAT_SUCCESS != cac_status)
 		goto cleanup;
 
+	if (!csa_settings->freq_params.channel) {
+		wpa_printf(MSG_ERROR,
+			   "ZWDFS: refusing channel switch with invalid primary channel 0");
+		goto cleanup;
+	}
+
 	hostapd_prepare_and_send_csa_deauth_cfg_to_driver(csa_iface->bss[0]);
 
 	for (i = 0; i < csa_iface->num_bss; i++) {
-- 
