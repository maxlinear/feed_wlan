Subject: [PATCH] Add QCA vendor command for flow policy configuration

Define subcmd ID 239 for flow policy configuration.

Signed-off-by: Nirav Shah <quic_nnshah@quicinc.com>
---
 src/common/qca-vendor.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/common/qca-vendor.h b/src/common/qca-vendor.h
index 35333b500..bf996852b 100644
--- a/src/common/qca-vendor.h
+++ b/src/common/qca-vendor.h
@@ -1265,6 +1265,7 @@ enum qca_nl80211_vendor_subcmds {
 	QCA_NL80211_VENDOR_SUBCMD_SDWF_DEV_OPS = 236,
 	QCA_NL80211_VENDOR_SUBCMD_REGULATORY_TPC_INFO = 237,
 	QCA_NL80211_VENDOR_SUBCMD_FW_PAGE_FAULT_REPORT = 238,
+	QCA_NL80211_VENDOR_SUBCMD_FLOW_POLICY = 239,
 };
 
 /* Compatibility defines for previously used subcmd names.
