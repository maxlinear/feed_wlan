+static int mxl_hostapd_ctrl_iface_dump_hostapd_config(struct hostapd_data *hapd, 
+                                                      char *reply, size_t reply_size)
+{
+	struct hapd_interfaces *interfaces;
+	struct hostapd_iface *iface;
+	struct hostapd_data *bss;
+	char output_dir[] = HOSTAPD_CONFIG_OUTPUT_DIR;
+	char output_file[128];
+	FILE *fp = NULL;
+	int i, j;
+	int res = 0;
+	int total_files = 0;
+
+	res = mxl_parse_metadata(HOSTAPD_METADATA_FILE);
+	if (res != 0) {
+		wpa_printf(MSG_ERROR, "%s: Failed to parse metadata file %d\n", __func__, res);
+		return res;
+	}
+
+	/* Create the output directory */
+	if (mkdir(output_dir, 0755) != 0 && errno != EEXIST) {
+		wpa_printf(MSG_ERROR, "%s: Failed to create output directory %s: %s\n",
+			__func__, output_dir, strerror(errno));
+		return -1;
+	}
+	
+	interfaces = hapd->iface ? hapd->iface->interfaces : NULL;
+	if(!interfaces) {
+		wpa_printf(MSG_ERROR, "%s: No interfaces found\n", __func__);
+		return -1;
+	}
+
+	/* Iterate through all radios */
+	for (i = 0; i < interfaces->count; i++) {
+		int radio_active = 0;
+		iface = interfaces->iface[i];
+		if (iface == NULL) {
+			continue;
+		}
+		
+		/* Check if any BSS in this radio is started */
+		for (j = 0; j < iface->num_bss; j++) {
+			if (iface->bss[j] && iface->bss[j]->started) {
+				radio_active = 1;
+				break;
+			}
+		}
+
+
+		if (radio_active && iface->conf != NULL) {
+			const char *radio_name = (iface->phy[0] != '\0') ? iface->phy : "unknown";
+
+			/* Create radio config file */
+			res = os_snprintf(output_file, sizeof(output_file), 
+				"%s/hostapd_radio_%s.txt", output_dir, radio_name);
+			if (os_snprintf_error(sizeof(output_file), res)) {
+				wpa_printf(MSG_ERROR, "%s:%d: Path too long for radio %s\n", 
+					__func__, __LINE__, radio_name);
+				continue;
+			}
+			
+			fp = fopen(output_file, "w");
+			if (fp == NULL) {
+				wpa_printf(MSG_ERROR, "%s:%d: Failed to create %s: %s\n", 
+					__func__, __LINE__, output_file, strerror(errno));
+				continue;
+			}
+			
+			/* Write radio header */
+			fprintf(fp, "========== Hostapd_Radio_config==========\n");
+			fprintf(fp, "Radio Name = %s\n", radio_name);
+			fprintf(fp, "Radio Index = %d\n", i);
+			fprintf(fp, "Channel = %d\n", iface->conf->channel);
+			
+			/* Dump the hostapd_config structure */
+			mxl_hostapd_config_dump(fp, iface->conf, "hostapd_config", "", 0);
+			fclose(fp);
+			total_files++;
+			wpa_printf(MSG_INFO, "%s:%d: Completed dump for radio %s\n", 
+				__func__, __LINE__, radio_name);
+			
+			 /* Dump BSS configs */
+			for (j = 0; j < iface->num_bss; j++) {
+				bss = iface->bss[j];
+				if (bss == NULL || !bss->started) {
+					wpa_printf(MSG_INFO, "%s:%d: Skipping BSS %d (not started)\n",
+						__func__, __LINE__, j);
+					continue;
+				}
+				
+				/* Create BSS config file */
+				res = os_snprintf(output_file, sizeof(output_file), 
+					"%s/hostapd_bss_%s_%s.txt", 
+					output_dir, radio_name, bss->conf->iface);
+				if (os_snprintf_error(sizeof(output_file), res)) {
+					wpa_printf(MSG_ERROR, "%s:%d: Path too long for BSS %s\n", 
+						__func__, __LINE__, bss->conf->iface);
+					continue;
+				}
+				
+				fp = fopen(output_file, "w");
+				if (fp == NULL) {
+					wpa_printf(MSG_ERROR, "%s:%d: Failed to create %s: %s\n", 
+						__func__, __LINE__, output_file, strerror(errno));
+					continue;
+				}
+				
+				/* Write BSS header */
+				fprintf(fp, "========== BSS Interface: %s (Radio: %s) ==========\n", 
+					bss->conf->iface, radio_name);
+				fprintf(fp, "VAP Index = %d\n", j);
+				fprintf(fp, "SSID = %s\n", 
+					wpa_ssid_txt(bss->conf->ssid.ssid, bss->conf->ssid.ssid_len));
+				
+				/* Dump the hostapd_bss_config structure */
+				mxl_hostapd_config_dump(fp, bss->conf, "hostapd_bss_config", "", 0);
+				
+				fclose(fp);
+				total_files++;
+				wpa_printf(MSG_INFO, "%s:%d: Completed dump for BSS %s\n", 
+					__func__, __LINE__, bss->conf->iface);
+			}
+		}
+	}
+
+	
+	if (total_files > 0) {
+		res = os_snprintf(reply, reply_size,
+			"Configuration dumped successfully!\n"
+			"Created %d file(s) in %s\n",
+			total_files, output_dir);
+		} else {
+			res = os_snprintf(reply, reply_size,"No active radios/BSS found\n");
+		}
+	return res;
+}
