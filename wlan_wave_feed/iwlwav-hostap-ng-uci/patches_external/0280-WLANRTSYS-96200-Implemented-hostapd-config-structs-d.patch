+#ifndef MXL_HOSTAPD_CONFIG_DUMP_H
+#define MXL_HOSTAPD_CONFIG_DUMP_H
+
+#include <stdio.h>
+
+#define MAX_NAME 256
+#define MAX_MEMBERS 500   
+#define MAX_STRUCTS 150  
+
+#define HOSTAPD_CONFIG_OUTPUT_DIR "/tmp/hostapd_config"
+#define HOSTAPD_METADATA_FILE "/etc/hostapd_metadata.txt"
+#define MEMBER_FIELD_MAX 6
+
+//Member_info - Structure member metadata
+typedef struct {
+	char name[MAX_NAME];
+	char type[MAX_NAME];
+	int size;
+	int offset;
+	int pointer_depth;
+	int array_count;
+} Member_info;
+
+//Structure - Complete structure metadata 
+typedef struct {
+	char name[MAX_NAME];
+	int size;
+	int member_count;
+	Member_info members[MAX_MEMBERS];
+} Structure_info;
+
+
+int mxl_parse_metadata(const char* file);
+
+Structure_info* mxl_find_struct(const char* name);
+
+void mxl_hostapd_config_dump(FILE* out, void* base, const char* sname, 
+                   const char* prefix, int use_arrow);
+
+#endif /* MXL_HOSTAPD_CONFIG_DUMP_H */
