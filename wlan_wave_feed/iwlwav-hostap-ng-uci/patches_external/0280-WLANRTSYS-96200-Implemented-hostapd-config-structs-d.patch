+#include "utils/includes.h"
+#include "utils/common.h"
+#include "ap/hostapd.h"
+#include "mxl_hostapd_config_dump.h"
+#include "mxl_hostapd_cli.h"
+#include <ctype.h>
+#include <string.h>
+
+static Structure_info structs[MAX_STRUCTS];
+static int struct_count = 0;
+
+Structure_info *mxl_find_struct(const char *name)
+{
+	for (int i = 0; i < struct_count; i++)
+		if (strcmp(structs[i].name, name) == 0)
+			return &structs[i];
+	return NULL;
+}
+
+int mxl_parse_metadata(const char *file)
+{
+	FILE *f = fopen(file, "r");
+	if (!f) {
+		wpa_printf(MSG_ERROR, "Cannot open metadata file: %s", file);
+		return -1;
+	}
+
+	char line[1024];
+	Structure_info *cur = NULL;
+
+	/* Parsing the metadata file */
+	while (fgets(line, sizeof(line), f)) {
+		line[strcspn(line, "\n")] = 0;
+
+		if (strncmp(line, "STRUCT|", 7) == 0) {
+			if (struct_count >= MAX_STRUCTS) {
+				wpa_printf(MSG_ERROR, "Too many structures in metadata");
+				fclose(f);
+				return -1;
+			}
+
+			cur = &structs[struct_count++];
+			cur->member_count = 0;
+
+			// Parse: STRUCT|<name>|<size>|<member_count>
+			char line_copy[512];
+			os_strlcpy(line_copy, line + 7, sizeof(line_copy));
+
+			char *token = strtok(line_copy, "|");
+
+			if (token)
+				os_strlcpy(cur->name, token, sizeof(cur->name));
+				
+			token = strtok(NULL, "|");
+			if (token)
+				cur->size = atoi(token);
+		} else if (strncmp(line, "  MEMBER|", 9) == 0 && cur) {
+			if (cur->member_count >= MAX_MEMBERS) {
+				wpa_printf(MSG_ERROR, "Too many members in struct %s", cur->name);
+				continue;
+			}
+
+			Member_info *m = &cur->members[cur->member_count];
+
+			// Parse delimited fields
+			char line_copy[512];
+			os_strlcpy(line_copy, line + 9, sizeof(line_copy));
+
+			char *token;
+			int field = 0;
+
+			token = strtok(line_copy, "|");
+			while (token && field < MEMBER_FIELD_MAX) {
+				switch (field) {
+				case 0:
+					os_strlcpy(m->name, token, sizeof(m->name));
+					break;
+				case 1:
+					os_strlcpy(m->type, token, sizeof(m->type));
+					break;
+				case 2:
+					m->size = atoi(token);
+					break;
+				case 3:
+					m->offset = atoi(token);
+					break;
+				case 4:
+					m->pointer_depth = atoi(token);
+					break;
+				case 5:
+					m->array_count = atoi(token);
+					break;
+				}
+				field++;
+				token = strtok(NULL, "|");
+			}
+
+			cur->member_count++;
+		}
+	}
+
+	fclose(f);
+	return 0;
+}
+
+void mxl_hostapd_config_dump(FILE *out, void *base, const char *sname, const char *prefix, int use_arrow)
+{
+	static int recursion_depth = 0;
+	const int MAX_RECURSION_DEPTH = 20;
+	if (recursion_depth >= MAX_RECURSION_DEPTH) {
+		fprintf(out, "%s = <max recursion depth reached>\n", prefix);
+		return;
+	}
+	recursion_depth++;
+	if (!base) {
+		recursion_depth--;
+		return;
+	}
+	Structure_info *s = mxl_find_struct(sname);
+	if (!s) {
+		wpa_printf(MSG_WARNING, "Struct '%s' not found in %d loaded structs",
+			   sname, struct_count);
+		recursion_depth--;
+		return;
+	}
+
+	for (int i = 0; i < s->member_count; i++) {
+		Member_info *m = &s->members[i];
+		void *addr = (char *)base + m->offset;
+		char path[512];
+		if (strlen(prefix) == 0)
+			strcpy(path, m->name);
+		else if (use_arrow)
+			snprintf(path, sizeof(path), "%s->%s", prefix, m->name);
+		else
+			snprintf(path, sizeof(path), "%s.%s", prefix, m->name);
+
+		//skip this fields
+		if (strcmp(m->name, "bss") == 0 || strcmp(m->name, "last_bss") == 0 || strcmp(m->name, "driver") == 0)
+			continue;
+
+		// Double pointers (array of pointers)
+		if (m->pointer_depth == 2) {
+			void ***ptr_array_field = (void ***)addr;
+			void **ptr_array = *ptr_array_field;
+			if (!ptr_array) {
+				fprintf(out, "%s = NULL\n", path);
+				continue;
+			}
+
+			int count = 0;
+			while (count < 100 && ptr_array[count] != NULL)
+				count++;
+
+			// Handle char**
+			if (strcmp(m->type, "char") == 0) {
+				fprintf(out, "%s = [\n", path);
+				for (int arr_idx = 0; arr_idx < count; arr_idx++) {
+					char *str = (char *)ptr_array[arr_idx];
+					fprintf(out, "  [%d] = %s\n", arr_idx, str ? str : "NULL");
+				}
+				fprintf(out, "]\n");
+				continue;
+			}
+
+			// Handle struct**
+			if (strncmp(m->type, "struct ", 7) == 0) {
+				char nested[MAX_NAME];
+				sscanf(m->type, "struct %s", nested);
+				for (int arr_idx = 0; arr_idx < count ; arr_idx++) {
+					void *elem_ptr = ptr_array[arr_idx];
+					char elem_path[128];
+					snprintf(elem_path, sizeof(elem_path), "%s[%d]", path, arr_idx);
+					if (!elem_ptr)
+						fprintf(out, "%s = NULL\n", elem_path);
+					else
+						mxl_hostapd_config_dump(out, elem_ptr, nested, elem_path, 0);
+				}
+				continue;
+			}
+			continue;
+		}
+
+		// Single pointer to struct (linked list/struct pointer)
+		if (m->pointer_depth == 1 && strncmp(m->type, "struct ", 7) == 0) {
+			void **ptr_field = (void **)addr;
+			void *pointed = *ptr_field;
+			if (!pointed) {
+				fprintf(out, "%s = NULL\n", path);
+				continue;
+			}
+			char nested[MAX_NAME];
+			sscanf(m->type, "struct %s", nested);
+
+			// Linked list self-reference
+			if ((strcmp(m->name, "next") == 0 || strcmp(m->name, "prev") == 0) && strcmp(nested, sname) == 0) {
+				fprintf(out, "%s = %p\n", path, pointed);
+				continue;
+			}
+			// Linked list
+			Structure_info *target_struct = mxl_find_struct(nested);
+			int is_list_head = 0, next_offset = 0;
+			if (target_struct && strcmp(m->name, "next") != 0 && strcmp(m->name, "prev") != 0) {
+				for (int k = 0; k < target_struct->member_count; k++) {
+					if (strcmp(target_struct->members[k].name, "next") == 0 &&
+					    target_struct->members[k].pointer_depth == 1) {
+						is_list_head = 1;
+						next_offset = target_struct->members[k].offset;
+						break;
+					}
+				}
+			}
+
+			// Traverse linked list
+			if (is_list_head) {
+				void *curr = pointed;
+				void *start = pointed;
+				int idx = 0;
+				while (curr && idx < 100) {
+					char list_path[128];
+					snprintf(list_path, sizeof(list_path), "%s[%d]", path, idx);
+					mxl_hostapd_config_dump(out, curr, nested, list_path, 0);
+					void **next_ptr = (void **)((char *)curr + next_offset);
+					curr = *next_ptr;
+					if (curr == start && idx > 0) {
+						fprintf(out, "%s = <circular list detected>\n", path);
+						break;
+					}
+					idx++;
+				}
+			} else {
+				mxl_hostapd_config_dump(out, pointed, nested, path, 1);
+			}
+			continue;
+		}
+
+		// Single pointer to basic types
+		if (m->pointer_depth == 1) {
+			void **ptr_field = (void **)addr;
+			void *pointed = *ptr_field;
+			if (!pointed) {
+				fprintf(out, "%s = NULL\n", path);
+				continue;
+			}
+			if (strcmp(m->type, "int") == 0)
+				fprintf(out, "%s = %d\n", path, *(int *)pointed);
+			else if (strcmp(m->type, "unsigned int") == 0)
+				fprintf(out, "%s = %u\n", path, *(unsigned int *)pointed);
+			else if (strcmp(m->type, "char") == 0)
+				fprintf(out, "%s = \"%s\"\n", path, (char *)pointed);
+			else if (strcmp(m->type, "unsigned char") == 0 || strcmp(m->type, "u8") == 0)
+				fprintf(out, "%s = %u\n", path, *(unsigned char *)pointed);
+			else if (strcmp(m->type, "short") == 0 || strcmp(m->type, "short int") == 0)
+				fprintf(out, "%s = %d\n", path, *(short *)pointed);
+			else if (strcmp(m->type, "unsigned short") == 0 || strcmp(m->type, "short unsigned int") == 0)
+				fprintf(out, "%s = %u\n", path, *(unsigned short *)pointed);
+			else if (strcmp(m->type, "long") == 0 || strcmp(m->type, "long int") == 0)
+				fprintf(out, "%s = %ld\n", path, *(long *)pointed);
+			else if (strcmp(m->type, "unsigned long") == 0 || strcmp(m->type, "long unsigned int") == 0)
+				fprintf(out, "%s = %lu\n", path, *(unsigned long *)pointed);
+			else if (strcmp(m->type, "float") == 0)
+				fprintf(out, "%s = %f\n", path, *(float *)pointed);
+			else if (strcmp(m->type, "double") == 0)
+				fprintf(out, "%s = %lf\n", path, *(double *)pointed);
+			else
+				fprintf(out, "%s = %p\n", path, pointed);
+			continue;
+		}
+
+		// Arrays of structs
+		if (m->array_count > 0 && strncmp(m->type, "struct ", 7) == 0) {
+			char nested[MAX_NAME];
+			sscanf(m->type, "struct %s", nested);
+			for (int arr_idx = 0; arr_idx < m->array_count; arr_idx++) {
+				char elem_path[512];
+				snprintf(elem_path, sizeof(elem_path), "%s[%d]", path, arr_idx);
+				void *elem_addr = (char *)addr + arr_idx * m->size;
+				mxl_hostapd_config_dump(out, elem_addr, nested, elem_path, 0);
+			}
+			continue;
+		}
+
+		// if unknown arrays
+		if (m->array_count > 0 && strcmp(m->type, "unknown") == 0) {
+			int ptr_size = sizeof(void *);
+			fprintf(out, "%s = [\n", path);
+			for (int i = 0; i < m->array_count; i++) {
+				void **ptr_elem = (void **)((char *)addr + i * ptr_size);
+				void *pointed = *ptr_elem;
+				fprintf(out, "  [%d] = %p\n", i, pointed);
+			}
+			fprintf(out, "]\n");
+			continue;
+		}
+
+		// Byte arrays (u8/unsigned char arrays)
+		if (m->array_count > 0 && (strcmp(m->type, "u8") == 0 ||
+					   strcmp(m->type, "uint8_t") == 0 ||
+					   strcmp(m->type, "unsigned char") == 0)) {
+			unsigned char *byte_arr = (unsigned char *)addr;
+			int is_hex_field = (strstr(m->name, "psk") || strstr(m->name, "he_mu_ac") ||
+				strstr(m->name, "bssid") || strstr(m->name, "uuid") ||
+				strstr(m->name, "device_type") || strstr(m->name, "radio_measurements") ||
+				strstr(m->name, "measurement") || strstr(m->name, "hessid") ||
+				strstr(m->name, "cmmac") || strstr(m->name, "addr") ||
+				strstr(m->name, "mac") || strstr(m->name, "cache_id") ||
+				strstr(m->name, "ext_capa") || strstr(m->name, "transition_ssid") ||
+				strstr(m->name, "basic_eht_mcs_nss_set"));
+			if (is_hex_field) {
+				fprintf(out, "%s = ", path);
+				for (int i = 0; i < m->array_count; i++)
+					fprintf(out, "%02x", byte_arr[i]);
+				fprintf(out, "\n");
+			} else {
+				fprintf(out, "%s = \"%s\"\n", path, (char *)byte_arr);
+			}
+			continue;
+		}
+
+		// Integer arrays (int and unsigned int)
+		if (m->array_count > 0 && (strcmp(m->type, "int") == 0 || strcmp(m->type, "unsigned int") == 0)) {
+			int is_unsigned = (strcmp(m->type, "unsigned int") == 0);
+			fprintf(out, "%s = [", path);
+			for (int i = 0; i < m->array_count; i++) {
+				if (i > 0)
+					fprintf(out, ", ");
+				if (is_unsigned) {
+					unsigned int *uint_arr = (unsigned int *)addr;
+					fprintf(out, "%u", uint_arr[i]);
+				} else {
+					int *int_arr = (int *)addr;
+					fprintf(out, "%d", int_arr[i]);
+				}
+			}
+			fprintf(out, "]\n");
+			continue;
+		}
+
+
+		// Embedded struct
+		if (strncmp(m->type, "struct ", 7) == 0) {
+			char nested[MAX_NAME];
+			sscanf(m->type, "struct %s", nested);
+			mxl_hostapd_config_dump(out, addr, nested, path, 0);
+			continue;
+		}
+
+		// Union
+		if (strncmp(m->type, "union ", 6) == 0) {
+			char nested[MAX_NAME];
+			sscanf(m->type, "union %s", nested);
+			fprintf(out, "%s = ", path);
+			unsigned char *bytes = (unsigned char *)addr;
+			int bytes_to_print = (m->size <= 32) ? m->size : 32;
+			for (int i = 0; i < bytes_to_print; i++)
+				fprintf(out, "%02x", bytes[i]);
+			if (m->size > 32)
+				fprintf(out, "...");
+			fprintf(out, "\n");
+			continue;
+		}
+
+		// Function pointer
+		if (strstr(m->type, "(*") != NULL || strstr(m->type, "* ") != NULL) {
+			void **func_ptr = (void **)addr;
+			void *func_addr = *func_ptr;
+			if (!func_addr)
+				fprintf(out, "%s = NULL\n", path);
+			else
+				fprintf(out, "%s = %p\n", path, func_addr);
+			continue;
+		}
+
+		// Char arrays (strings)
+		if (m->array_count > 0 && strcmp(m->type, "char") == 0) {
+			char *str = (char *)addr;
+			int has_content = 0;
+			for (int i = 0; i < m->array_count && str[i] != '\0'; i++) {
+				if (str[i] != '\0') {
+					has_content = 1;
+					break;
+				}
+			}
+			fprintf(out, "%s = \"%s\"\n", path, has_content ? str : "");
+			continue;
+		}
+
+		// Basic types
+		if (strcmp(m->type, "int") == 0)
+			fprintf(out, "%s = %d\n", path, *(int *)addr);
+		else if (strcmp(m->type, "unsigned int") == 0)
+			fprintf(out, "%s = %u\n", path, *(unsigned int *)addr);
+		else if (strcmp(m->type, "float") == 0)
+			fprintf(out, "%s = %f\n", path, *(float *)addr);
+		else if (strcmp(m->type, "double") == 0)
+			fprintf(out, "%s = %lf\n", path, *(double *)addr);
+		else if (strcmp(m->type, "char") == 0)
+			fprintf(out, "%s = '%c'\n", path, *(char *)addr);
+		else if (strcmp(m->type, "enum") == 0 || strncmp(m->type, "enum ", 5) == 0)
+			fprintf(out, "%s = %d\n", path, *(int *)addr);
+		else if (strcmp(m->type, "_Bool") == 0 || strcmp(m->type, "bool") == 0)
+			fprintf(out, "%s = %u\n", path, *(unsigned char *)addr);
+		else if (strcmp(m->type, "u8") == 0 || strcmp(m->type, "uint8_t") == 0 ||
+			 strcmp(m->type, "unsigned char") == 0)
+			fprintf(out, "%s = %u\n", path, *(unsigned char *)addr);
+		else if (strcmp(m->type, "u16") == 0 || strcmp(m->type, "uint16_t") == 0 ||
+			 strcmp(m->type, "unsigned short") == 0 || strcmp(m->type, "short unsigned int") == 0)
+			fprintf(out, "%s = %u\n", path, *(unsigned short *)addr);
+		else if (strcmp(m->type, "u32") == 0 || strcmp(m->type, "uint32_t") == 0)
+			fprintf(out, "%s = %u\n", path, *(unsigned int *)addr);
+		else if (strcmp(m->type, "u64") == 0 || strcmp(m->type, "uint64_t") == 0 ||
+			 strcmp(m->type, "unsigned long long") == 0 || strcmp(m->type, "long unsigned int") == 0)
+			fprintf(out, "%s = %llu\n", path, *(unsigned long long *)addr);
+		else if (strcmp(m->type, "size_t") == 0)
+			fprintf(out, "%s = %zu\n", path, *(size_t *)addr);
+		else if (strcmp(m->type, "unsigned long") == 0 || strcmp(m->type, "long unsigned int") == 0)
+			fprintf(out, "%s = %lu\n", path, *(unsigned long *)addr);
+		else if (strcmp(m->type, "short") == 0 || strcmp(m->type, "short int") == 0)
+			fprintf(out, "%s = %d\n", path, *(short *)addr);
+		else if (strcmp(m->type, "long") == 0 || strcmp(m->type, "long int") == 0)
+			fprintf(out, "%s = %ld\n", path, *(long *)addr);
+		else if (m->size > 0 && m->size <= 64) {
+			fprintf(out, "%s = ", path);
+			unsigned char *bytes = (unsigned char *)addr;
+			for (int i = 0; i < m->size; i++)
+				fprintf(out, "%02x", bytes[i]);
+			fprintf(out, "\n");
+		} else if (m->size == 0 && strcmp(m->type, "unknown") == 0) {
+
+			if (strstr(m->name, "bssid") || strstr(m->name, "addr") || strstr(m->name, "mac")) {
+				fprintf(out, "%s = ", path);
+				unsigned char *bytes = (unsigned char *)addr;
+				for (int i = 0; i < 6; i++)
+					fprintf(out, "%02x", bytes[i]);
+				fprintf(out, "\n");
+			} else {
+				fprintf(out, "%s = ", path);
+				unsigned char *bytes = (unsigned char *)addr;
+				for (int i = 0; i < 4; i++)
+					fprintf(out, "%02x", bytes[i]);
+				fprintf(out, "\n");
+			}
+		} else {
+			fprintf(out, "%s = <unknown type '%s', size=%d, offset=%d>\n",
+				path, m->type, m->size, m->offset);
+		}
+	}
+	recursion_depth--;
+}
+
