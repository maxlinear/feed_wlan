diff --git a/hostapd/mxl_hostapd_metadata.c b/hostapd/mxl_hostapd_metadata.c
new file mode 100644
index 000000000..ca6fbf234
--- /dev/null
+++ b/hostapd/mxl_hostapd_metadata.c
@@ -0,0 +1,383 @@
+/******************************************************************************
+
+         Copyright (c) 2020 - 2026, MaxLinear, Inc.
+         Copyright 2016 - 2020 Intel Corporation
+         Copyright 2015 - 2016 Lantiq Beteiligungs-GmbH & Co. KG
+         Copyright 2009 - 2014 Lantiq Deutschland GmbH
+         Copyright 2007 - 2008 Infineon Technologies AG
+
+  This software may be distributed under the terms of the BSD license.
+  See README for more details.
+
+*******************************************************************************/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <dwarf.h>
+#include <elfutils/libdw.h>
+
+#define MAX_STRUCTS 256
+#define MAX_MEMBERS 512
+#define MAX_NAME_LEN 128
+#define MAX_TYPE_LEN 128
+
+// Array of structures to extract
+static const char *STRUCTS_TO_EXTRACT[] = {
+	"hostapd_config",
+	"hostapd_bss_config",
+	NULL
+};
+
+typedef struct {
+	char name[MAX_NAME_LEN];
+	char type_name[MAX_TYPE_LEN];
+	unsigned long offset;
+	unsigned long size;
+	int is_pointer;
+	int is_array;
+	int array_count;
+} member_info_t;
+
+typedef struct {
+	char name[MAX_NAME_LEN];
+	unsigned long size;
+	int member_count;
+	member_info_t members[MAX_MEMBERS];
+	int extracted;
+} struct_info_t;
+
+static struct_info_t structs[MAX_STRUCTS];
+static int struct_count = 0;
+
+static int mxl_find_struct_index(const char *name) {
+	for (int i = 0; i < struct_count; i++) {
+		if (strcmp(structs[i].name, name) == 0) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+static int mxl_add_hostapd_struct(const char *name) {
+	//Duplicate check
+	if (mxl_find_struct_index(name) >= 0) {
+		return mxl_find_struct_index(name);
+	}
+
+	if (struct_count >= MAX_STRUCTS) {
+		return -1;
+	}
+
+	strncpy(structs[struct_count].name, name, MAX_NAME_LEN - 1);
+	structs[struct_count].size = 0;
+	structs[struct_count].member_count = 0;
+	structs[struct_count].extracted = 0;
+	return struct_count++;
+}
+
+
+static void mxl_extract_type_info(Dwarf_Die *type_die,
+			      char *type_name,
+			      unsigned long *type_size,
+			      int *is_pointer,
+			      int *is_array,
+			      int *array_count) {
+	*is_pointer = 0;
+	*is_array = 0;
+	*array_count = 0;
+	*type_size = 0;
+	strcpy(type_name, "unknown");
+
+	if (!type_die) {
+		return;
+	}
+
+	Dwarf_Die current = *type_die;
+
+	// Handle pointers - count depth (*, **, ***, etc.)
+	while (dwarf_tag(&current) == DW_TAG_pointer_type) {
+		(*is_pointer)++;
+		*type_size = sizeof(void*);
+
+		Dwarf_Attribute attr;
+		if (dwarf_attr(&current, DW_AT_type, &attr) != NULL) {
+			Dwarf_Die next;
+			if (dwarf_formref_die(&attr, &next) != NULL) {
+				current = next;
+				continue;
+			}
+		}
+		strcpy(type_name, "void");
+		return;
+	}
+
+	// Handle arrays
+	if (dwarf_tag(&current) == DW_TAG_array_type) {
+		*is_array = 1;
+
+		Dwarf_Die child;
+		if (dwarf_child(&current, &child) == 0) {
+			do {
+				if (dwarf_tag(&child) == DW_TAG_subrange_type) {
+					Dwarf_Attribute attr;
+					Dwarf_Word bound;
+
+					if (dwarf_attr(&child, DW_AT_upper_bound, &attr) != NULL) {
+						if (dwarf_formudata(&attr, &bound) == 0) {
+							*array_count = bound + 1;
+						}
+					} else if (dwarf_attr(&child, DW_AT_count, &attr) != NULL) {
+						if (dwarf_formudata(&attr, &bound) == 0) {
+							*array_count = bound;
+						}
+					}
+					break;
+				}
+			} while (dwarf_siblingof(&child, &child) == 0);
+		}
+
+		Dwarf_Attribute attr;
+		if (dwarf_attr(&current, DW_AT_type, &attr) != NULL) {
+			Dwarf_Die elem_type;
+			if (dwarf_formref_die(&attr, &elem_type) != NULL) {
+				current = elem_type;
+			}
+		}
+	}
+
+	// Resolve typedefs
+	while (1) {
+		int tag = dwarf_tag(&current);
+		if (tag == DW_TAG_typedef || tag == DW_TAG_const_type ||
+		    tag == DW_TAG_volatile_type || tag == DW_TAG_restrict_type) {
+			Dwarf_Attribute attr;
+			if (dwarf_attr(&current, DW_AT_type, &attr) != NULL) {
+				Dwarf_Die next;
+				if (dwarf_formref_die(&attr, &next) != NULL) {
+					current = next;
+					continue;
+				}
+			}
+		}
+		break;
+	}
+
+	// Get type name
+	int tag = dwarf_tag(&current);
+	const char *name = dwarf_diename(&current);
+
+	if (tag == DW_TAG_structure_type) {
+		if (name) {
+			snprintf(type_name, MAX_TYPE_LEN, "struct %s", name);
+			mxl_add_hostapd_struct(name);
+		} else {
+			strcpy(type_name, "struct <anon>");
+		}
+	} else if (tag == DW_TAG_union_type) {
+		if (name) {
+			snprintf(type_name, MAX_TYPE_LEN, "union %s", name);
+		} else {
+			strcpy(type_name, "union <anon>");
+		}
+	} else if (tag == DW_TAG_enumeration_type) {
+		strcpy(type_name, "enum");
+	} else if (tag == DW_TAG_base_type) {
+		if (name) {
+			strncpy(type_name, name, MAX_TYPE_LEN - 1);
+		}
+	} else if (name) {
+		strncpy(type_name, name, MAX_TYPE_LEN - 1);
+	}
+
+	// Get size
+	Dwarf_Attribute size_attr;
+	if (dwarf_attr(&current, DW_AT_byte_size, &size_attr) != NULL) {
+		Dwarf_Word sz;
+		if (dwarf_formudata(&size_attr, &sz) == 0) {
+			*type_size = sz;
+		}
+	}
+}
+
+static int mxl_extract_structure(Dwarf *dwarf, const char *struct_name) {
+	int struct_idx = mxl_find_struct_index(struct_name);
+	if (struct_idx < 0) {
+		return 0;
+	}
+
+	if (structs[struct_idx].extracted) {
+		return 1;
+	}
+
+	Dwarf_Off offset = 0;
+	size_t hsize;
+	int found = 0;
+
+	while (dwarf_nextcu(dwarf, offset, &offset, &hsize, NULL, NULL, NULL) == 0) {
+		Dwarf_Die cu_die;
+		if (dwarf_offdie(dwarf, offset + hsize, &cu_die) == NULL) {
+			continue;
+		}
+
+		Dwarf_Die child;
+		if (dwarf_child(&cu_die, &child) != 0) {
+			continue;
+		}
+
+		do {
+			if (dwarf_tag(&child) != DW_TAG_structure_type) {
+				continue;
+			}
+
+			const char *name = dwarf_diename(&child);
+			if (!name || strcmp(name, struct_name) != 0) {
+				continue;
+			}
+
+			found = 1;
+
+			// Get structure size
+			Dwarf_Attribute size_attr;
+			if (dwarf_attr(&child, DW_AT_byte_size, &size_attr) != NULL) {
+				Dwarf_Word sz;
+				if (dwarf_formudata(&size_attr, &sz) == 0) {
+					structs[struct_idx].size = sz;
+				}
+			}
+
+			// Extract members
+			Dwarf_Die member;
+			if (dwarf_child(&child, &member) == 0) {
+				int member_idx = 0;
+
+				do {
+					if (dwarf_tag(&member) != DW_TAG_member) {
+						continue;
+					}
+
+					if (member_idx >= MAX_MEMBERS) {
+						break;
+					}
+
+					member_info_t *m = &structs[struct_idx].members[member_idx];
+					memset(m, 0, sizeof(member_info_t));
+
+					const char *member_name = dwarf_diename(&member);
+					if (member_name) {
+						strncpy(m->name, member_name, MAX_NAME_LEN - 1);
+					} else {
+						snprintf(m->name, MAX_NAME_LEN, "_anon_%d", member_idx);
+					}
+
+					// Get offset
+					Dwarf_Attribute offset_attr;
+					if (dwarf_attr(&member, DW_AT_data_member_location, &offset_attr) != NULL) {
+						Dwarf_Word off;
+						if (dwarf_formudata(&offset_attr, &off) == 0) {
+							m->offset = off;
+						}
+					}
+
+					// Get type
+					Dwarf_Attribute type_attr;
+					if (dwarf_attr(&member, DW_AT_type, &type_attr) != NULL) {
+						Dwarf_Die type_die;
+						if (dwarf_formref_die(&type_attr, &type_die) != NULL) {
+							mxl_extract_type_info(&type_die, m->type_name, &m->size,
+								&m->is_pointer, &m->is_array, &m->array_count);
+						}
+					}
+
+					member_idx++;
+				} while (dwarf_siblingof(&member, &member) == 0);
+
+				structs[struct_idx].member_count = member_idx;
+			}
+
+			structs[struct_idx].extracted = 1;
+			break;
+
+		} while (dwarf_siblingof(&child, &child) == 0);
+
+		if (found) {
+			break;
+		}
+	}
+	
+	return found;
+}
+
+static void mxl_write_metadata_file(const char *output_path) {
+	FILE *f = fopen(output_path, "w");
+	if (!f) {
+		fprintf(stderr, "Error: Cannot create '%s': %s\n", output_path, strerror(errno));
+		return;
+	}
+	for (int i = 0; i < struct_count; i++) {
+		if (!structs[i].extracted) {
+			continue;
+		}
+
+		struct_info_t *s = &structs[i];
+		fprintf(f, "STRUCT|%s|%lu|%d\n", s->name, s->size, s->member_count);
+
+		for (int j = 0; j < s->member_count; j++) {
+			member_info_t *m = &s->members[j];
+			fprintf(f, "  MEMBER|%s|%s|%lu|%lu|%d|%d\n",
+				m->name, m->type_name, m->size,
+				m->offset,
+				m->is_pointer, m->array_count);
+		}
+
+		fprintf(f, "END_STRUCT\n\n");
+	}
+
+	fclose(f);
+}
+
+int main(int argc, char *argv[]) {
+
+	if (argc < 2) {
+		fprintf(stderr, "Usage: %s <binary_path> [output_path]\n", argv[0]);
+		return 1;
+	}
+
+	const char *binary_path = argv[1];
+	const char *output_path = (argc >= 3) ? argv[2] : "hostapd_metadata.txt";
+
+	int fd = open(binary_path, O_RDONLY);
+	if (fd < 0) {
+		fprintf(stderr, "Error: Cannot open '%s': %s\n", binary_path, strerror(errno));
+		return 1;
+	}
+
+	Dwarf *dwarf = dwarf_begin(fd, DWARF_C_READ);
+	if (!dwarf) {
+		fprintf(stderr, "Error: No DWARF debug info in '%s'\n", binary_path);
+		close(fd);
+		return 1;
+	}
+
+	for (int i = 0; STRUCTS_TO_EXTRACT[i] != NULL; i++) {
+		mxl_add_hostapd_struct(STRUCTS_TO_EXTRACT[i]);
+	}
+
+	int current = 0;
+	while (current < struct_count) {
+		const char *name = structs[current].name;
+		mxl_extract_structure(dwarf, name);
+		current++;
+	}
+
+	mxl_write_metadata_file(output_path);
+
+	dwarf_end(dwarf);
+
+	close(fd);
+	return 0;
+}
