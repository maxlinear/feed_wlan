+
+bool mxl_ml_is_ml_csa_allowed(struct hostapd_iface *iface)
+{
+	struct hostapd_data *bss, *lhapd;
+	struct p_ap_mld *mld = NULL;
+	int i;
+
+	if (!iface)
+		return false;
+	
+	if (mxl_mlo_is_ml_csa_in_progress(iface)) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: ML CSA is already in progress on iface %s",
+			   iface->conf->bss[0]->iface);
+		return false;
+	}
+
+	for (i = 1; i < iface->num_bss; i++) {
+		bss = iface->bss[i];
+		mld = mxl_ml_get_ap_mld(bss);
+		if (!mld)
+			continue;
+		mxl_mld_for_each_sibling_link(lhapd, bss) {
+			if (mxl_mlo_is_ml_csa_in_progress(lhapd->iface)) {
+				wpa_printf(MSG_ERROR, "MXL_MLO: ML CSA is in progress on sibling link %s, cannot start another CSA",
+					   lhapd->conf->iface);
+				return false;
+			}
+		}
+	}
+
+	return true;
+}
