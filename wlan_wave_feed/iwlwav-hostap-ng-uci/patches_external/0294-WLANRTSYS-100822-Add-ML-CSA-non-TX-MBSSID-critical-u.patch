+#define ML_CSA_TIMEOUT_MAX_USEC		(10 * 1000000)
+#define ML_CSA_OVERHEAD_TIME_USEC	(3 * 1000000)
+static unsigned int mxl_ml_get_csa_timeout(struct hostapd_iface *csa_iface)
+{
+	struct hostapd_data *bss;
+	u32 max_chan_switch_time = csa_iface->conf->mxl_conf.max_chan_switch_time;
+	u16 max_beacon_int = 0, beacon_int = 0;
+	unsigned int timeout = 0;
+
+	for (int i = MASTER_VAP_BSS_IDX + 1; i < csa_iface->num_bss; i++) {
+		bss = csa_iface->bss[i];
+		beacon_int = hostapd_get_beacon_int(bss);
+		if (beacon_int > max_beacon_int)
+			max_beacon_int = beacon_int;
+	}
+
+	timeout = TU_TO_USEC(max_beacon_int + max_chan_switch_time) + ML_CSA_OVERHEAD_TIME_USEC;
+	return MIN(timeout, ML_CSA_TIMEOUT_MAX_USEC);
+}
