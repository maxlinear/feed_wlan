+static void mxl_hostapd_event_ml_csa_done_on_mbssid_reporting_link(struct hostapd_data *hapd, enum wpa_event_type event)
+{
+	struct hostapd_iface *iface = hapd->iface;
+	struct hostapd_iface *csa_iface = NULL;
+	struct hostapd_data *tx_bss, *bss = NULL;
+	struct p_ap_mld *mld = NULL;
+	struct mxl_vendor_ml_mbss_info mbss_info = {0};
+	u32 max_chan_switch_time = 0;
+	u8 flags = 0;
+	int i ,ret = 0;
+
+	/* ML CSA done event is sent only once on the TX MBSSID bss */
+	tx_bss = mxl_hostapd_mbssid_get_tx_bss(hapd);
+	if (tx_bss != hapd)
+		wpa_printf(MSG_ERROR, "MXL_MLO: %s Received ML CSA done event on non-TX MBSSID bss",
+			   hapd->conf->iface);
+
+	if (event == EVENT_CHAN_SWITCH_COUNT_DONE) {
+		csa_iface = mxl_hostapd_mbssid_get_ml_csa_affected_iface(hapd);
+		if (!csa_iface) {
+			wpa_printf(MSG_ERROR, "MXL_MLO: %s MBSSID No link found with CSA in progress",
+				   hapd->conf->iface);
+			return;
+		}
+		max_chan_switch_time = csa_iface->conf->mxl_conf.max_chan_switch_time;
+		for (i = MULTIBSS_REFERENCE_BSS_IDX; i < iface->num_bss; i++) {
+			bss = iface->bss[i];
+			mld = mxl_ml_get_ap_mld(bss);
+
+			if (!mld)
+				continue;
+			if (!bss->mxl_data.csa_on_reporting_link)
+				continue;
+			
+			if (tx_bss == bss) {
