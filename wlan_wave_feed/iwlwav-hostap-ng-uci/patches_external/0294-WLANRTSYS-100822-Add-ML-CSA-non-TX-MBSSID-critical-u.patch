+size_t mxl_hostapd_eid_csw_len(struct hostapd_data *hapd)
+{
+	struct hostapd_data *lhapd, *bss, *affected_hapd = NULL;
+	struct p_ap_mld *mld = mxl_ml_get_ap_mld(hapd);
+	size_t len = 0;
+
+	if (!mld || !hapd->mxl_data.ml_ie_csw_ie_add || !hapd->mxl_data.csa_on_reporting_link)
+		return 0;
+
+	mxl_mld_for_each_affiliated_link(lhapd, mld) {
+		if (mxl_mlo_is_ml_csa_in_progress(lhapd->iface)) {
+			affected_hapd = lhapd;
+			break;
+		}
+	}
+
+	if (!affected_hapd) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: No affected link found for CSW IE Length");
+		return 0;
+	}
+
+	bss = affected_hapd->iface->bss[0];
+
+	if (!bss->cs_freq_params.channel ||
+	    (!bss->cs_freq_params.vht_enabled &&
+	     !bss->cs_freq_params.he_enabled &&
+	     !bss->cs_freq_params.eht_enabled))
+		return 0;
+
+	/* CSW Wrapper: EID (1) + Length (1) */
+	len += 2;
+
+	/* Wide Bandwidth Channel Switch subelement: EID (1) + Length (1) + 3 bytes data */
+	if (bss->cs_freq_params.bandwidth > 20)
+		len += 5;
+
+	/* Bandwidth Indication subelement (EHT only) */
+	if (bss->iconf->ieee80211be && !bss->conf->disable_11be) {
+		if (bss->cs_freq_params.bandwidth > 160 ||
+		    bss->iconf->punct_bitmap) {
+			/* EID_EXT header (3) + base (4) */
+			len += 7;
+			if (bss->iconf->punct_bitmap)
+				len += EHT_OPER_DISABLED_SUBCHAN_BITMAP_SIZE;
+		}
+	}
+
+	return len;
+}
+
+u8 * mxl_hostapd_eid_csw(struct hostapd_data *hapd, u8 *eid)
+{
+	struct hostapd_data *lhapd ,*affected_hapd = NULL;
+	struct p_ap_mld *mld = mxl_ml_get_ap_mld(hapd);
+
+	if (!mld || !hapd->mxl_data.ml_ie_csw_ie_add || !hapd->mxl_data.csa_on_reporting_link)
+		return eid;
+
+	mxl_mld_for_each_affiliated_link(lhapd, mld) {
+		if (mxl_mlo_is_ml_csa_in_progress(lhapd->iface)) {
+			affected_hapd = lhapd;
+			break;
+		}
+	}
+
+	if (!affected_hapd) {
+		wpa_printf(MSG_ERROR, "MXL_MLO: No affected link found for CSW IE");
+		return eid;
+	}
+
+	/* CSA settings are only ready in master VAP when handling ML CSA */
+	eid = hostapd_eid_chsw_wrapper(affected_hapd->iface->bss[0], eid);
+
+	return eid;
+}
 #endif /* CONFIG_IEEE80211BE_MXL_MLO */
 
