 	    wpabuf_len(conf->rsne_override_eapol) <= MAX_OWN_IE_OVERRIDE) {
 		wconf->rsne_override_eapol_set = 1;
diff --git a/src/ap/wpa_auth_ie.c b/src/ap/wpa_auth_ie.c
