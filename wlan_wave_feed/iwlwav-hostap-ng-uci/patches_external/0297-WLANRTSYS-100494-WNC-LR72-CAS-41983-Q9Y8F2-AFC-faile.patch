+int mxl_hostapd_afc_get_valid_rule_and_set_power(struct hostapd_iface *iface, int val)
+{
+	int ret = 0;
+
+	if (!is_6ghz_op_class(iface->conf->op_class) || !is_6ghz_freq(iface->freq))
+		return -1;
+
+	if (val == HE_REG_INFO_6GHZ_AP_TYPE_INDOOR_SP) {
+		if(!(mxl_is_6ghz_unii5_unii7(iface->freq))) {
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+			ret = mxl_acs_switch_to_unii_5_7_channel(iface);
+			if(ret == -1) {
+				wpa_printf(MSG_ERROR, "AFC Failed to switch to UNII 5 or 7 channel for 6G composite power mode");
+				return -1;
+			}
+			else if (ret == -2) {
+				//TODO: select a fallback channel of UNII5 or UNII7
+				wpa_printf(MSG_ERROR, "AFC Failed to fetch UNII 5 or 7 channel, composite power mode not set");
+				return -1;
+			}
+#endif /* CONFIG_VENDOR_MXL_PROPRIETARY */
+		}
+	}
+	iface->afc.acs_pwr_mode_6g = 0;
+	iface->afc.he_6ghz_reg_pwr_type = val;
+	if (iface->afc.data_valid) {
+		iface->conf->he_6ghz_reg_pwr_type = val;
+		ret = mxl_hostapd_interface_update_power_regd(iface->bss[0], val);
+	}
+	else {
+		ret = mxl_hostapd_afc_handle_request(iface);
+		if (ret < 0) {
+			wpa_printf(MSG_ERROR, "AFC request failed retrying in few seconds");
+			return -1;
+		}
+		/* AFC request successfull trigger ACS and Switch channel */
+		hostapd_set_state(iface, HAPD_IFACE_ACS);
+		iface->afc.acs_pwr_mode_6g = 1;
+		/* Update power */
+		mxl_hostapd_interface_update_power_regd(iface->bss[0], val);
+	}
+
+ 	return ret;
+}
