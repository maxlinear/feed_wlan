+int mxl_acs_switch_to_unii_5_7_channel(struct hostapd_iface *iface)
+{
+	struct csa_settings settings;
+	struct hostapd_channel_data *channel = NULL;
+	int secondary_channel;
+	int can_idx;
+	u8 vht_oper_centr_freq_seg0_idx;
+	u8 vht_oper_centr_freq_seg1_idx;
+	struct acs_candidate_table *candidate = iface->mxl_iface.candidates;
+
+	/* set this flag true to get the idx value*/
+	iface->mxl_iface.sec_best_ch.flag = true;
+
+	os_memset(&settings, 0, sizeof(settings));
+	channel = mxl_dfs_get_channel_dynamic_failsafe(iface, &secondary_channel, &vht_oper_centr_freq_seg0_idx,
+					&vht_oper_centr_freq_seg1_idx, false, true, &settings.freq_params);
+	iface->mxl_iface.sec_best_ch.flag = false;
+	if (channel) {
+		can_idx = iface->mxl_iface.sec_best_ch.second_rank_idx;
+		iface->conf->channel = candidate[can_idx].primary;
+		iface->freq = hostapd_hw_get_freq(iface->bss[0], iface->conf->channel);
+		iface->conf->secondary_channel = mxl_get_secondary_offset(candidate[can_idx].primary, candidate[can_idx].secondary);
+		hostapd_set_oper_chwidth(iface->conf, mxl_get_oper_width(candidate[can_idx].width));
+		acs_smart_adjust_center_freq(iface, candidate[can_idx].chan);
+		wpa_printf(MSG_DEBUG, "ACS: UNII_5_7 channel idx %d,  chan : %d, freq : %d", can_idx, candidate[can_idx].primary, iface->freq);
+
+		/* Set channel and switch */
+		mxl_acs_chandef cur_chan;
+		acs_push_chandef(iface, &cur_chan);
+
+		mxl_hostapd_channel_switch_reason_set(iface, HAPD_CHAN_SWITCH_OTHER);
+
+		if (mxl_acs_do_switch_channel(iface, 0) < 0) {
+			/* back out with channel switch */
+			acs_pop_chandef(iface, &cur_chan);
+			wpa_printf(MSG_ERROR, "ACS Unable to switch to UNII_5_7 channel");
+			return -1;
+		}
+	}
+	else {
+		wpa_printf(MSG_ERROR, "ACS failed to get UNII_5_7 channel");
+   	return -2;
+	}
+
+	wpa_printf(MSG_ERROR, "ACS switch to UNII_5_7 channel successfull");
+	return 0;
+}
 
