From 2be5aa3c349dd604f7320e3b8002ccd51696a89f Mon Sep 17 00:00:00 2001
From: pvaish <pvaish@maxlinear.com>
Date: Mon, 8 Dec 2025 22:53:07 -0800
Subject: [PATCH] WLANRTSYS-97446 Updated the HT capabilities correctly during
 the STA connect flow

Signed-off-by: pvaish <pvaish@maxlinear.com>
---
 src/ap/ieee802_11_ht.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/ap/ieee802_11_ht.c b/src/ap/ieee802_11_ht.c
index 20d704361..837f3e7a8 100644
--- a/src/ap/ieee802_11_ht.c
+++ b/src/ap/ieee802_11_ht.c
@@ -53,6 +53,14 @@ u8 * hostapd_eid_ht_capabilities(struct hostapd_data *hapd, u8 *eid)
 #endif /* CONFIG_VENDOR_MXL */
 
 #ifdef CONFIG_VENDOR_MXL
+	if (hapd->iface->current_mode->mode != HOSTAPD_MODE_IEEE80211B &&
+	    hapd->iface->current_mode->mode != HOSTAPD_MODE_IEEE80211G &&
+	    (hapd->iface->conf->ht_capab & HT_CAP_INFO_DSSS_CCK40MHZ)) {
+		wpa_printf(MSG_DEBUG,
+			   "Disable HT capability [DSSS_CCK-40] on 5 GHz band");
+		cap->ht_capabilities_info &= ~HT_CAP_INFO_DSSS_CCK40MHZ;
+	}
+
 	if(hapd->iconf->ht_cap_ampdu_parameters_override_mask & 0x1)
 		cap->a_mpdu_params &= ~(HT_CAP_AMPDU_MAXIMUM_AMPDU_LENGTH_EXPONENT);
 
