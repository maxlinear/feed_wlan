 }
+
+void mxl_restore_revert_bgcac_override(struct hostapd_iface *iface)
+{
+	if (!iface->mxl_iface.dfs_revert_bgcac_override)
+		return;
+
+	iface->mxl_iface.acs_bgscan_enable = iface->mxl_iface.dfs_revert_prev_acs_bgscan_enable;
+	iface->conf->mxl_conf.background_cac = iface->mxl_iface.dfs_revert_prev_background_cac;
+	iface->conf->enable_background_radar = iface->mxl_iface.dfs_revert_prev_enable_background_radar;
+	iface->mxl_iface.dfs_revert_bgcac_override = false;
+	iface->mxl_iface.dfs_revert_prev_acs_bgscan_enable = false;
+	iface->mxl_iface.dfs_revert_prev_background_cac = false;
+	iface->mxl_iface.dfs_revert_prev_enable_background_radar = false;
+
+	wpa_printf(MSG_INFO,
+		   "DFS: restored background settings after revert bgCAC completion (acs_bgscan_enable=%d background_cac=%d enable_background_radar=%d)",
+		   iface->mxl_iface.acs_bgscan_enable,
+		   iface->conf->mxl_conf.background_cac,
+		   iface->conf->enable_background_radar);
+}
+
+bool mxl_dfs_cac_required_for_current_chandef(struct hostapd_iface *iface)
+{
+	int start_chan_idx, start_chan_idx1;
+	int n_chans, n_chans1;
+	int radar_required;
+	int all_available;
+
+	start_chan_idx = dfs_get_start_chan_idx(iface, &start_chan_idx1);
+	if (start_chan_idx < 0)
+		return false;
+
+	n_chans = dfs_get_used_n_chans(iface, &n_chans1);
+
+	radar_required = mxl_dfs_check_chans_radar(iface, start_chan_idx, n_chans);
+	if (!radar_required)
+		return false;
+
+	if (start_chan_idx1 >= 0 && n_chans1 > 0) {
+		radar_required = mxl_dfs_check_chans_radar(iface, start_chan_idx1, n_chans1);
+		if (!radar_required)
+			return false;
+	}
+
+	all_available = mxl_dfs_check_chans_available(iface, start_chan_idx, n_chans);
+	if (start_chan_idx1 >= 0 && n_chans1 > 0)
+		all_available = all_available && mxl_dfs_check_chans_available(iface, start_chan_idx1, n_chans1);
+
+	return !all_available;
+}
+
+/**
+ * mxl_dfs_try_background_cac_if_required - Check if CAC is required and attempt background CAC.
+ * @iface: Pointer to hostapd_iface structure.
+ *
+ * This function checks whether CAC is required for the current channel definition.
+ * If CAC is not required, it returns 0 (no action needed).
+ * If CAC is required and the driver supports background CAC via radar_background,
+ * this function temporarily enables the necessary settings, requests background CAC,
+ * and tracks the revert override state. If background CAC is successfully started,
+ * returns > 0. If CAC is required but background CAC cannot be started, restores
+ * the temporary overrides and returns < 0 (indicating fallback to channel switch).
+ * If CAC is required but driver does not support background CAC, returns < 0.
+ *
+ * Return codes:
+ *  > 0: Background CAC was successfully requested
+ *    0: CAC not required for current chandef
+ *  < 0: CAC required but background CAC could not start (fallback needed)
+ */
+int mxl_dfs_try_background_cac_if_required(struct hostapd_iface *iface)
+{
+	int bg_cac_res;
+
+	if (!mxl_dfs_cac_required_for_current_chandef(iface)) {
+		wpa_printf(MSG_INFO,
+			   "DFS: Current chandef does not require CAC");
+		return 0;
+	}
+
+	if (!(iface->drv_flags2 & WPA_DRIVER_FLAGS2_RADAR_BACKGROUND)) {
+		wpa_printf(MSG_DEBUG,
+			   "DFS: CAC required but driver does not support radar background, fallback needed");
+		return -1;
+	}
+
+	/* Temporarily enable background CAC settings if not already enabled */
+	if (!mxl_dfs_use_radar_background(iface) || !iface->mxl_iface.acs_bgscan_enable) {
+		iface->mxl_iface.dfs_revert_prev_acs_bgscan_enable = iface->mxl_iface.acs_bgscan_enable;
+		iface->mxl_iface.dfs_revert_prev_background_cac = iface->conf->mxl_conf.background_cac;
+		iface->mxl_iface.dfs_revert_prev_enable_background_radar = iface->conf->enable_background_radar;
+
+		iface->mxl_iface.acs_bgscan_enable = true;
+		iface->conf->mxl_conf.background_cac = true;
+		iface->conf->enable_background_radar = true;
+		iface->mxl_iface.dfs_revert_bgcac_override = true;
+
+		wpa_printf(MSG_INFO,
+			   "DFS: Temporarily enabled background CAC settings (acs_bgscan_enable=%d background_cac=%d enable_background_radar=%d)",
+			   iface->mxl_iface.acs_bgscan_enable,
+			   iface->conf->mxl_conf.background_cac,
+			   iface->conf->enable_background_radar);
+	}
+
+	wpa_printf(MSG_INFO,
+		   "DFS: Current chandef requires CAC, attempting background CAC");
+	bg_cac_res = mxl_acs_request_background_cac(iface);
+
+	if (bg_cac_res > 0) {
+		wpa_printf(MSG_INFO,
+			   "DFS: Background CAC successfully requested for chandef ch=%d freq=%d",
+			   iface->conf->channel, iface->freq);
+		return bg_cac_res;
+	}
+
+	/* bgCAC request failed, restore temporary overrides and return fallback code */
+	mxl_restore_revert_bgcac_override(iface);
+	wpa_printf(MSG_INFO,
+		   "DFS: Background CAC request failed (res=%d), fallback to channel switch needed",
+		   bg_cac_res);
+	return -1;
+}
+
+int mxl_hostapd_dfs_switch_to_iface_chandef(struct hostapd_iface *iface)
+{
+	return hostapd_dfs_request_channel_switch(
+		iface,
+		iface->conf->channel,
+		iface->freq,
+		iface->conf->secondary_channel,
+		hostapd_get_oper_chwidth(iface->conf),
+		hostapd_get_oper_centr_freq_seg0_idx(iface->conf),
+		hostapd_get_oper_centr_freq_seg1_idx(iface->conf));
+}
