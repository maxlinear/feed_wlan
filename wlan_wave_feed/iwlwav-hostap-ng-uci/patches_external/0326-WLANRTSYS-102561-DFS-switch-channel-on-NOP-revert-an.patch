+					      int channel, int freq,
+					      int secondary_channel,
+					      u8 current_vht_oper_chwidth,
+					      u8 oper_centr_freq_seg0_idx,
+					      u8 oper_centr_freq_seg1_idx)
+#endif /* CONFIG_VENDOR_MXL */
 {
 	struct hostapd_hw_modes *cmode = iface->current_mode;
 	int ieee80211_mode = IEEE80211_MODE_AP, err;
@@ -1365,7 +1374,13 @@ int hostapd_dfs_complete_cac(struct hostapd_iface *iface, int success, int freq,
 			 * selected channel and configure the background chain
 			 * to a new DFS channel.
 			 */
-			if (hostapd_dfs_is_background_event(iface, freq)) {
+#ifndef CONFIG_VENDOR_MXL
+			if (hostapd_dfs_is_background_event(iface, freq))
+#else /* CONFIG_VENDOR_MXL */
+			if (hostapd_dfs_is_background_event(iface, freq) &&
+			    !iface->mxl_iface.dfs_revert_bgcac_override)
+#endif /* CONFIG_VENDOR_MXL */
+			{
 				iface->radar_background.cac_started = 0;
 				if (!iface->radar_background.temp_ch)
 					return 0;
@@ -1418,11 +1433,16 @@ int hostapd_dfs_complete_cac(struct hostapd_iface *iface, int success, int freq,
 	iface->radar_detected = false;
 #ifdef CONFIG_VENDOR_MXL
 	/* In case of CAC completion in ZWDFS antenna/interface, set CAC cleared channel to operational 5G vaps.*/
-	if (mxl_validate_second_best_chan(iface)) {
+	if (mxl_validate_second_best_chan(iface) &&
+	    !iface->mxl_iface.dfs_revert_bgcac_override) {
 		wpa_printf(MSG_DEBUG, "second best channel CAC completed");
 		return 0;
 	}
-	return mxl_hostapd_handle_zwdfs_switch(iface, success, freq, chan_width, cf1, cf2);
+	{
+		int ret = mxl_hostapd_handle_zwdfs_switch(iface, success, freq, chan_width, cf1, cf2);
+		mxl_restore_revert_bgcac_override(iface);
+		return ret;
+	}
 #endif /* CONFIG_VENDOR_MXL */
 	return 0;
 }
@@ -1933,11 +1953,31 @@ int hostapd_dfs_nop_finished(struct hostapd_iface *iface, int freq,
 					   iface->mxl_iface.dfs_revert_chandef.channel,
 					   iface->mxl_iface.dfs_revert_chandef.freq,
 					   iface->mxl_iface.dfs_revert_chandef.oper_chwidth);
-				mxl_dfs_apply_revert_chandef(iface);
+			mxl_dfs_apply_revert_chandef(iface);
+			{
+				int cac_res = mxl_dfs_try_background_cac_if_required(iface);
+				if (cac_res > 0) {
+					/* bgCAC successfully started, return and wait for CAC completion */
+					wpa_printf(MSG_INFO,
+						   "DFS: background CAC started for restored chandef ch=%d freq=%d",
+						   iface->conf->channel, iface->freq);
+					iface->mxl_iface.dfs_revert_chandef.valid = false;
+					return 0;
+				}
+				/* cac_res == 0: CAC not required; cac_res < 0: bgCAC failed, both allow fallback to channel switch */
+				if (cac_res == 0) {
+					wpa_printf(MSG_INFO,
+						   "DFS: restored chandef does not require CAC, proceeding with channel switch");
+				} else {
+					wpa_printf(MSG_INFO,
+						   "DFS: bgCAC needed but could not start, falling back to channel switch");
+				}
+			}
 				iface->mxl_iface.dfs_revert_chandef.valid = false;
-				hostapd_disable_iface(iface);
-				hostapd_enable_iface(iface);
-				return 0;
+				wpa_printf(MSG_INFO,
+					   "DFS: triggering channel switch flow for restored chandef ch=%d freq=%d",
+					   iface->conf->channel, iface->freq);
+				return mxl_hostapd_dfs_switch_to_iface_chandef(iface);
 			}
 
 			iface->mxl_iface.dfs_revert_chandef.valid = false;
