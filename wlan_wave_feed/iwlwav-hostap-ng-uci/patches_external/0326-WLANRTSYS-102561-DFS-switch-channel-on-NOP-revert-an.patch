 src/ap/dfs.h            |   6 ++
 src/ap/hw_features.c    |   3 +
 src/ap/mxl_dfs_common.c | 133 ++++++++++++++++++++++++++++++++++++++++
 src/ap/mxl_dfs_common.h |   4 ++
 src/ap/mxl_hostapd.h    |   4 ++
 6 files changed, 197 insertions(+), 7 deletions(-)

