 	}
 	mxl_send_scs_resp(hapd, mgmt, status_list, scs_count);
 }
+#endif /* CONFIG_SCS_MXL */
+
+#ifdef CONFIG_MSCS_MXL
+int mxl_mscs_parse_tclas_mask_elems(const u8 *pos, struct mxl_mscs_add_req *mscs_add_req)
+{
+	u8 class_type;
+
+	if (*pos++ != WLAN_EID_EXT_TCLAS_MASK)
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	
+	if (*pos++ != CLASSIFIER_TYPE4) {
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	mscs_add_req->class_mask = *pos++;
+
+	return WLAN_STATUS_SUCCESS;
+}
+
+int mxl_mscs_add_req(struct hostapd_data *hapd, const struct ieee80211_mgmt *mgmt, const u8 *pos, size_t len)
+{
+	const u8 *end;
+	u8 eid, elen;
+	u16 up_ctrl;
+	struct sta_info *sta;
+	struct mxl_mscs_add_req mscs_add_req;
+
+	os_memset(&mscs_add_req, 0, sizeof(struct mxl_mscs_add_req));
+
+	if (!hapd->conf->mxl_bss_conf.mscs_enable) {
+		wpa_printf(MSG_ERROR, "MSCS: mxl_mscs_add_req - not enabled/supported");
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	sta = ap_get_sta(hapd, mgmt->sa);
+	if (sta == NULL) {
+		wpa_printf(MSG_ERROR, "MSCS: mxl_mscs_add_req - station not connected");
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	if (sta->mxl_sta_info.sta_mscs_ie.mscs_active) {
+		wpa_printf(MSG_ERROR, "MSCS: mxl_mscs_add_req - MSCS already active");
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	mscs_add_req.aid = sta->aid;
+
+	os_memcpy(&up_ctrl, pos, sizeof(u16));
+	up_ctrl = le_to_host16(up_ctrl);
+	pos += sizeof(u16);
+	mscs_add_req.up_bitmap = up_ctrl & 0xFF;
+	mscs_add_req.up_limit = (up_ctrl >> 8) & 0x07;
+
+	os_memcpy(&mscs_add_req.stream_timeout, pos, sizeof(u32));
+	pos += sizeof(u32);
+
+	len = len - (sizeof(u16) + sizeof(u32)); /* Remove len of up_ctrl, stream timeout */
 
-void mxl_hostapd_scs_action(struct hostapd_data *hapd,
+	end = pos + len;
+
+	while (pos + 2 <= end) {
+		eid = *pos++;
+		elen = *pos++;
+
+		if (end - pos < elen)
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+
+		switch (eid) {
+			case WLAN_EID_EXTENSION:
+				if (mxl_mscs_parse_tclas_mask_elems(pos, &mscs_add_req)) {
+					return WLAN_STATUS_UNSPECIFIED_FAILURE;
+				}
+				break;
+			default:
+				return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+
+		pos += elen;
+	}
+
+	if (MXL_DRV_VENDOR_SET(LTQ_NL80211_VENDOR_SUBCMD_MSCS_ADD_REQ,
+				&mscs_add_req, sizeof(struct mxl_mscs_add_req))) {
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+	sta->mxl_sta_info.sta_mscs_ie.mscs_active = true;
+	wpa_msg(hapd->msg_ctx, MSG_INFO, AP_STA_MSCS_ADD);
+	wpa_msg_no_global(hapd->msg_ctx_parent, MSG_INFO, AP_STA_MSCS_ADD);
+	return WLAN_STATUS_SUCCESS;
+}
+
+static void mxl_send_mscs_resp(struct hostapd_data *hapd,
+			const struct ieee80211_mgmt *mgmt, int status)
+{
+	u8 buf[256];
+	struct ieee80211_mgmt *mgmt_resp = (struct ieee80211_mgmt *) buf;
+	struct sta_info *sta;
+
+	sta = ap_get_sta(hapd, mgmt->sa);
+	if (sta == NULL) {
+		wpa_printf(MSG_ERROR, "MSCS: mxl_send_scs_resp - station not connected");
+		return;
+	}
+
+	wpa_printf(MSG_DEBUG, "handle_mscs_resp");
+	os_memset(buf, 0, sizeof(buf));
+	mgmt_resp->frame_control = IEEE80211_FC(WLAN_FC_TYPE_MGMT, WLAN_FC_STYPE_ACTION);
+	os_memcpy(mgmt_resp->da, mgmt->sa, ETH_ALEN);
+	os_memcpy(mgmt_resp->sa, hapd->own_addr, ETH_ALEN);
+	os_memcpy(mgmt_resp->bssid, hapd->own_addr, ETH_ALEN);
+
+	mgmt_resp->u.action.category = WLAN_ACTION_ROBUST_AV_STREAMING;
+	mgmt_resp->u.action.u.mscs_action_resp.action = ROBUST_AV_MSCS_RESP;
+	mgmt_resp->u.action.u.mscs_action_resp.dialog_token = mgmt->u.action.u.mscs_action_req.dialog_token;
+	mgmt_resp->u.action.u.mscs_action_resp.status = status;
+	if (hostapd_drv_send_mlme(hapd, mgmt_resp, IEEE80211_HDRLEN + sizeof(mgmt_resp->u.action.u.mscs_action_resp) +
+										sizeof(mgmt_resp->u.action.category), 0, NULL, 0, 0) < 0)
+		wpa_printf(MSG_DEBUG, "ROBUST AV scs_action_send_resp: send failed");
+}
+
+int mxl_mscs_remove_req(struct hostapd_data *hapd,
+		const struct ieee80211_mgmt *mgmt, size_t len)
+ {
+	struct sta_info *sta;
+	u16 aid;
+
+	sta = ap_get_sta(hapd, mgmt->sa);
+	if (sta == NULL) {
+		wpa_printf(MSG_ERROR, "MSCS: mscs_rem_req - station not connected");
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	if (!sta->mxl_sta_info.sta_mscs_ie.mscs_active) {
+		wpa_printf(MSG_ERROR, "MSCS: mscs_rem_req - No active MSCS to remove");
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	aid = sta->aid;
+	if (MXL_DRV_VENDOR_SET(LTQ_NL80211_VENDOR_SUBCMD_MSCS_REM_REQ,
+	    &aid, sizeof(u16))) {
+		wpa_printf(MSG_ERROR, "send LTQ_NL80211_VENDOR_SUBCMD_SEND_MSCS_REM_REQ failed!!!");
+		//TODO: Modify the enum based on specification for varied failure reasons.
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+	sta->mxl_sta_info.sta_mscs_ie.mscs_active = false;
+	wpa_msg(hapd->msg_ctx, MSG_INFO, AP_STA_MSCS_REM);
+	wpa_msg_no_global(hapd->msg_ctx_parent, MSG_INFO, AP_STA_MSCS_REM);
+	return WLAN_STATUS_TCLAS_PROCESSING_TERMINATED;
+}
+
+void mxl_handle_mscs_req(struct hostapd_data *hapd,
 			const struct ieee80211_mgmt *mgmt, size_t len)
 {
-	u8 *action = (u8 *) &mgmt->u.action.u;
+	int status;
 
-	if (!hapd->conf->mxl_bss_conf.scs_enable) {
-      wpa_printf(MSG_ERROR, "SCS: mxl_scs_add_req - not enabled/supported");
-      return;
-   }
+	const u8 *pos = mgmt->u.action.u.mscs_action_req.variable;
+	u8 req_type, ext_eid, eid, elen;
+
+	if (!hapd->conf->mxl_bss_conf.mscs_enable) {
+		wpa_printf(MSG_ERROR, "MSCS: mxl_handle_mscs_req - not enabled/supported");
+		return;
+	}
+
+	eid = *pos++;
+	if(eid != WLAN_EID_EXTENSION) {
+	  wpa_printf(MSG_ERROR, "MSCS: mxl_handle_mscs_req - MSCS Descriptor element is not present");
+	  return;
+	}
+
+	elen = *pos++;
+	ext_eid = *pos++;
+	if(ext_eid != WLAN_EID_EXT_MSCS_DESCRIPTOR) {
+		wpa_printf(MSG_ERROR, "MSCS: mxl_handle_mscs_req - MSCS Descriptor element is not present");
+		return;
+	}
+	elen --; /* Subtract ext eid */
+
+	req_type = *pos++;
+	elen --; /* Subtract req_type */
+
+	switch(req_type)
+	{
+		case MSCS_REQ_ADD:
+			status = mxl_mscs_add_req(hapd, mgmt, pos, elen);
+			mxl_send_mscs_resp(hapd, mgmt, status);
+			break;
+		case MSCS_REQ_REMOVE:
+			status = mxl_mscs_remove_req(hapd, mgmt, elen);
+			mxl_send_mscs_resp(hapd, mgmt, status);
+			break;
+		case MSCS_REQ_CHANGE:
+			status = mxl_mscs_remove_req(hapd, mgmt, elen);
+			if (status == WLAN_STATUS_TCLAS_PROCESSING_TERMINATED)
+				status = mxl_mscs_add_req(hapd, mgmt, pos, elen);
+			mxl_send_mscs_resp(hapd, mgmt, status);
+			break;
+		default:
+			hostapd_logger(hapd, mgmt->sa, HOSTAPD_MODULE_IEEE80211,
+			        HOSTAPD_LEVEL_DEBUG,
+			        "hostapd_mscs_req - unknown request type %d",
+			        req_type);
+			return;
+	}
+}
