+void mxl_ap_free_sta(struct hostapd_data *hapd, struct sta_info *sta)
+{
+#ifdef CONFIG_MSCS_MXL
+	os_free(sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor);
+#endif /* CONFIG_MSCS_MXL */
+}
+
+#ifdef CONFIG_MSCS_MXL
+void mxl_set_sta_info_mscs_descriptor(struct hostapd_data *hapd, struct sta_info *sta,
+													const u8* elems_mscs_desc, size_t elems_mscs_len)
+{
+	if (!(hapd->conf->mxl_bss_conf.mscs_enable &&
+				elems_mscs_desc && elems_mscs_len))
+		return;
+
+	os_free(sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor);
+	sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor = os_memdup(elems_mscs_desc, elems_mscs_len);
+	if (sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor)
+		sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor_len = elems_mscs_len;
+	else
+		sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor_len = 0;
+}
+
+void mxl_assoc_req_mscs_add(struct hostapd_data *hapd, const struct ieee80211_mgmt *mgmt,
+									 struct sta_info *sta, int resp)
+{
+	u8 *pos;
+	u8 len;
+
+	if ((sta) && (sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor) &&
+			(sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor_len)&&
+			(resp == WLAN_STATUS_SUCCESS)) {
+		pos = sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor;
+		len = sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor_len;
+		if ((*pos++ == 0) && (!sta->mxl_sta_info.sta_mscs_ie.mscs_active)) {/* pos = request type Add */
+			len--; /* subtract req_type len */
+			sta->mxl_sta_info.sta_mscs_ie.mscs_status = mxl_mscs_add_req(hapd, mgmt,pos,len);
+			if (sta->mxl_sta_info.sta_mscs_ie.mscs_status == WLAN_STATUS_SUCCESS)
+				sta->mxl_sta_info.sta_mscs_ie.mscs_active = true;
+		}
+		os_free(sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor);
+		sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor = NULL;
+		sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor_len = 0;
+	}
+}
+#endif /* CONFIG_MSCS_MXL */
 #endif /* CONFIG_NATIVE_WINDOWS */
