diff --git a/hostapd/mxl_ctrl_iface.c b/hostapd/mxl_ctrl_iface.c
index 05bffd789..f4d4e93fc 100644
--- a/hostapd/mxl_ctrl_iface.c
+++ b/hostapd/mxl_ctrl_iface.c
@@ -3135,6 +3135,35 @@ static int mxl_hostapd_ctrl_iface_get_scs_enable(struct hostapd_data *hapd, char
 }
 #endif
 
+#ifdef CONFIG_MSCS_MXL
+static int mxl_hostapd_drv_get_mscs_enable(struct hostapd_data *hapd, int *enabled)
+{
+	int ret;
+
+	ret = MXL_DRV_VENDOR_GET(LTQ_NL80211_VENDOR_SUBCMD_GET_MSCS_ENABLE, NULL, 0, enabled, sizeof(*enabled));
+	if (ret < 0)
+		wpa_printf(MSG_ERROR, "nl80211: sending GET_MSCS_ENABLE failed: %i (%s)", ret, strerror(-ret));
+	return ret;
+}
+
+static int mxl_hostapd_ctrl_iface_get_mscs_enable(struct hostapd_data *hapd, char *reply, size_t reply_size)
+{
+	int res = 0;
+	int enabled;
+
+	if (mxl_hostapd_drv_get_mscs_enable(hapd, &enabled))
+		return -1;
+
+	res = sprintf_s(reply, reply_size, "%d\n", enabled);
+	if (res <= 0) {
+		wpa_printf(MSG_ERROR, "%s: sprintf_s error %d", __func__, res);
+		return -1;
+	}
+
+	return res;
+}
+#endif /* CONFIG_MSCS_MXL */
+
 int mxl_hostapd_ctrl_iface_receive_process(struct hostapd_data *hapd,
 					      char *buf, char *reply,
 					      int reply_size,
@@ -3367,6 +3396,11 @@ int mxl_hostapd_ctrl_iface_receive_process(struct hostapd_data *hapd,
 		if (mxl_hostapd_ctrl_iface_get_scs_enable(hapd, reply, reply_size) < 0)
 			*reply_len = -1;
 #endif /* CONFIG_SCS */
+#ifdef CONFIG_MSCS_MXL
+	} else if (os_strncmp(buf, "GET_MSCS_ENABLE", 15) == 0) {
+		if (mxl_hostapd_ctrl_iface_get_mscs_enable(hapd, reply, reply_size) < 0)
+			*reply_len = -1;
+#endif /* CONFIG_MSCS */
 	} else {
 		return 0;
 	}
