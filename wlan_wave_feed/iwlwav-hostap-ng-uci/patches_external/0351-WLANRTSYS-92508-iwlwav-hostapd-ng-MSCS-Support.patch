diff --git a/src/ap/mxl_ieee802_11_shared.c b/src/ap/mxl_ieee802_11_shared.c
index 94cb81604..deaa50cb4 100644
--- a/src/ap/mxl_ieee802_11_shared.c
+++ b/src/ap/mxl_ieee802_11_shared.c
@@ -135,3 +135,38 @@ u8 * mxl_hostapd_eid_wce(struct hostapd_data *hapd, u8 *eid, size_t len)
 }
 #endif /* CONFIG_SCS_MXL */
 #endif /* CONFIG_IEEE80211BE_MXL_MLO */
+
+#ifdef CONFIG_MSCS_MXL
+u8 * mxl_hostapd_eid_mscs(struct hostapd_data *hapd, u8 *eid, size_t len, u16 status, struct sta_info *sta)
+{
+	u16 up_ctrl = 0;
+	u32 stream_timeout = 0;
+	u8 *pos = eid;
+	u8 elen = MSCS_IE_ASSOC_RESP_LEN;
+
+	if (!(hapd->conf->mxl_bss_conf.mscs_enable && sta &&
+				sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor &&
+				sta->mxl_sta_info.sta_mscs_ie.mscs_descriptor_len &&
+				sta->mxl_sta_info.sta_mscs_ie.mscs_active))
+		return eid;
+
+	if (len < elen) {
+		wpa_printf(MSG_ERROR,"Not enough room in buffer MSCS Element IE: buf len = %zu", len);
+		return eid;
+	}
+
+	*pos++ = WLAN_EID_EXTENSION;
+	*pos++ = elen-2;
+	*pos++ = WLAN_EID_EXT_MSCS_DESCRIPTOR;
+	*pos++ = 0; /* request type ADD */
+	WPA_PUT_BE16(pos, up_ctrl);
+	pos += sizeof(u16); /* Len of up_ctrl */
+	WPA_PUT_BE32(pos, stream_timeout);
+	pos += sizeof(u32); /*Len of stream timeout */
+	*pos++ = MCSC_SUBELEM_STATUS; /*MSCS Subelement ID */ 
+	*pos++ = sizeof(u16); /*MSCS subelement len */
+	WPA_PUT_BE16(pos, status);
+	pos += sizeof(u16); /* Len of status */
+	return pos;
+}
+#endif
