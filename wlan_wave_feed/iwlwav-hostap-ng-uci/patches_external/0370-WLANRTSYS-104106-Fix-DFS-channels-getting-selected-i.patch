 	bool acs_bootup_non_dfs_done;
+	os_time_t acs_bootup_non_dfs_expected_expiry; /* Absolute time (epoch secs) the bootup non-DFS timer is due to fire, 0 if not armed */
 	int acs_reenable_iface;
 	/* iface->conf snapshot taken right before a live (already-enabled)
 	 * ACS re-run commits a new candidate, for acs_reenable_iface's switch
@@ -434,6 +435,7 @@ struct hostapd_data *mxl_hostapd_get_setup_mbssid_bss(struct hostapd_iface *ifac
 size_t mxl_hostapd_get_mbssid_tx_bss_idx(struct hostapd_iface *iface);
 struct hostapd_data *mxl_hostapd_mbssid_get_tx_bss(struct hostapd_data *hapd);
 bool mxl_hostapd_is_mbssid_tx_bss(struct hostapd_data *hapd);
+void mxl_acs_start_bgscan_or_bootup_timer(struct hostapd_data *hapd);
