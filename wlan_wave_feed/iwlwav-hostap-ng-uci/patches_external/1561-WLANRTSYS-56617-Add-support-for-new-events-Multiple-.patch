+++ b/src/ap/wpa_auth.c
@@ -3841,8 +3841,10 @@ SM_STATE(WPA_PTK, PTKCALCNEGOTIATING)
 		wpa_auth_logger(sm->wpa_auth, wpa_auth_get_spa(sm),
 				LOGGER_DEBUG,
