From 4c80bb1661bd38c46ab0b9547061b994b5c31ed0 Mon Sep 17 00:00:00 2001
From: pvaish <pvaish@maxlinear.com>
Date: Tue, 2 Dec 2025 03:26:59 -0800
Subject: [PATCH] WLANRTSYS-89078 Announcing an event AP_BW_CHANGED when OBSS
 AP is already present during ap boot up time.

Signed-off-by: pvaish <pvaish@maxlinear.com>
---
 src/ap/hw_features.c   |  6 ++++++
 src/ap/ieee802_11_ht.c | 22 +++++++++++++++-------
 2 files changed, 21 insertions(+), 7 deletions(-)

diff --git a/src/ap/hw_features.c b/src/ap/hw_features.c
index 697be8466..be3b76a13 100644
--- a/src/ap/hw_features.c
+++ b/src/ap/hw_features.c
@@ -28,6 +28,7 @@
 #include "mxl_hostapd.h"
 #include "mxl_dfs_file.h"
 #include "mxl_dfs_common.h"
+#include "common/mxl_wpa_ctrl.h"
 #endif /* CONFIG_VENDOR_MXL */
 
 
@@ -440,6 +441,11 @@ static void ieee80211n_check_scan(struct hostapd_iface *iface)
 		hostapd_set_oper_chwidth(iface->conf, CONF_OPER_CHWIDTH_USE_HT);
 		res = 1;
 		wpa_printf(MSG_INFO, "Fallback to 20 MHz");
+#ifdef CONFIG_VENDOR_MXL
+		wpa_msg(iface->bss[0]->msg_ctx, MSG_INFO, AP_BW_CHANGED "freq=%d Channel=%d OperatingChannelBandwidth=%d cf1=%d cf2=%d reason=%s",
+		iface->freq, iface->conf->channel, hostapd_get_oper_chwidth(iface->conf),
+		hostapd_get_oper_centr_freq_seg0_idx(iface->conf), hostapd_get_oper_centr_freq_seg1_idx(iface->conf), "OBSS");
+#endif
 	}
 
 	hostapd_setup_interface_complete(iface, !res);
diff --git a/src/ap/ieee802_11_ht.c b/src/ap/ieee802_11_ht.c
index 9f4286822..c2ca9f86f 100644
--- a/src/ap/ieee802_11_ht.c
+++ b/src/ap/ieee802_11_ht.c
@@ -202,13 +202,21 @@ static void set_ht_param(struct hostapd_data *hapd,
 		return; /* Do not indicate punctured secondary channel for HT */
 no_update:
 #endif /* CONFIG_IEEE80211BE */
-
-	if (secondary_channel == 1)
-		oper->ht_param |= HT_INFO_HT_PARAM_SECONDARY_CHNL_ABOVE |
-			HT_INFO_HT_PARAM_STA_CHNL_WIDTH;
-	if (secondary_channel == -1)
-		oper->ht_param |= HT_INFO_HT_PARAM_SECONDARY_CHNL_BELOW |
-			HT_INFO_HT_PARAM_STA_CHNL_WIDTH;
+	
+		if (secondary_channel == 1)
+			oper->ht_param |= HT_INFO_HT_PARAM_SECONDARY_CHNL_ABOVE |
+				HT_INFO_HT_PARAM_STA_CHNL_WIDTH;
+		if (secondary_channel == -1)
+			oper->ht_param |= HT_INFO_HT_PARAM_SECONDARY_CHNL_BELOW |
+				HT_INFO_HT_PARAM_STA_CHNL_WIDTH;
+		if (secondary_channel == 0) {
+			oper->ht_param &= ~HT_INFO_HT_PARAM_STA_CHNL_WIDTH;
+			oper->ht_param &= ~HT_INFO_HT_PARAM_SECONDARY_CHNL_OFF_MASK;
+		 }
+#ifdef CONFIG_VENDOR_MXL
+	if (hapd->iconf->ht_rifs)
+		oper->ht_param |= HT_INFO_HT_PARAM_RIFS_MODE;
+#endif /* CONFIG_VENDOR_MXL */
 }
 
 
-- 
