From da70b10fdefcb607a8b642cdc9ab8e3aa1adc8fc Mon Sep 17 00:00:00 2001
From: Jurijs Soloveckis <jsoloveckis@maxlinear.com>
Date: Wed, 17 May 2023 15:55:41 +0200
Subject: [PATCH] WLANRTSYS-55314: Align HT capabilities

- WLANRTSYS-48323: HT Information: Reduced Interframe Spacing (RIFS)
---
 hostapd/config_file.c | 8 ++++++++
 src/ap/ap_config.c    | 1 +
 src/ap/ap_config.h    | 1 +
 3 files changed, 10 insertions(+)

diff --git a/hostapd/config_file.c b/hostapd/config_file.c
index 504121b0f..0c49e35bf 100644
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -3725,6 +3725,14 @@ static int hostapd_config_fill(struct hostapd_config *conf,
 				   line);
 			return 1;
 		}
+	} else if (os_strcmp(buf, "ht_rifs") == 0) {
+		int val = atoi(pos);
+		if (!IS_VALID_BOOL_RANGE(val)) {
+			wpa_printf(MSG_ERROR, "Line %d: invalid ht_rifs %d",
+				line, val);
+			return 1;
+		}
+		conf->ht_rifs = val;
 	} else if (os_strcmp(buf, "require_ht") == 0) {
 		conf->require_ht = atoi(pos);
 	} else if (os_strcmp(buf, "ht_vht_twt_responder") == 0) {
diff --git a/src/ap/ap_config.c b/src/ap/ap_config.c
index 7a58a1be9..594bafeeb 100644
--- a/src/ap/ap_config.c
+++ b/src/ap/ap_config.c
@@ -266,6 +266,7 @@ struct hostapd_config * hostapd_config_defaults(void)
 	conf->tx_queue[2] = txq_be;
 	conf->tx_queue[3] = txq_bk;
 
+	conf->ht_rifs = 1;
 	conf->ht_capab = HT_CAP_INFO_SMPS_DISABLED;
 	conf->ht_tx_bf_capab = 0;
 	conf->ht_tx_bf_capab_from_hw = 1;
diff --git a/src/ap/ap_config.h b/src/ap/ap_config.h
index 6a0e04196..5bcd10a24 100644
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -1195,6 +1195,7 @@ struct hostapd_config {
 	int ieee80211n;
 	int secondary_channel;
 	int no_pri_sec_switch;
+	int ht_rifs;
 	int require_ht;
 	int obss_interval;
 	u32 vht_capab;
-- 
2.43.0

