+static void hostapd_get_op_class(int chan, int width, int *op_class)
+{
+	/* Default op_class for 5GHz */
+	*op_class = 130;
+
+	switch (width) {
+	case 20:
+	case 40:
+		if (chan >= 36 && chan <= 64) {
+			*op_class = 115;
+		} else if (chan >= 100 && chan <= 140) {
+			*op_class = 121;
+		} else if (chan >= 149 && chan <= 161) {
+			*op_class = 124;
+		} else if (chan > 161 && chan <= 177) {
+			*op_class = 125;
+		}
+		break;
+
+	case 80:
+		if (chan >= 36 && chan <= 177) {
+			*op_class = 128;
+		}
+		break;
+
+	case 160:
+		if (chan >= 36 && chan <= 177) {
+			*op_class = 129;
+		}
+		break;
+
+	default:
+		/* Unknown width, keep default op_class */
+		break;
+	}
+}
