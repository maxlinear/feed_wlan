+/* Given primary channel + bandwidth, check if DFS is required */
+int mxl_is_dfs_channel(int primary_chan, int bandwidth)
+{
+	int num_subch = bandwidth / 20;
+	int first_chan;
+
+	/* Compute first 20 MHz sub-channel number */
+	if (bandwidth == 20)
+		first_chan = primary_chan;
+	else if (bandwidth == 40) {
+		if ((primary_chan % 8) == 4)  /* upper */
+			first_chan = primary_chan - 4;
+		else
+			first_chan = primary_chan;
+		} else if (bandwidth == 80) {
+			first_chan = (primary_chan - 36) / 16 * 16 + 36;
+		} else if (bandwidth == 160) {
+			first_chan = (primary_chan - 36) / 32 * 32 + 36;
+		} else
+			return is_dfs_channel(primary_chan); /* fallback */
+
+	/* Check all sub-channels in the block */
+	for (int i = 0; i < num_subch; i++) {
+		int chan = first_chan + i*4; /* channel numbers increase by 4 */
+		if (is_dfs_channel(chan))
+			return 1; /* DFS needed */
+		}
+	return 0; /* All non-DFS */
 }
 
