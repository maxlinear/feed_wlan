From bf2b5bb7afebf6b97d4f93e469a58ae4ad9a5fd8 Mon Sep 17 00:00:00 2001
From: Dmitrijs Martinovs <dmartinovs@maxlinear.com>
Date: Wed, 13 Sep 2023 14:48:17 +0200
Subject: [PATCH] WLANRTSYS-58550: Disabled VAPs should not handle probes

---
 src/ap/beacon.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/ap/beacon.c b/src/ap/beacon.c
index 3a0e88292..007ae1e7a 100644
--- a/src/ap/beacon.c
+++ b/src/ap/beacon.c
@@ -1585,6 +1585,9 @@ void handle_probe_req(struct hostapd_data *hapd,
 	};
 #endif /* UBUS_SUPPORT */
 
+	if(!hapd->started || !hapd->beacon_set_done)
+		return;
+
 	if (hapd->iconf->rssi_ignore_probe_request && ssi_signal &&
 	    ssi_signal < hapd->iconf->rssi_ignore_probe_request)
 		return;
-- 
2.43.0

