 	scs_add_req.aid = sta->aid;
 	scs_add_req.status = 0;
-	scs_add_req.scsid = mgmt->u.action.u.scs_action_req.scsId;
+	scs_add_req.scsid = scsId;
 
 	while (pos + 2 <= end) {
 		eid = *pos++;
 		elen = *pos++;
 
-		if (end - pos < elen)
+		if (end - pos < elen) {
 			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
 
 		switch (eid) {
 		case WLAN_EID_INTRA_ACCESS_CATEGORY_PRIORITY:
@@ -459,18 +466,17 @@ int mxl_scs_add_req(struct hostapd_data *hapd, const struct ieee80211_mgmt *mgmt
 		case WLAN_EID_TCLAS:
 			if (mxl_scs_parse_tclas_elems(pos, &scs_add_req, elen, &tclas_elems_num))
 				return WLAN_STATUS_UNSPECIFIED_FAILURE;
-			has_tclas_elems = true;
 			break;
 		case WLAN_EID_TCLAS_PROCESSING:
 			/* the processing field = 0 , indicates it should match to *
 			 * all the parameters associated with TCLAS elems */
 			if (*pos != 0 || tclas_elems_num <=1)
 			   return WLAN_STATUS_UNSPECIFIED_FAILURE;
-			has_tclas_process = true;
 			break;
 		case WLAN_EID_EXTENSION:
 			if (mxl_scs_parse_qos_characteristics_elems(pos, &scs_add_req))
 				return WLAN_STATUS_UNSPECIFIED_FAILURE;
+			qos_characteristic_elems = true;
 			break;
 		case WLAN_EID_VENDOR_SPECIFIC:
 			/*Need to verify, EID populated as optional subelement *
@@ -485,9 +491,12 @@ int mxl_scs_add_req(struct hostapd_data *hapd, const struct ieee80211_mgmt *mgmt
 		pos += elen;
 	}
 
-	/* TCLAS elems without TCLAS_PROCESSING elems is illegal */
-	if (has_tclas_elems && !has_tclas_process)
-		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	/* The direction bit is part of qos characteristics IE. *
+	 * For the DL QM SCS TCs 4.5.1 and 4.5.2, QoS IE not present. *
+	 * For the UL EHT TC 4.47.1, populates the QoS IE. *
+	 * As of now to pass the TCs, assumption is that if no QoS IE, then direction is DL */
+	if (!qos_characteristic_elems)
+		scs_add_req.direction = QOS_CTRL_INFO_DL;
 
 	if (MXL_DRV_VENDOR_SET(LTQ_NL80211_VENDOR_SUBCMD_SCS_ADD_REQ,
 				&scs_add_req, sizeof(struct mxl_scs_add_req))) {
@@ -500,7 +509,7 @@ int mxl_scs_add_req(struct hostapd_data *hapd, const struct ieee80211_mgmt *mgmt
 }
 
 int mxl_scs_remove_req(struct hostapd_data *hapd,
-			const struct ieee80211_mgmt *mgmt, size_t len)
+			const struct ieee80211_mgmt *mgmt, size_t len, u8 scsId)
 {
 	struct sta_info *sta;
 	struct mxl_scs_rem_req scs_rem_req;
