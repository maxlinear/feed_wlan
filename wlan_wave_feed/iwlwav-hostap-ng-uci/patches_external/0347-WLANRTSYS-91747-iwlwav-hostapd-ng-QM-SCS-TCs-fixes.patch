-		wpa_printf(MSG_ERROR, "SCS: mxl_handle_scs_req - SCS Descriptor element is not present");
-		return;
-	}
-	u8 reqType =mgmt->u.action.u.scs_action_req.reqType;
-	wpa_printf(MSG_DEBUG, "SCS req_type =%d",reqType);
