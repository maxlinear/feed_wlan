+		elen = *pos++;
+		scsId = *pos ++;
+		elen--; /* Subtract scsId len from elen */
+		reqType = *pos ++;
+		elen--; /* Subtract reqType len from elen */
+		switch(reqType)
+		{
+			case SCS_REQ_ADD:
+				status = mxl_scs_add_req(hapd, mgmt, pos, elen, scsId);
+				status_list[scs_count].scsId = scsId;
