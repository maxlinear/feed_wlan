From c54281f5ca391711c99b78481105262db66850c6 Mon Sep 17 00:00:00 2001
From: Karthik D A <karthikda@maxlinear.com>
Date: Tue, 15 Jul 2025 18:37:59 +0800
Subject: [PATCH] WLANRTSYS-91747 iwlwav-hostapd-ng: QM SCS TCs fixes

Description: The SCS support was added in r1206CV, and the validation
of the feature is achieved by executing the QM certification
SCS TCs 4.5.1_24G/5G, 4.5.2_24G/5G.
Both the TCs failed, and the PR consists of the fix for the same.

Verification: Executed the QM SCS TCs, and TCs passed successfully.

Signed-off-by: Karthik D A <karthikda@maxlinear.com>
---
 src/ap/mxl_sta_info.h            |   6 +
 src/ap/mxl_wmm.c                 | 203 ++++++++++++++++++-------------
 src/ap/mxl_wmm.h                 |   4 +-
 src/common/ieee802_11_defs.h     |   7 +-
 src/common/mxl_ieee802_11_defs.h |  22 ++--
 5 files changed, 137 insertions(+), 105 deletions(-)

diff --git a/src/ap/mxl_sta_info.h b/src/ap/mxl_sta_info.h
index 2726b0f14..0fdaa2a3a 100644
--- a/src/ap/mxl_sta_info.h
+++ b/src/ap/mxl_sta_info.h
@@ -16,6 +16,12 @@
 #include "utils/common.h"
 
 struct hostapd_data;
+struct mxl_scs_status_list
+{
+	u8 scsId;
+	u16 status;
+}__attribute__ ((packed));
+
 struct mxl_sta_info {
 	u8 multi_ap_profile; /* Multi-AP spec agent Profile (1/2) */
 #ifdef CONFIG_LEGACY_MULTI_AP_MXL
diff --git a/src/ap/mxl_wmm.c b/src/ap/mxl_wmm.c
index 5a1fe521b..201384b81 100644
--- a/src/ap/mxl_wmm.c
+++ b/src/ap/mxl_wmm.c
@@ -174,7 +174,7 @@ void mxl_hostapd_eht_protected(struct hostapd_data *hapd,
 
 #ifdef CONFIG_SCS_MXL
 static void mxl_send_scs_resp(struct hostapd_data *hapd,
-			const struct ieee80211_mgmt *mgmt, int status)
+			const struct ieee80211_mgmt *mgmt, struct mxl_scs_status_list *status_list, u8 scs_count)
 {
 	u8 buf[256];
 	struct ieee80211_mgmt *mgmt_resp = (struct ieee80211_mgmt *) buf;
@@ -197,10 +197,12 @@ static void mxl_send_scs_resp(struct hostapd_data *hapd,
 	mgmt_resp->u.action.category = WLAN_ACTION_ROBUST_AV_STREAMING;
 	mgmt_resp->u.action.u.scs_action_resp.action = ROBUST_AV_SCS_RESP;
 	mgmt_resp->u.action.u.scs_action_resp.dialog_token = mgmt->u.action.u.scs_action_req.dialog_token;
-	mgmt_resp->u.action.u.scs_action_resp.count = 1;
-	mgmt_resp->u.action.u.scs_action_resp.scsId = mgmt->u.action.u.scs_action_req.scsId;
-	mgmt_resp->u.action.u.scs_action_resp.status = status;
-	if (hostapd_drv_send_mlme(hapd, mgmt_resp, IEEE80211_HDRLEN + sizeof(mgmt_resp->u.action.u.scs_action_resp) + sizeof(mgmt_resp->u.action.category), 0, NULL, 0, 0) < 0)
+	mgmt_resp->u.action.u.scs_action_resp.count = scs_count;
+	os_memcpy(mgmt_resp->u.action.u.scs_action_resp.scs_status, status_list, (scs_count * sizeof(struct mxl_scs_status_list)));
+
+	if (hostapd_drv_send_mlme(hapd, mgmt_resp, IEEE80211_HDRLEN + sizeof(mgmt_resp->u.action.u.scs_action_resp) +
+									  sizeof(mgmt_resp->u.action.category) +
+									  (scs_count * sizeof(struct mxl_scs_status_list)), 0, NULL, 0, 0) < 0)
 		wpa_printf(MSG_DEBUG, "ROBUST AV scs_action_send_resp: send failed");
 }
 
@@ -288,7 +290,7 @@ int mxl_scs_parse_tclas_elems(const u8 *pos, struct mxl_scs_add_req *scs_add_req
 	const u8 *end;
 	u8 class_type, version;
 	u8 mask = 0, tclas_len = 0;
-	bool has_type4 = false, has_type10 = false;
+	bool has_type10 = false;
 
 	tclas_len = len;
 	scs_add_req->tclasInfo.tclasLen = tclas_len;
@@ -300,82 +302,94 @@ int mxl_scs_parse_tclas_elems(const u8 *pos, struct mxl_scs_add_req *scs_add_req
 	while (pos < end) {
 		class_type = *pos++;
 		switch (class_type) { /* Classifier type 4 and 10 are allowed */
-			case SCS_CLASSIFIER_TYPE4:
+			case CLASSIFIER_TYPE4:
 				mask = *pos++;
 
 				/* Process classifiers frames */
-				if (mask & BIT(SCS_CLASS_TYPE4_VERSION))
-					scs_add_req->type4Params.version = *pos++; /* Version */
+				if (mask & BIT(CLASS_TYPE4_VERSION))
+					scs_add_req->type4Params.version = *pos; /* Version */
+				pos ++; /* Length of version */
 
 				if (scs_add_req->type4Params.version != IPV4 && scs_add_req->type4Params.version != IPV6)
 					return WLAN_STATUS_UNSPECIFIED_FAILURE;
 
 				version = scs_add_req->type4Params.version;
 
-				if (mask & BIT(SCS_CLASS_TYPE4_SRC_IP)) { /* source IP address */
+				if (mask & BIT(CLASS_TYPE4_SRC_IP)) { /* source IP address */
 					if (version == IPV4) {
 						memcpy(&(scs_add_req->type4Params.u.v4.srcIp), pos, sizeof(u32));
-						pos += sizeof(u32);
 					} else {
 						memcpy(scs_add_req->type4Params.u.v6.srcIp, pos, 16);
-						pos += 16;
 					}
 				}
 
-				if (mask & BIT(SCS_CLASS_TYPE4_DST_IP)) { /* Destination IP address */
+				if (version == IPV4) /* Length of src ip */
+					  pos += sizeof(u32);
+				else
+					  pos += 16;
+
+				if (mask & BIT(CLASS_TYPE4_DST_IP)) { /* Destination IP address */
 					if (version == IPV4) {
 						memcpy(&(scs_add_req->type4Params.u.v4.dstIp), pos, sizeof(u32));
-						pos += sizeof(u32);
 					} else {
 						memcpy(scs_add_req->type4Params.u.v6.dstIp, pos, 16);
-						pos += 16;
 					}
 				}
 
-				if (mask & BIT(SCS_CLASS_TYPE4_SRC_PORT)) { /* Source port */
+				if (version == IPV4) /* Length of dst ip */
+					  pos += sizeof(u32);
+				else
+					  pos += 16;
+
+				if (mask & BIT(CLASS_TYPE4_SRC_PORT)) { /* Source port */
 					if (version == IPV4) {
 						memcpy(&(scs_add_req->type4Params.u.v4.srcPort), pos, sizeof(u16));
-						pos += sizeof(u16);
+						scs_add_req->type4Params.u.v4.srcPort = ntohs(scs_add_req->type4Params.u.v4.srcPort);
 					} else {
 						memcpy(&(scs_add_req->type4Params.u.v6.srcPort), pos, sizeof(u16));
-						pos += sizeof(u16);
+						scs_add_req->type4Params.u.v6.srcPort = ntohs(scs_add_req->type4Params.u.v6.srcPort);
 					}
 				}
+				pos += sizeof(u16); /* Length of src port */
 
-				if (mask & BIT(SCS_CLASS_TYPE4_DST_PORT)) { /* Dst port */
+				if (mask & BIT(CLASS_TYPE4_DST_PORT)) { /* Dst port */
 					if (version == IPV4) {
 						memcpy(&(scs_add_req->type4Params.u.v4.dstPort), pos, sizeof(u16));
-						pos += sizeof(u16);
+						scs_add_req->type4Params.u.v4.dstPort = ntohs(scs_add_req->type4Params.u.v4.dstPort);
 					} else {
 						memcpy(&(scs_add_req->type4Params.u.v6.dstPort), pos, sizeof(u16));
-						pos += sizeof(u16);
+						scs_add_req->type4Params.u.v6.dstPort = ntohs(scs_add_req->type4Params.u.v6.dstPort);
 					}
 				}
+				pos += sizeof(u16); /* Length of dst port */
 
-				if (mask & BIT(SCS_CLASS_TYPE4_DSCP)) { /* DSCP */
+				if (mask & BIT(CLASS_TYPE4_DSCP)) { /* DSCP */
 					if (version == IPV4)
-						scs_add_req->type4Params.u.v4.dscp = *pos++;
+						scs_add_req->type4Params.u.v4.dscp = *pos;
 					else
-						scs_add_req->type4Params.u.v6.dscp = *pos++;
+						scs_add_req->type4Params.u.v6.dscp = *pos;
 				}
+				pos ++;
 
-				if (mask & BIT(SCS_CLASS_TYPE4_PROTO)) { /* Protocol or next header */
+				if (mask & BIT(CLASS_TYPE4_PROTO)) { /* Protocol or next header */
 					if (version == IPV4)
-						scs_add_req->type4Params.u.v4.proto = *pos++;
+						scs_add_req->type4Params.u.v4.proto = *pos;
 					else
-						scs_add_req->type4Params.u.v6.nextHeader = *pos++;
+						scs_add_req->type4Params.u.v6.nextHeader = *pos;
 				}
+				pos ++; /* Length of protocol */
+				if (version == IPV4) /* Length of reserve field in ipV4 */
+				  pos ++;
 
-				if (mask & BIT(SCS_CLASS_TYPE4_FLOW_LABEL)) { /* Flow label only for ipv6 */
+				if (mask & BIT(CLASS_TYPE4_FLOW_LABEL)) { /* Flow label only for ipv6 */
 						memcpy(scs_add_req->type4Params.u.v6.flowLabel, pos, 3);
-						pos += 3;
 				}
+				pos += 3; /* Length of flow label for ipv6 */
 
-				has_type4 = true;
-				scs_add_req->tclasInfo.tclasElemstype = 4;
-				elems_num ++;
+				scs_add_req->tclasInfo.tclasElemstype = CLASSIFIER_TYPE4;
+				(*elems_num)++;
 				break;
-			 case SCS_CLASSIFIER_TYPE10:
+			 case CLASSIFIER_TYPE10:
 				scs_add_req->type10Params.protoInstance = *pos++;
 				scs_add_req->type10Params.protoNum = *pos++;
 				scs_add_req->type10Params.filterLen = (tclas_len - 4) / 2;
@@ -384,7 +398,7 @@ int mxl_scs_parse_tclas_elems(const u8 *pos, struct mxl_scs_add_req *scs_add_req
 				memcpy(scs_add_req->type10Params.filterMask, pos, scs_add_req->type10Params.filterLen);
 				pos += scs_add_req->type10Params.filterLen;
 				has_type10 = true;
-				elems_num ++;
+				(*elems_num)++;
 				break;
 			 default:
 				return WLAN_STATUS_UNSPECIFIED_FAILURE;
@@ -395,35 +409,29 @@ int mxl_scs_parse_tclas_elems(const u8 *pos, struct mxl_scs_add_req *scs_add_req
 	 * appears before class 4. So, has_type10 and has_type6 variables are used *
 	 * and the tclas type 10 without tclas 4 is checked after the loop ends */
 	if (has_type10) {
-		if (!has_type4)
+		if (scs_add_req->tclasInfo.tclasElemstype != CLASSIFIER_TYPE4)
 			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+
 		/* TCLAS type 10 with a protocol different than 17 or 50 is illegal */
 		if (scs_add_req->type10Params.protoInstance != 0 ||
 		    (scs_add_req->type10Params.protoNum != 17 &&
 		    scs_add_req->type10Params.protoNum != 50))
 			return WLAN_STATUS_UNSPECIFIED_FAILURE;
-		if (version == IPV4) {
-			if (scs_add_req->type4Params.u.v4.srcPort != 0)
-				return WLAN_STATUS_UNSPECIFIED_FAILURE;
-		}
-		else if (version == IPV6) {
-			if (scs_add_req->type4Params.u.v6.srcPort != 0)
-				return WLAN_STATUS_UNSPECIFIED_FAILURE;
-		}
+
 		scs_add_req->tclasInfo.tclasElemstype = 10;
 	}
+
 	return WLAN_STATUS_SUCCESS;
 }
 
-int mxl_scs_add_req(struct hostapd_data *hapd, const struct ieee80211_mgmt *mgmt, size_t len)
+int mxl_scs_add_req(struct hostapd_data *hapd, const struct ieee80211_mgmt *mgmt, const u8 *pos, size_t len, u8 scsId)
 {
-	const u8 *pos, *end;
+	const u8 *end;
 	u8 eid, elen;
 	struct sta_info *sta;
 	struct mxl_scs_add_req scs_add_req;
-	pos = mgmt->u.action.u.scs_action_req.variable;
 	u8 tclas_elems_num = 0;
-	bool has_tclas_elems = false, has_tclas_process = false;
+	bool qos_characteristic_elems = false;
 
 	os_memset(&scs_add_req, 0, sizeof(struct mxl_scs_add_req));
 
@@ -438,19 +446,18 @@ int mxl_scs_add_req(struct hostapd_data *hapd, const struct ieee80211_mgmt *mgmt
 		return WLAN_STATUS_UNSPECIFIED_FAILURE;
 	}
 
-	/* WLANRTSYS-91362: Workaround, Extra 8 bytes are appened to the frame from the lower layers */
-	len = len - 8;
