From aa7d102815d47b0b20cbb7fd477f2ebc8f745e3e Mon Sep 17 00:00:00 2001
From: pvaish <pvaish@maxlinear.com>
Date: Tue, 21 Jul 2026 00:05:42 -0700
Subject: [PATCH] WLANRTSYS-103058 Correctly setting the dtim_period value
 received from the hostapd_cli SET command.

Signed-off-by: pvaish <pvaish@maxlinear.com>
---
 hostapd/ctrl_iface.c     |  9 +++++++++
 hostapd/mxl_ctrl_iface.c | 13 +++++++++++++
 hostapd/mxl_ctrl_iface.h |  1 +
 src/common/defs.h        |  1 +
 4 files changed, 24 insertions(+)

diff --git a/hostapd/ctrl_iface.c b/hostapd/ctrl_iface.c
index 79d14f2dc..bab30bed2 100644
--- a/hostapd/ctrl_iface.c
+++ b/hostapd/ctrl_iface.c
@@ -1407,6 +1407,15 @@ static int hostapd_ctrl_iface_set(struct hostapd_data *hapd, char *cmd)
 		if (hapd->started && !hapd->conf->start_disabled &&
 		    ieee802_11_set_beacon(hapd) < 0)
 		    return -1;
+	} else if (os_strcasecmp(cmd, "dtim_period") == 0) {
+		int val;
+
+		val = atoi(value);
+		if (val < 1 || val > 255) {
+			wpa_printf(MSG_DEBUG, "dtim_period value out of range (can be greater than 0 less than 256)");
+			return -1;
+		}
+		ret = mxl_hostapd_ctrl_iface_set_dtim_period(hapd, val);
 #endif /* CONFIG_VENDOR_MXL */
 	} else if (os_strcasecmp(cmd, "setband") == 0) {
 		ret = hostapd_ctrl_iface_set_band(hapd, value);
diff --git a/hostapd/mxl_ctrl_iface.c b/hostapd/mxl_ctrl_iface.c
index e4fafefc9..f258015c7 100644
--- a/hostapd/mxl_ctrl_iface.c
+++ b/hostapd/mxl_ctrl_iface.c
@@ -4410,6 +4410,19 @@ int mxl_hostapd_ctrl_iface_set_beacon(struct hostapd_data *hapd)
 	return -1;
 }
 
+int mxl_hostapd_ctrl_iface_set_dtim_period(struct hostapd_data *hapd, int value)
+{
+	if (hapd->iconf->multibss_enable) {
+		if (!mxl_hostapd_mbssid_is_tx_bss(hapd->conf->bss_idx) && value != MULTIBSS_NON_TX_DTIM_PERIOD) {
+			hapd->conf->dtim_period = MULTIBSS_NON_TX_DTIM_PERIOD;
+			wpa_printf(MSG_ERROR, "Invalid dtim_period value for the Non-Tx BSS (should be 1)");
+			return -1;
+		}
+	}
+	hapd->conf->dtim_period = value;
+	return 0;
+}
+
 #ifdef CONFIG_IEEE80211BE_MXL_MLO
 bool mxl_hostapd_ctrl_iface_is_channel_allowed(struct hostapd_iface *iface)
 {
diff --git a/hostapd/mxl_ctrl_iface.h b/hostapd/mxl_ctrl_iface.h
index 0d848a234..9cb06947d 100644
--- a/hostapd/mxl_ctrl_iface.h
+++ b/hostapd/mxl_ctrl_iface.h
@@ -50,4 +50,5 @@ int mxl_hostapd_ctrl_iface_receive_process_acs(struct hostapd_data *hapd,
 int mxl_hostapd_ctrl_iface_check_acs(struct hostapd_iface *iface, const struct csa_settings *settings, enum chan_width bandwidth, char* pos);
 int mxl_hostapd_ctrl_iface_acs_start(struct hostapd_iface *iface, enum chan_width bw);
 int mxl_hostapd_ctrl_iface_get_dynamic_failsafe(struct hostapd_data *hapd, char *cmd, char *buf, size_t buflen, int *reply_len);
+int mxl_hostapd_ctrl_iface_set_dtim_period(struct hostapd_data *hapd, int value);
 #endif /* MXL_CTRL_IFACE_H */
diff --git a/src/common/defs.h b/src/common/defs.h
index c8e229734..3bd245f3c 100644
--- a/src/common/defs.h
+++ b/src/common/defs.h
@@ -589,6 +589,7 @@ enum wpa_p2p_mode {
 #define MULTIBSS_REFERENCE_BSS_IDX	1
 #define SIX_GHZ_CAPABILITY_INVALID	0
 #define MIN_COLOCATED_RADIO_COUNT	2
+#define MULTIBSS_NON_TX_DTIM_PERIOD 1
 
 enum multibss_vap_mode {
 	NON_MULTIBSS_VAP_MODE = 0,
-- 
2.43.0

