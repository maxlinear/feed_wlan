From 7706c48304c52eaeeaf0acb890cbf27b92ac4866 Mon Sep 17 00:00:00 2001
From: Jurijs Soloveckis <jsoloveckis@maxlinear.com>
Date: Thu, 11 May 2023 09:49:19 +0200
Subject: [PATCH] WLANRTSYS-54115: FILS discovery and unsolicited broadcast
 Probe Response: Align to opensource

---
 src/ap/beacon.c     |  3 +++
 src/ap/ieee802_11.c | 27 ++++++++++++++++++++++++---
 2 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/src/ap/beacon.c b/src/ap/beacon.c
index db7053fb8..c09987d19 100644
--- a/src/ap/beacon.c
+++ b/src/ap/beacon.c
@@ -1952,6 +1952,9 @@ u8 * hostapd_unsol_bcast_probe_resp(struct hostapd_data *hapd,
 	ubpr->unsol_bcast_probe_resp_interval =
 		hapd->conf->unsol_bcast_probe_resp_interval;
 
+	if (!params->unsol_bcast_probe_resp_interval) {
+		return NULL;
+	}
 	os_memset(&probe_params, 0, sizeof(probe_params));
 	probe_params.req = NULL;
 	probe_params.is_p2p = false;
diff --git a/src/ap/ieee802_11.c b/src/ap/ieee802_11.c
index c38119ee0..b7f105c83 100644
--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -7918,7 +7918,11 @@ hostapd_eid_rnr_iface_len(struct hostapd_data *hapd,
 {
 	size_t total_len = 0, len = *current_len;
 	int tbtt_count, total_tbtt_count = 0;
+#ifndef CONFIG_VENDOR_MXL
 	size_t i, start;
+#else /* CONFIG_VENDOR_MXL */
+   size_t i, start = MULTIBSS_REFERENCE_BSS_IDX;
+#endif /* CONFIG_VENDOR_MXL */
 	u8 tbtt_info_len = mld_update ? RNR_TBTT_INFO_MLD_LEN :
 		RNR_TBTT_INFO_LEN;
 
@@ -8119,14 +8123,14 @@ size_t hostapd_eid_rnr_len(struct hostapd_data *hapd, u32 type,
 				hostapd_eid_rnr_colocation_len(hapd,
 							       &current_len);
 
-		if (hapd->conf->rnr && hapd->iface->num_bss > 1 &&
+		if (hapd->conf->rnr && hapd->iface->num_bss > MIN_COLOCATED_RADIO_COUNT &&
 		    !hapd->iconf->mbssid)
 			total_len += hostapd_eid_rnr_iface_len(hapd, hapd,
 							       &current_len,
 							       NULL, false);
 		break;
 	case WLAN_FC_STYPE_ACTION:
-		if (hapd->iface->num_bss > 1 && mode == STANDALONE_6GHZ)
+		if (hapd->iface->num_bss > MIN_COLOCATED_RADIO_COUNT && mode == STANDALONE_6GHZ)
 			total_len += hostapd_eid_rnr_iface_len(hapd, hapd,
 							       &current_len,
 							       NULL, false);
@@ -8316,8 +8320,13 @@ static u8 * hostapd_eid_rnr_iface(struct hostapd_data *hapd,
 				  bool mld_update)
 {
 	struct hostapd_iface *iface = hapd->iface;
+#ifndef CONFIG_VENDOR_MXL
 	size_t i, start;
 	size_t len = *current_len;
+#else /* CONFIG_VENDOR_MXL */
+	size_t i, start = MULTIBSS_REFERENCE_BSS_IDX;
+	size_t len = *current_len, rnr_len = 0;
+#endif /* CONFIG_VENDOR_MXL */
 	u8 *eid_start = eid, *size_offset = (eid - len) + 1;
 	u8 *tbtt_count_pos = size_offset + 1;
 	u8 tbtt_count, total_tbtt_count = 0, op_class, channel;
@@ -8327,6 +8336,12 @@ static u8 * hostapd_eid_rnr_iface(struct hostapd_data *hapd,
 	if (!(iface->drv_flags & WPA_DRIVER_FLAGS_AP_CSA) || !iface->freq)
 		return eid;
 
+#ifdef CONFIG_VENDOR_MXL
+	/* Skip writing to eid buffer even rnr header if length is zero */
+	if (!hostapd_eid_rnr_iface_len(hapd, reporting_hapd, &rnr_len, NULL))
+		return eid;
+#endif /* CONFIG_VENDOR_MXL */
+
 	if (ieee80211_freq_to_channel_ext(iface->freq,
 					  hapd->iconf->secondary_channel,
 					  hostapd_get_oper_chwidth(hapd->iconf),
@@ -8455,15 +8470,21 @@ u8 * hostapd_eid_rnr(struct hostapd_data *hapd, u8 *eid, u32 type,
 			eid = hostapd_eid_rnr_colocation(hapd, eid,
 							 &current_len);
 
-		if (hapd->conf->rnr && hapd->iface->num_bss > 1 &&
+		if (hapd->conf->rnr && hapd->iface->num_bss > MIN_COLOCATED_RADIO_COUNT &&
 		    !hapd->iconf->mbssid)
 			eid = hostapd_eid_rnr_iface(hapd, hapd, eid,
 						    &current_len, NULL, false);
 		break;
 	case WLAN_FC_STYPE_ACTION:
+#ifndef CONFIG_VENDOR_MXL
 		if (hapd->iface->num_bss > 1 && mode == STANDALONE_6GHZ)
 			eid = hostapd_eid_rnr_iface(hapd, hapd, eid,
 						    &current_len, NULL, false);
+#else /* CONFIG_VENDOR_MXL */
+		if (hapd->iface->num_bss > MIN_COLOCATED_RADIO_COUNT && mode == STANDALONE_6GHZ)
+			eid = hostapd_eid_rnr_iface(hapd, hapd,	eid,
+						    &current_len, NULL, false);
+#endif /* CONFIG_VENDOR_MXL */
 		break;
 	default:
 		return eid_start;
-- 
2.43.0

