From 21f7ff03a2caebd82bca0d399361e95120a0d352 Mon Sep 17 00:00:00 2001
From: Sathyananda Reddy <kmsreddy@maxlinear.com>
Date: Fri, 4 Sep 2026 05:36:07 -0700
Subject: [PATCH] WLANRTSYS-103253 Fix default network mode restoration after 5
 GHz standard downgrade.

Issue:
During hostapd reload, stale vht_oper_chwidth and acs_user_config_cw  values from the old
configuration were retained. As a result, ACS could incorrectly
select an 80 MHz bandwidth even when the 5 GHz radio operating
standard was changed to 802.11n.Causing bandwidth flapping and preventing restoration of
the default network mode (BE).

Fix:
When IEEE80211ac is disabled, reset vht_oper_chwidth and
acs_user_config_cw to CONF_OPER_CHWIDTH_USE_HT to ensure ACS
selects a bandwidth supported by the current operating standard.

Fixup : WLANRTSYS-50170 MXL Smart ACS implementation.
---
 hostapd/config_file.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/hostapd/config_file.c b/hostapd/config_file.c
index 2e14dc54b..ccced3d6c 100644
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -4536,6 +4536,14 @@ static int hostapd_config_fill(struct hostapd_config *conf,
 #ifdef CONFIG_IEEE80211AC
 	} else if (os_strcmp(buf, "ieee80211ac") == 0) {
 		conf->ieee80211ac = atoi(pos);
+#ifdef CONFIG_VENDOR_MXL
+	if (!conf->ieee80211ac) {
+		conf->vht_oper_chwidth = CONF_OPER_CHWIDTH_USE_HT;
+#ifdef CONFIG_ACS
+	conf->mxl_conf.acs_user_config_cw = CONF_OPER_CHWIDTH_USE_HT;
+#endif
+   	 }
+#endif
 	} else if (os_strcmp(buf, "vht_capab") == 0) {
 		if (hostapd_config_vht_capab(conf, pos) < 0) {
 			wpa_printf(MSG_ERROR, "Line %d: invalid vht_capab",
-- 
2.43.0

