--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -832,6 +832,18 @@ static int hostapd_parse_chanlist(struct hostapd_config *conf, char *val)
 	return 0;
 }
 
+static int hostapd_intlist_size(const char *val)
+{
+	int count = 0;
+	const char *pos = val;
+
+	while (*pos != '\0') {
+		if (*pos == ' ')
+			count++;
+		pos++;
+	}
+	return count + 1;
+}
 
 static int hostapd_parse_intlist(int **int_list, char *val)
 {
@@ -871,6 +883,32 @@ static int hostapd_parse_intlist(int **int_list, char *val)
 	return 0;
 }
 
+static int hostapd_fill_intlist(int *int_list, char *val, int exp_count)
+{
+	int count;
+	char *pos, *end;
+	pos = val;
+	count = 0;
+	while (*pos != '\0') {
+		if (*pos == ' ')
+			count++;
+		pos++;
+	}
+	if (exp_count != (count + 1))
+		return -1;
+	pos = val;
+	count = 0;
+	while (*pos != '\0') {
+		end = os_strchr(pos, ' ');
+		if (end)
+			*end = '\0';
+		int_list[count++] = atoi(pos);
+		if (!end)
+			break;
+		pos = end + 1;
+	}
+	return 0;
+}
 
