From 58d88fdbf1ff3cc00c13ca82491e10802fabf3c5 Mon Sep 17 00:00:00 2001
From: pvaish <pvaish@maxlinear.com>
Date: Tue, 20 Jan 2026 23:23:13 -0800
Subject: [PATCH] WLANRTSYS-99615 Removing the support for RELOAD_CONFIG
 hostapd_cli command from the `hostapd_cli -h` output.

Signed-off-by: pvaish <pvaish@maxlinear.com>
---
 hostapd/hostapd_cli.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/hostapd/hostapd_cli.c b/hostapd/hostapd_cli.c
index 2cbcfe47d..bf81c8ff8 100644
--- a/hostapd/hostapd_cli.c
+++ b/hostapd/hostapd_cli.c
@@ -2801,8 +2801,10 @@ static const struct hostapd_cli_cmd hostapd_cli_commands[] = {
 	  "= reload configuration for current interface" },
 	{ "reload_bss", hostapd_cli_cmd_reload_bss, NULL,
 	  "= reload configuration for current BSS" },
+#ifndef CONFIG_VENDOR_MXL
 	{ "reload_config", hostapd_cli_cmd_reload_config, NULL,
 	  "= reload configuration for current interface" },
+#endif /* CONFIG_VENDOR_MXL */
 	{ "disable", hostapd_cli_cmd_disable, NULL,
 	  "= disable hostapd on current interface" },
 	{ "enable_mld", hostapd_cli_cmd_enable_mld, NULL,
-- 
2.43.0

