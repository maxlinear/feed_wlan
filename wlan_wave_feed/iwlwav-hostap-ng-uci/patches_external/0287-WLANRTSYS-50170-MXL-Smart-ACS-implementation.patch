+
+void mxl_set_scan_timeout_default(struct i802_bss *bss, u32 scan_timeout)
+{
+	bss->scan_info.scan_timeout = scan_timeout;
+	return;
+}
+
+void mxl_set_scan_timeout(struct i802_bss *bss, struct mxl_scan_info scan_info)
+{
+	bss->scan_info.scan_timeout = scan_info.scan_timeout;
+	return;
+}
+
+void mxl_nl80211_set_param_scan_timeout(char **pos, const char *param, struct i802_bss *bss) {
+	const char scan_timeout_str[] = "scan_timeout=";
+	*pos = os_strstr(param, scan_timeout_str);
+	if (*pos) {
+		int val;
+
+		*pos += sizeof(scan_timeout_str) - 1;
+		val = atoi(*pos);
+		if ((val >= SCAN_TIMEOUT_MIN) && (val <= SCAN_TIMEOUT_MAX))
+			bss->scan_info.scan_timeout = val;
+		else
+			wpa_printf(MSG_ERROR, "scan_timeout %d out of range %d..%d, using default",
+			           val, SCAN_TIMEOUT_MIN, SCAN_TIMEOUT_MAX);
+	}
+	return;
+}
+
+void mxl_nl80211_handle_chan_data(struct wpa_driver_nl80211_data *drv, const u8 *data, size_t len)
+{
+	wpa_printf(MSG_DEBUG, "nl80211: Receive MXL vendor event: channel data, ctx=%p", drv->ctx);
+	mxl_drv_event_chan_data(drv->ctx, data, len);
+	return;
+}
+
+bool mxl_is_ap_interface(struct wpa_driver_nl80211_data *drv) {
+	return is_ap_interface(drv->nlmode);
+}
+
+void mxl_set_timeout(int *timeout, struct mxl_scan_info scan_info) {
+	*timeout = scan_info.scan_timeout;
+	return;
+}
