+		int bss_center_freq1 = 0;
+		int cf = 0;
+		int bss_width = 0;
+		int bss_base_freq;
+		int num_width = 20;
+		int bss_rssi_penalty;
+		const char *bss_printable_width = "20";
+		u8 he_6ghz_pri_chan = 0;
+		u8 he_6ghz_seg0_offset = 0;
+		u8 he_6ghz_seg1_offset = 0;
+		u8 len = 0, fopclass = 0;
