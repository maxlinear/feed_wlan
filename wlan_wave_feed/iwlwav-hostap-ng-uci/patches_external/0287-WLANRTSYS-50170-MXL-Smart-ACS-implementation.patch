+			case CONF_OPER_CHWIDTH_80MHZ:
+				cf_1 = cf_1 + 6;
+				break;
+			case CONF_OPER_CHWIDTH_160MHZ:
+				cf_1 = cf_1 + 14;
+				break;
+			case CONF_OPER_CHWIDTH_USE_HT:
+				/* no changes in cf_1 for 20 and 40 Mhz */
+				break;
+			default:
+				wpa_printf(MSG_ERROR, "Unsupported width : %d", chwidth);
+#ifdef CONFIG_ACS
+				acs_pop_chandef(iface, &cur_chan);
+#endif /* CONFIG_ACS */
+				return false;
+		}
+		hostapd_set_oper_centr_freq_seg0_idx(iface->conf, cf_1);
+		hostapd_set_oper_centr_freq_seg1_idx(iface->conf, cf_2);
+
+		wpa_printf(MSG_DEBUG, "Switch to second best channel freq: %d, width : %d, cf1 = %d", iface->freq, chwidth, cf_1);
+		/* check non DFS channel */
+		if (!mxl_is_dfs_channel(iface->freq, iface->conf->secondary_channel, iface->mxl_iface.sec_best_ch.width)) {
+			int i;
+			int ret;
+			struct csa_settings settings = {0};
+			struct hostapd_hw_modes *cmode = iface->current_mode;
+
+			wpa_printf(MSG_DEBUG, "Switch to non DFS channel");
+			iface->conf->channel = iface->mxl_iface.sec_best_ch.primary;
+			iface->freq = iface->mxl_iface.sec_best_ch.freq;
+			iface->conf->secondary_channel  = mxl_get_secondary_offset(iface->mxl_iface.sec_best_ch.primary, iface->mxl_iface.sec_best_ch.secondary);
+			hostapd_set_oper_chwidth(iface->conf, mxl_get_oper_width(iface->mxl_iface.sec_best_ch.width));
+			settings.cs_count = DEFAULT_CS_COUNT;
+			hostapd_set_freq_params(&settings.freq_params, iface->conf->hw_mode, iface->freq,
+				iface->conf->channel, iface->conf->enable_edmg,
+				iface->conf->edmg_channel, iface->conf->ieee80211n,
+				iface->conf->ieee80211ac, iface->conf->ieee80211ax, iface->conf->ieee80211be,
+				iface->conf->secondary_channel,
+				hostapd_get_oper_chwidth(iface->conf),
+				hostapd_get_oper_centr_freq_seg0_idx(iface->conf),
+				hostapd_get_oper_centr_freq_seg1_idx(iface->conf),
+				cmode ? cmode->vht_capab : 0,
+				cmode ? &cmode->he_capab[IEEE80211_MODE_AP] : NULL,
+				cmode ? &cmode->eht_capab[IEEE80211_MODE_AP] : NULL);
+
+			for (i = 0; i < iface->num_bss; i++) {
+				ret = hostapd_switch_channel(iface->bss[i], &settings);
+				if (ret) {
+					wpa_printf(MSG_ERROR, "Unable to switch non DFS channel !");
+#ifdef CONFIG_ACS
+					acs_pop_chandef(iface, &cur_chan);
+#endif /* CONFIG_ACS */
+					return false;
+				}
+			}
+
+		} else {
+			if (mxl_hostapd_zwdfs_switch(iface, HOSTAPD_CAC_STAT_SUCCESS, iface->freq, chwidth, cf_1, cf_2)) {
+				wpa_printf(MSG_DEBUG, "Failed to switch to second best DFS channel");
+#ifdef CONFIG_ACS
+				acs_pop_chandef(iface, &cur_chan);
+#endif /* CONFIG_ACS */
+				return false;
+			}
+			wpa_printf(MSG_DEBUG, "Switch to second best DFS channel");
+		}
+
+		/* get second best channel again after RADAR detected */
+		iface->mxl_iface.sec_best_ch.first_rank_idx = iface->mxl_iface.sec_best_ch.second_rank_idx;
+		iface->mxl_iface.sec_best_ch.flag = true;
+		iface->mxl_iface.sec_best_ch.bg_cac = false;
+		iface->mxl_iface.sec_best_ch.ch_switch_done = true;
+		if (!(mxl_acs_recalc_ranks_and_set_chan(iface, SWR_INITIAL))) {
+			wpa_printf(MSG_DEBUG, "get sec best channel again");
+			mxl_get_second_best_channel(iface);
+		} else {
+			wpa_printf(MSG_DEBUG, "Unable to get second best channel again ");
+		}
+		return true;
+
+	} else {
+		wpa_printf(MSG_ERROR, "No need to switch second best channel");
+	}
+	return false;
+}
