+int mxl_is_dfs_channel(int freq, int sec_offset, int bandwidth_mhz)
+{
+	freq += (sec_offset * 10);
+	int lower_freq = freq - bandwidth_mhz / 2;
+	int upper_freq = freq + bandwidth_mhz / 2;
+
+	/* DFS range in 5 GHz (example for many regulatory domains) */
+	if ((lower_freq < 5330 && upper_freq > 5250) ||
+		(lower_freq < 5710 && upper_freq > 5490)) {
+		return 1; /* DFS */
+	}
+	return 0; /* Non-DFS */
+}
+
+int mxl_get_secondary_offset(int primary, int secondary)
+{
+	if (secondary)
+		return ((secondary > primary) ? 1 : -1);
+	else
+		return 0;
+}
