+bool mxl_switch_second_best_channel(struct hostapd_iface *iface)
+{
+#ifdef CONFIG_ACS
+	if(!iface->conf->mxl_conf.acs_init_done)
+		return false;
+#endif /* CONFIG_ACS */
+	if (iface->mxl_iface.sec_best_ch.bg_cac && (iface->dfs_domain == HOSTAPD_DFS_REGION_FCC))
+	{
