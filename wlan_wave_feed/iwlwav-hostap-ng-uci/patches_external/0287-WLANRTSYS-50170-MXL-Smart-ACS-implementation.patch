+int mxl_do_bg_cac_with_second_best_channel(struct hostapd_iface *iface)
+{
+	int i, cur_freq;
+	u8 cf_1 = 0;
+	u8 cf_2 = 0;
+	u8 op_class;
+	struct csa_settings settings = {0};
+	struct hostapd_hw_modes *cmode = iface->current_mode;
+	enum oper_chan_width chwidth = mxl_get_oper_width(iface->mxl_iface.sec_best_ch.width);
+	int sec_channel = mxl_get_secondary_offset(iface->mxl_iface.sec_best_ch.primary, iface->mxl_iface.sec_best_ch.secondary);
+
+	ieee80211_freq_to_channel_ext(iface->mxl_iface.sec_best_ch.freq, 0, chwidth, &op_class, &cf1);
+	switch(chwidth) {
+		case CONF_OPER_CHWIDTH_80MHZ:
+			cf1 = cf1 + 6;
+			break;
+		case CONF_OPER_CHWIDTH_160MHZ:
+			cf1 = cf1 + 14;
+			break;
+		case CONF_OPER_CHWIDTH_USE_HT:
+			/* no changes in cf_1 for 20 and 40 Mhz */
+			break;
+		default:
+			wpa_printf(MSG_DEBUG, "Unsupported width : %d", chwidth);
+			return -1;
+	}
+
+	wpa_printf(MSG_DEBUG, "second best freq : %d", iface->mxl_iface.sec_best_ch.freq);
+
+	/* check non DFS channel */
+	if (!mxl_is_dfs_channel(iface->mxl_iface.sec_best_ch.freq, sec_channel, iface->mxl_iface.sec_best_ch.width)) {
+		wpa_printf(MSG_DEBUG, "non DFS channel for second best freq : %d", iface->mxl_iface.sec_best_ch.freq);
+		return -1;
+	}
+
+	settings.cs_count = DEFAULT_CS_COUNT;
+	hostapd_set_freq_params(&settings.freq_params, iface->conf->hw_mode, iface->mxl_iface.sec_best_ch.freq,
+			iface->mxl_iface.sec_best_ch.primary, iface->conf->enable_edmg,
+			iface->conf->edmg_channel, iface->conf->ieee80211n,
+			iface->conf->ieee80211ac, iface->conf->ieee80211ax, iface->conf->ieee80211be,
+			sec_channel,
+			chwidth,
+			cf1,
+			cf2,
+			cmode ? cmode->vht_capab : 0,
+			cmode ? &cmode->he_capab[IEEE80211_MODE_AP] : NULL,
+			cmode ? &cmode->eht_capab[IEEE80211_MODE_AP] : NULL);
+
+	int n_chans = settings.freq_params.bandwidth / 20;
+	struct hostapd_hw_modes *mode = iface->current_mode;
+	int low_freq  = settings.freq_params.center_freq1 - (settings.freq_params.bandwidth / 2) + 10;
+
+	for (i = 0; i < n_chans; i++) {
+		int chan_idx;
+		cur_freq = low_freq + i * 20;
+		chan_idx = mxl_hapd_get_chan_idx(mode, cur_freq);
+
+		/* Check whether the channel is a DFS channel */
+		if (mxl_dfs_check_chans_radar(iface, chan_idx, 1)) {
+			if (mxl_hostapd_set_chan_dfs_state(iface, NL80211_DFS_USABLE, cur_freq, 0, 1)) {
+				wpa_printf(MSG_ERROR, "DFS_DEBUG: Update kernel DFS state to 0x%x for channel %d failed",
+					NL80211_DFS_USABLE, cur_freq);
+				return -1;
+			}
+
+			if (mxl_set_dfs_state_freq(iface, cur_freq, HOSTAPD_CHAN_DFS_USABLE) != 1) {
+				wpa_printf(MSG_ERROR, "DFS_DEBUG: Update hostapd DFS state to 0x%x for channel %d failed",
+					HOSTAPD_CHAN_DFS_USABLE, cur_freq);
+				return -1;
+			}
+		}
+	}
+
+	/* Start ZWDFS CAC in background */
+	if (mxl_hostapd_start_background_cac(iface, &settings)) {
+		wpa_printf(MSG_ERROR, "%s: Failed to start Background CAC in ZWDFS antenna\n", __func__);
+		return -1;
+	}
+
+	wpa_printf(MSG_DEBUG, "Second DFS-CAC-START freq : %d", iface->mxl_iface.sec_best_ch.freq);
+	return 0;
+}
+
+void mxl_get_second_best_channel(struct hostapd_iface *iface)
+{
+	int res;
+
+	res = mxl_do_bg_cac_with_second_best_channel(iface);
+	if (res == 0) {
+		wpa_printf(MSG_DEBUG, "ZWDFS CAC triggered success with second best channel");
+	} else {
+		wpa_printf(MSG_ERROR, "ZWDFS CAC is not triggered with second best channel");
+	}
+	/* set this on both DFS and non DFS */
+	iface->mxl_iface.sec_best_ch.bg_cac = true;
+}
