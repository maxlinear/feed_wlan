From 1b1f08fd041ca23474497776f7dc0e910b3ed059 Mon Sep 17 00:00:00 2001
From: Nikita Chernikov <nchernikov@maxlinear.com>
Date: Thu, 28 May 2026 13:38:56 +0300
Subject: [PATCH] WLANRTSYS-102067 MLO: Add NSTR support

Signed-off-by: Nikita Chernikov <nchernikov@maxlinear.com>
---
 src/ap/mxl_mld.c              | 44 +++++++++++++++++++++++++++++++++--
 src/ap/mxl_sta_info.h         |  1 +
 src/common/vendor_cmds_copy.h |  1 +
 3 files changed, 44 insertions(+), 2 deletions(-)

diff --git a/src/ap/mxl_mld.c b/src/ap/mxl_mld.c
index 726a38da3..f0814b6c8 100644
--- a/src/ap/mxl_mld.c
+++ b/src/ap/mxl_mld.c
@@ -1895,6 +1895,7 @@ static u16 mxl_mld_process_per_sta_profile(struct hostapd_data *hapd, struct sta
 	while (ies_end - pos > 2) {
 		size_t sub_elem_len, sta_info_len;
 		size_t nstr_bitmap_len = 0;
+		const u8 *nstr_bitmap_pos = NULL;
 		u16 control;
 		u16 capab = 0;
 		u8 link_id;
@@ -1967,6 +1968,9 @@ static u16 mxl_mld_process_per_sta_profile(struct hostapd_data *hapd, struct sta
 		}
 
 		if (control & STA_CTRL_NSTR_LINK_PAIR_PRESENT_MASK) {
+			wpa_printf(MSG_DEBUG,
+				   "MXL_MLO: NSTR Link Pair Info present in Per-STA Profile link id %d",
+				   link_id);
 			if (control & STA_CTRL_NSTR_BITMAP_SIZE_MASK) {
 				nstr_bitmap_len = 2;
 			} else {
@@ -2011,8 +2015,10 @@ static u16 mxl_mld_process_per_sta_profile(struct hostapd_data *hapd, struct sta
 			return WLAN_STATUS_ASSOC_REJECTED_TEMPORARILY;
 		}
 
-		/* We dont support NSTR - so if present just skip it */
-		/* Skip to end of STA Info - Includes skipping MAC */
+		/* Save position of NSTR bitmap - located after MAC address in STA Info */
+		if (nstr_bitmap_len)
+			nstr_bitmap_pos = pos + ETH_ALEN;
+		/* Skip to end of STA Info - Includes skipping MAC and NSTR bitmap */
 		pos = end;
 
 		if (sub_elem_end - pos >= 2)
@@ -2039,6 +2045,9 @@ static u16 mxl_mld_process_per_sta_profile(struct hostapd_data *hapd, struct sta
 		lsta->mxl_sta_info.ext_flags &= ~WLAN_STA_SINGLE_LINK_ML_ASSOC;
 		lsta->mxl_sta_info.link_id = link_id;
 		lsta->mxl_sta_info.link_capab = capab;
+		if (nstr_bitmap_pos && nstr_bitmap_len) {
+			os_memcpy(lsta->mxl_sta_info.nstr_bitmap, nstr_bitmap_pos, nstr_bitmap_len);
+		}
 		lsta->auth_alg = sta->auth_alg;
 		lsta->flags |= WLAN_STA_AUTH;
 
@@ -2622,6 +2631,7 @@ int mxl_ml_add_sta_mld(struct hostapd_data *hapd, struct sta_info *sta)
 	struct mxl_ml_sta_add_param *ml_sta_params;
 	u8 link_id;
 	u8 *ml_sta_addr;
+	u8 nstr_link_pair = 0;
 	u8 main_link_id = 0;
 	bool emlsr_cap_sta = false;
 
@@ -2675,6 +2685,36 @@ int mxl_ml_add_sta_mld(struct hostapd_data *hapd, struct sta_info *sta)
 	if (ml_sta_params->num_of_sim_links && emlsr_cap_sta)
 		wpa_printf(MSG_DEBUG, "MXL_MLO: ML STA supports both STR and EMLSR");
 
+
+	mxl_mld_for_each_sibling_sta(lsta, sta) {
+		u16 nstr_bmp = 0;
+		u8 j;
+
+		nstr_bmp = WPA_GET_LE16(lsta->mxl_sta_info.nstr_bitmap);
+		if (!nstr_bmp)
+			continue;
+
+		/* Mark this STA's own link */
+		nstr_link_pair |= BIT(lsta->mxl_sta_info.link_id);
+
+		/* Mark link IDs indicated in the bitmap */
+		for (j = 0; j < MAX_NUM_MLD_LINKS; j++) {
+			if (!(nstr_bmp & BIT(j)))
+				continue;
+			if (!mxl_is_valid_link_id(j))
+				continue;
+			nstr_link_pair |= BIT(j);
+		}
+		break;
+	}
+
+	if (nstr_link_pair == (BIT(LINK_ID_5G) | BIT(LINK_ID_6G))) {
+		ml_sta_params->nstr_pair_present = 1;
+		wpa_printf(MSG_DEBUG,
+			   "MXL_MLO: NSTR pair present (5G <-> 6G), nstr_link_pair=0x%02x",
+			   nstr_link_pair);
+	}
+
 	/* Set MLD ID and MLD MAC */
 	memcpy_s(ml_sta_params->mld_mac_addr, ETH_ALEN, sta->mxl_sta_info.non_ap_mld_mac, ETH_ALEN);
 	ml_sta_params->mld_id = hapd->conf->mld_id;
diff --git a/src/ap/mxl_sta_info.h b/src/ap/mxl_sta_info.h
index 98439eef3..29ab98e63 100644
--- a/src/ap/mxl_sta_info.h
+++ b/src/ap/mxl_sta_info.h
@@ -45,6 +45,7 @@ struct mxl_sta_info {
 	struct ieee80211_ml_capab sta_ml_capab;
 	u16 sta_profile_status;
 	struct ieee80211_ml_sta_info ml_sta_info;
+	u8 nstr_bitmap[2]; /* NSTR bitmap received in Per-STA Profile */
 	u16 link_capab;
 	u8 link_added; /* Used and valid only during ML STA ADD*/
 #ifdef CONFIG_EPCS_MXL
diff --git a/src/common/vendor_cmds_copy.h b/src/common/vendor_cmds_copy.h
index dcbcd9a92..5582c342b 100644
--- a/src/common/vendor_cmds_copy.h
+++ b/src/common/vendor_cmds_copy.h
@@ -710,6 +710,7 @@ struct mxl_ml_sta_add_param {
   u8 assoc_link_bitmap;
   u16 eml_capab;
   u8 num_of_sim_links;
+  u8 nstr_pair_present;
   u8 mld_id;
   u16 aid;
 } __attribute__ ((packed));
-- 
2.43.0

