+{
+	if (sta && mxl_is_mlo_enabled(hapd->conf) && mxl_mlo_is_ml_sta(sta)) {
+		if (sta->mxl_sta_info.ext_flags & WLAN_STA_SINGLE_LINK_ML_ASSOC) {
+			p = mxl_hostapd_eid_multilink(hapd, sta, p, ML_BASIC, link_sta_status, false, false);
