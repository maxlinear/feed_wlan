+		int val = atoi(pos);
+		if (!IS_VALID_RANGE(val, 0, MLO_MEDIUM_SYNC_MAXTXOP_MAX)) {
+			wpa_printf(MSG_ERROR, "Invalid mld_mediumsync_maxtxop, "
