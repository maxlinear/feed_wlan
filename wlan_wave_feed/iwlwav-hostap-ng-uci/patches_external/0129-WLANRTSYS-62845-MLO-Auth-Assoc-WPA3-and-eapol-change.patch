+int mxl_ml_sta_add(struct hostapd_data *hapd, struct sta_info *sta)
+{
+	int res = 0;
+	struct mxl_ml_sta_add_param *ml_sta_params;
+	bool switch_initial_active_link = false;
+	u8 link_id = hapd->conf->mxl_bss_conf.link_id;
