+	if (sta1)
+		memcpy_s(sta->wpa_sm->mxl_sm.sibling_sta_mac, ETH_ALEN, sta1->addr, ETH_ALEN);
+
+	if (sta->mxl_sta_info.ext_flags & (WLAN_STA_SINGLE_LINK_ML_ASSOC))
+		sta->wpa_sm->mxl_sm.is_single_link_ml_sta = true;
+}
