+bool mxl_switch_second_best_channel(struct hostapd_iface *iface)
+{
+#ifdef CONFIG_VENDOR_MXL_PROPRIETARY
+#ifdef CONFIG_ACS
+	if(!iface->conf->acs) {
+		wpa_printf(MSG_DEBUG, "%s ZWDFS: acs is disabled after zwdfs CAC on second best channel",  __func__);
+		return false;
+	}
+#endif /* CONFIG_ACS */
+	if (iface->mxl_iface.sec_best_ch.bg_cac && (iface->dfs_domain == HOSTAPD_DFS_REGION_FCC))
