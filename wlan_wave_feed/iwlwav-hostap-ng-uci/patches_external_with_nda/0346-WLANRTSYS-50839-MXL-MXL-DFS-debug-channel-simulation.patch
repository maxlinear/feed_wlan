+		iface->freq = iface->mxl_iface.sec_best_ch.freq;
+		iface->conf->secondary_channel  = mxl_get_secondary_offset(iface->mxl_iface.sec_best_ch.primary, iface->mxl_iface.sec_best_ch.secondary);
+		hostapd_set_oper_chwidth(iface->conf, mxl_get_oper_width(iface->mxl_iface.sec_best_ch.width));
+		chwidth = hostapd_get_oper_chwidth(iface->conf);
+		ieee80211_freq_to_channel_ext(iface->mxl_iface.sec_best_ch.freq, 0, chwidth, &op_class, &cf_1);
+		cf_2 = (iface->mxl_iface.sec_best_ch.width <= 80) ? 0 : iface->mxl_iface.sec_best_ch.secondary;
+
+		switch(chwidth) {
+			case CONF_OPER_CHWIDTH_80MHZ:
+				cf_1 = cf_1 + 6;
+				break;
+			case CONF_OPER_CHWIDTH_160MHZ:
+				cf_1 = cf_1 + 14;
+				break;
+			case CONF_OPER_CHWIDTH_USE_HT:
+				/* no changes in cf_1 for 20 and 40 Mhz */
+				break;
+			default:
+				wpa_printf(MSG_ERROR, "Unsupported width : %d", chwidth);
+#ifdef CONFIG_ACS
+				acs_pop_chandef(iface, &cur_chan);
+#endif /* CONFIG_ACS */
+				return false;
+		}
+		hostapd_set_oper_centr_freq_seg0_idx(iface->conf, cf_1);
+		hostapd_set_oper_centr_freq_seg1_idx(iface->conf, cf_2);
+
+		wpa_printf(MSG_DEBUG, "Switch to second best channel freq: %d, width : %d, cf1 = %d", iface->freq, chwidth, cf_1);
+		/* check non DFS channel */
+		if (!mxl_is_dfs_channel(iface->freq, iface->conf->secondary_channel, iface->mxl_iface.sec_best_ch.width)) {
